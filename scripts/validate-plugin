#!/usr/bin/env bash
# Validate the installable Omacast payload without the ignored local work/ tree.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
stage_dir="$(mktemp -d /tmp/omacast-plugin.XXXXXX)"

cleanup() {
  rm -rf -- "$stage_dir"
}
trap cleanup EXIT HUP INT TERM

mkdir -p "$stage_dir/ui" "$stage_dir/bin"
cp "$repo_root/manifest.json" "$stage_dir/manifest.json"
cp "$repo_root/ui/Panel.qml" "$stage_dir/ui/Panel.qml"
cp "$repo_root/bin/omacast" "$stage_dir/bin/omacast"
cp -R "$repo_root/src" "$stage_dir/src"
omarchy plugin validate "$stage_dir"
