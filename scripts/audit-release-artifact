#!/usr/bin/env bash
# Inspect a built companion package without installing it or requiring root.
# shellcheck disable=SC2016 # Literal helper-source patterns must not expand here.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
package=""

die() {
  echo "audit-release-artifact: $*" >&2
  exit 1
}

[[ "${1:-}" == "--trusted-local-artifact" ]] \
  || die "refusing to execute package content; usage: $0 --trusted-local-artifact [PACKAGE.pkg.tar.zst]"
shift
[[ $# -le 1 ]] || die "usage: $0 --trusted-local-artifact [PACKAGE.pkg.tar.zst]"
package="${1:-}"

for command in bsdtar pacman python3 realpath sha256sum; do
  command -v "$command" >/dev/null || die "$command is required"
done

if [[ -z "$package" ]]; then
  mapfile -t candidates < <(find "$repo_root/dist" -maxdepth 1 -type f -name 'fluxcast-omarchy-cast-*.pkg.tar.zst' -print)
  if [[ ${#candidates[@]} -eq 1 ]]; then
    package="${candidates[0]}"
  elif [[ -f "$repo_root/dist/SHA256SUMS" ]]; then
    checksum_name="$(awk 'NF == 2 { print $2; exit }' "$repo_root/dist/SHA256SUMS")"
    checksum_name="${checksum_name#\*}"
    [[ -n "$checksum_name" && "$checksum_name" == "$(basename "$checksum_name")" ]] || die "SHA256SUMS names an unsafe package"
    package="$repo_root/dist/$checksum_name"
  else
    die "multiple companion packages found; pass one explicitly"
  fi
fi
[[ -f "$package" && ! -L "$package" ]] || die "package must be a regular, non-symlink file"
package="$(realpath "$package")"
package_name="$(basename "$package")"
expected_version="${package_name#fluxcast-omarchy-cast-}"
expected_version="${expected_version%-any.pkg.tar.zst}"
[[ -n "$expected_version" && "$expected_version" != "$package_name" ]] || die "unexpected package filename"

audit_root="$(mktemp -d "${TMPDIR:-/tmp}/omacast-artifact-audit.XXXXXX")"
cleanup() {
  case "$audit_root" in
    "${TMPDIR:-/tmp}"/omacast-artifact-audit.*)
      [[ -d "$audit_root" && ! -L "$audit_root" && "$(stat -c %u "$audit_root")" == "$UID" ]] && rm -rf -- "$audit_root"
      ;;
  esac
}
trap cleanup EXIT HUP INT TERM

checksum_file="$(dirname "$package")/SHA256SUMS"
if [[ -f "$checksum_file" ]]; then
  grep -Fq "  $package_name" "$checksum_file" || die "SHA256SUMS does not name $package_name"
  (cd "$(dirname "$package")" && sha256sum -c SHA256SUMS --ignore-missing)
fi

mapfile -t members < <(bsdtar -tf "$package")
[[ ${#members[@]} -gt 0 ]] || die "package archive is empty"
for member in "${members[@]}"; do
  [[ "$member" != /* && "$member" != ".." && "$member" != ../* && "$member" != */../* ]] \
    || die "unsafe archive member: $member"
done
[[ " ${members[*]} " != *" .INSTALL "* ]] || die "unexpected install script"

package_info="$(bsdtar -xOf "$package" .PKGINFO)"
grep -Fxq 'pkgname = fluxcast-omarchy-cast' <<<"$package_info" || die "unexpected package name"
grep -Fxq "pkgver = $expected_version" <<<"$package_info" || die "package metadata does not match its filename"
for dependency in 'python>=3.14' 'python<3.15' gpu-screen-recorder ffmpeg networkmanager dnsmasq wpa_supplicant iw libpulse polkit systemd iproute2 util-linux glib2 python-dbus; do
  grep -Fxq "depend = $dependency" <<<"$package_info" || die "missing runtime dependency: $dependency"
done
for dependency in python-pillow python-pystray python-pychromecast python-upnpclient; do
  ! grep -Eq "^(depend|optdepend) = ${dependency}([: ]|$)" <<<"$package_info" || die "package retains an unused protocol dependency: $dependency"
done
! grep -Eq '^optdepend = wf-recorder([: ]|$)' <<<"$package_info" \
  || die "package retains the obsolete wf-recorder hint"

bsdtar -xpf "$package" -C "$audit_root"
engine="$audit_root/usr/bin/fluxcast"
guard="$audit_root/usr/lib/omarchy-cast/omarchy-cast-guard"
launcher="$audit_root/usr/lib/omarchy-cast/omarchy-cast-guard-launch"
recovery="$audit_root/usr/lib/omarchy-cast/omarchy-cast-guard-recover"
broker="$audit_root/usr/lib/omarchy-cast/omarchy-cast-supplicant-broker"
policy="$audit_root/usr/share/polkit-1/actions/com.omacast.guard.policy"
for executable in "$engine" "$guard" "$launcher" "$recovery" "$broker"; do
  [[ -f "$executable" && ! -L "$executable" && -x "$executable" ]] || die "missing immutable executable: ${executable#"$audit_root"}"
  [[ "$(stat -c %a "$executable")" == 755 ]] || die "unsafe executable mode: ${executable#"$audit_root"}"
done
[[ -f "$policy" && ! -L "$policy" && "$(stat -c %a "$policy")" == 644 ]] || die "missing or unsafe Polkit action"
python3 - "$policy" <<'PY' || die "Polkit action contract is incompatible"
import sys
import xml.etree.ElementTree as ET

actions = {action.attrib["id"]: action for action in ET.parse(sys.argv[1]).getroot().findall("action")}
assert set(actions) == {"com.omacast.guard.prepare", "com.omacast.guard.reclaim"}
for name, active in (("prepare", "yes"), ("reclaim", "auth_admin")):
    action = actions[f"com.omacast.guard.{name}"]
    defaults = action.find("defaults")
    assert defaults is not None
    assert {node.tag: node.text for node in defaults} == {
        "allow_any": "no", "allow_inactive": "no", "allow_active": active,
    }
    assert {node.attrib["key"]: node.text for node in action.findall("annotate")} == {
        "org.freedesktop.policykit.exec.path": f"/usr/lib/omarchy-cast/omarchy-cast-guard{'-launch' if name == 'prepare' else ''}",
        "org.freedesktop.policykit.exec.argv1": name,
    }
PY
bash -n "$guard"
bash -n "$launcher"
bash -n "$recovery"
python3 -m py_compile "$broker"
python3 - "$broker" <<'PY' || die "broker advertises an invalid WFD source payload"
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
import sys

loader = SourceFileLoader("omacast_release_broker", sys.argv[1])
spec = spec_from_loader(loader.name, loader)
assert spec is not None
module = module_from_spec(spec)
loader.exec_module(module)
assert module.source_wfd_ies() == bytes.fromhex("00000600101c4400c8")
PY

guard_version="$($guard --version)"
python3 - "$guard_version" <<'PY' || die "guard API contract does not match revision 17"
import json
import sys

value = json.loads(sys.argv[1])
assert type(value) is dict
assert set(value) == {"schemaVersion", "kind", "apiRevision"}
assert type(value["schemaVersion"]) is int and value["schemaVersion"] == 1
assert type(value["kind"]) is str and value["kind"] == "omarchy-cast-guard-version"
assert type(value["apiRevision"]) is int and value["apiRevision"] == 17
PY
! grep -Fq '/etc/dbus-1/system.d' "$guard" || die "guard still writes a temporary system-bus policy"
grep -Fq 'omarchy-cast-supplicant-broker' "$guard" || die "guard does not start the session-scoped supplicant broker"
grep -Fq 'systemd-run --system --quiet --collect --no-block' "$launcher" || die "launcher does not detach the guard into the system manager"
grep -Fq 'omarchy-cast-guard-$session.service' "$launcher" || die "launcher does not bind the guard unit to the validated session"
! grep -Eq -- '--(pipe|wait)([ =]|$)' "$launcher" || die "launcher retains a long-lived system-service attachment"
grep -Fq 'omarchy-cast-recovery-$session_id.service' "$guard" || die "guard does not isolate independent recovery in the system manager"
! grep -Fq 'RuntimeMaxSec' "$guard" || die "guard imposes a fixed wall-clock lifetime on a healthy broker"
grep -Fq 'set(payload) not in (' "$broker" || die "broker request shape is not closed"
grep -Fq '{"schemaVersion", "op", "pin"}' "$broker" || die "broker request lacks its closed PIN shape"
grep -Fq 'operation == "connect"' "$broker" || die "broker lacks its fixed connect operation"
grep -Fq 'operation == "cleanup"' "$broker" || die "broker lacks its fixed cleanup operation"
grep -Fq '"persistent": "<true>"' "$broker" || die "broker does not request receiver pairing persistence"
! grep -Fq '"persistent": "<false>"' "$broker" || die "broker still requests disposable receiver pairing"
! grep -Fq 'RemoveAllPersistentGroups' "$broker" || die "broker cleanup can erase unrelated persistent groups"
grep -Fq 'AddAndActivateConnection2' "$broker" || die "broker lacks the explicit NetworkManager compatibility activation"
grep -Fq "{'persist': <'volatile'>}" "$broker" || die "NetworkManager compatibility connection is not volatile"
grep -Fq 'networkmanager-active' "$broker" || die "broker lacks protected NetworkManager ownership state"
grep -Fq 'os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC' "$broker" || die "broker does not safely open NetworkManager ownership state"
for helper in "$guard" "$recovery"; do
  grep -Fq -- '--recover-networkmanager' "$helper" || die "helper lacks bounded NetworkManager recovery"
  ! grep -Fq 'nmcli connection delete' "$helper" || die "helper can delete an unverified NetworkManager connection"
done
for removed_surface in qos.pid qos_file apply_media_qos renice; do
  ! grep -Fq "$removed_surface" "$guard" || die "guard retains removed privileged QoS surface: $removed_surface"
  ! grep -Fq "$removed_surface" "$recovery" || die "recovery retains removed privileged QoS surface: $removed_surface"
done
grep -Fq 'user_root="$session_root/user"' "$guard" || die "guard marker directory is not anchored below the root-owned session"
grep -Fq 'install -d -m711 "$session_root"' "$guard" || die "guard does not create the protected session parent"
! grep -Fq '"$action" == stop' "$guard" || die "guard retains the unused privileged Stop verb"
grep -Fq '"$action" == reclaim' "$guard" || die "guard lacks explicit inactive-P2P recovery"
grep -Fq 'flock -n "$guard_lock_fd"' "$guard" || die "prepare and reclaim do not share a root-owned operation lock"
grep -Fq 'interfaces_file="$session_root/p2p-interfaces"' "$guard" || die "guard lacks root-owned recorded P2P cleanup"
grep -Fq 'interfaces_file="$root/p2p-interfaces"' "$recovery" || die "recovery lacks root-owned recorded P2P cleanup"
grep -Fq 'interfaces_armed_file="$session_root/p2p-armed"' "$guard" || die "guard lacks the clean-baseline ownership marker"
grep -Fq 'interfaces_armed_file="$root/p2p-armed"' "$recovery" || die "recovery lacks the clean-baseline ownership marker"
grep -Fq 'network_manager_resume_file="$session_root/network-manager-resume-required"' "$guard" || die "guard lacks NetworkManager pause ownership"
grep -Fq 'network_manager_resume_file="$root/network-manager-resume-required"' "$recovery" || die "recovery lacks NetworkManager pause ownership"
for helper in "$guard" "$recovery"; do
  ! grep -Fq 'nm_pid' "$helper" || die "helper retains a recyclable NetworkManager PID"
  grep -Fq 'systemctl kill --kill-whom=main --signal=SIGCONT NetworkManager.service' "$helper" || die "helper does not resume NetworkManager through its systemd unit"
done
grep -Fq 'systemctl kill --kill-whom=main --signal=SIGSTOP NetworkManager.service' "$guard" || die "guard does not pause NetworkManager through its systemd unit"
for helper in "$guard" "$recovery"; do
  grep -Fq 'stat -Lc '\''%F:%u:%a:%s'\'' "/proc/self/fd/$heartbeat_fd"' "$helper" || die "helper does not validate the pinned heartbeat descriptor"
  grep -Fq 'read -r -n 32 -t 0.1 renewed < "/proc/self/fd/$heartbeat_fd"' "$helper" || die "helper does not bound pinned heartbeat reads"
  ! grep -Fq 'renewed="$(<"$heartbeat_file")"' "$helper" || die "helper reopens the user heartbeat by pathname"
done
! grep -Fq '/run/user/' "$recovery" || die "root recovery traverses the user runtime tree"
! grep -Fq 'telemetry' "$recovery" || die "root recovery manages user-owned telemetry"
for live_name in current.json ffmpeg.progress mux-packets.csv engine.jsonl engine.log; do
  ! grep -Fq "$live_name" "$recovery" || die "root recovery removes user-owned telemetry: $live_name"
done

site_packages="$(find "$audit_root/usr/lib" -type d -path '*/site-packages' -print -quit)"
[[ -n "$site_packages" ]] || die "packaged Python modules are missing"
for removed_payload in \
  "$audit_root/usr/bin/fluxcast-install-system" \
  "$site_packages/pypi_sysinstall.py" \
  "$site_packages/_fluxcast_data" \
  "$site_packages/assets"; do
  [[ ! -e "$removed_payload" ]] || die "package retains legacy integration payload: ${removed_payload#"$audit_root"}"
done
PYTHONPATH="$site_packages" "$engine" --help > "$audit_root/fluxcast-help.txt"
engine_contract="$(PYTHONPATH="$site_packages" "$engine" --omacast-contract-json)"
python3 -c '
import json, sys
actual = json.loads(sys.argv[1])
expected = {
    "schemaVersion": 1,
    "kind": "omacast-engine-contract",
    "apiRevision": 3,
    "capture": "gpu-screen-recorder",
    "profile": {"width": 1280, "height": 720, "fps": 60, "bitrateMbps": 7},
    "network": {"backend": "supplicant", "mode": "connect", "guardedSessionRequired": True},
    "telemetry": {"controllerDescriptorsRequired": True},
    "discovery": {"progressiveSnapshots": True},
    "pairing": {"receiverPinDescriptor": True},
}
assert json.dumps(actual, sort_keys=True, separators=(",", ":")) == json.dumps(
    expected, sort_keys=True, separators=(",", ":")
)
' "$engine_contract" || die "packaged engine contract is incompatible"
PYTHONPATH="$site_packages" "$engine" --doctor > "$audit_root/fluxcast-doctor.txt"
PYTHONPATH="$site_packages" "$engine" --doctor-json > "$audit_root/fluxcast-doctor.json"
python3 - "$audit_root/fluxcast-doctor.json" <<'PY' \
  || die "packaged engine returned an invalid diagnostic report"
import json
import sys

with open(sys.argv[1], encoding="utf-8") as report_file:
    report = json.load(report_file)
if not (
    isinstance(report, dict)
    and isinstance(report.get("checks"), list)
    and isinstance(report.get("wfd_candidate"), bool)
    and isinstance(report.get("summary"), str)
):
    raise SystemExit("unexpected diagnostic report shape")
PY
for flag in --wfd-p2p-backend --wfd-supplicant-mode --wfd-video-encoder --wfd-supplicant-network-trigger --wfd-supplicant-broker --wfd-progress-log; do
  grep -Fq -- "$flag" "$audit_root/fluxcast-help.txt" || die "packaged engine is missing $flag"
done
grep -Fq -- 'gpu-screen-recorder' "$audit_root/fluxcast-help.txt" \
  || die "packaged engine lacks the GPU Screen Recorder backend contract"
for removed_backend in portal wf-recorder x11grab gst-x11; do
  ! grep -Fq -- "$removed_backend" "$audit_root/fluxcast-help.txt" \
    || die "packaged engine retains removed WFD capture backend: $removed_backend"
done
grep -Fq -- '--wfd-capture-backend {gpu-screen-recorder}' "$audit_root/fluxcast-help.txt" \
  || die "packaged engine does not expose the exact supported capture selector"
grep -Fq -- '--protocol {wfd}' "$audit_root/fluxcast-help.txt" || die "packaged engine does not expose the WFD-only protocol contract"
for surface in '--tray' '{dlna,cast,wfd}' 'DLNA / Cast Options' '--wfd-uibc'; do
  ! grep -Fq -- "$surface" "$audit_root/fluxcast-help.txt" || die "packaged engine exposes a non-WFD protocol: $surface"
done
for module in cast dlna ui server.py drivers/uibc.py wfd/ts_probe.py; do
  [[ ! -e "$site_packages/$module" ]] || die "packaged engine retains excluded module: $module"
done
! grep -R -Fq -- 'wfd_uibc' "$site_packages" || die "packaged engine retains UIBC input surface"
! grep -R -Fq --include='*.py' -- 'capture_output=True' "$site_packages" \
  || die "packaged engine retains unbounded subprocess capture"
grep -Fq 'MAX_COMMAND_OUTPUT_BYTES' "$site_packages/wfd/proc.py" \
  || die "packaged engine lacks bounded subprocess capture"
grep -Fq 'start_new_session=True' "$site_packages/wfd/proc.py" \
  || die "packaged engine commands do not own an isolated process group"
grep -Fq 'os.killpg(process.pid, signal.SIGKILL)' "$site_packages/wfd/proc.py" \
  || die "packaged engine does not terminate bounded command process groups"
grep -Fq '_wfd_device_info_detail(wfd_ies)' "$site_packages/wfd/p2p/scan_nm.py" \
  || die "packaged engine drops WFD receiver role evidence"
grep -Fq 'strength_percent=strength' "$site_packages/wfd/p2p/scan_nm.py" \
  || die "packaged engine drops bounded WFD peer metadata"
[[ -f "$site_packages/json_bounds.py" && ! -L "$site_packages/json_bounds.py" ]] \
  || die "packaged engine lacks the shared JSON shape budget"
grep -Fq 'def json_shape_is_bounded(' "$site_packages/json_bounds.py" \
  || die "packaged engine lacks the shared JSON shape budget"
grep -Fq 'json_shape_is_bounded(payload' "$site_packages/wfd/p2p/broker.py" \
  || die "packaged engine broker client lacks a JSON shape budget"
grep -Fq 'port > 65535' "$site_packages/wfd/rtsp/message.py" \
  || die "packaged engine lacks receiver port range validation"
grep -Fq 'MAX_LATENCY_LOG_BYTES' "$site_packages/wfd/latency.py" \
  || die "packaged engine lacks a bounded latency journal"
grep -Fq '"M16_KEEPALIVE" in self.pending.values()' "$site_packages/wfd/rtsp/handler.py" \
  || die "packaged engine can accumulate unanswered keepalives"

pacman -Qp "$package" >/dev/null
printf 'Artifact audit passed: %s\n' "$package"
printf 'SHA-256: '
sha256sum "$package" | cut -d' ' -f1
