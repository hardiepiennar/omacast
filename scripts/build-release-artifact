#!/usr/bin/env bash
# Build the companion package from the exact committed tree and emit checksums.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
output_dir="${1:-$repo_root/dist}"
build_root=""

die() {
  echo "build-release-artifact: $*" >&2
  exit 1
}

cleanup() {
  case "$build_root" in
    /tmp/omacast-release-build."${UID}".*)
      if [[ -d "$build_root" && ! -L "$build_root" && "$(stat -c %u "$build_root")" == "$UID" ]]; then
        rm -rf -- "$build_root"
      fi
      ;;
  esac
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

command -v git >/dev/null || die "git is required"
command -v makepkg >/dev/null || die "makepkg is required"
command -v mktemp >/dev/null || die "mktemp is required"
command -v pacman >/dev/null || die "pacman is required"

[[ -d "$repo_root/.git" ]] || die "run this from a git clone"
[[ -z "$(git -C "$repo_root" status --porcelain --untracked-files=normal)" ]] \
  || die "the source tree must be clean"

source_commit="$(git -C "$repo_root" rev-parse --verify HEAD)"
[[ "$source_commit" =~ ^[0-9a-f]{40}$ ]] || die "could not resolve the source commit"

build_root="$(mktemp -d -p /tmp "omacast-release-build.${UID}.XXXXXXXX")"
[[ -d "$build_root" && ! -L "$build_root" && "$(stat -c %u:%a "$build_root")" == "$UID:700" ]] \
  || die "mktemp did not create a private build directory"
git clone --quiet --no-local "$repo_root" "$build_root/source"

clone_commit="$(git -C "$build_root/source" rev-parse --verify HEAD)"
[[ "$clone_commit" == "$source_commit" ]] || die "clean clone does not match source commit"

source_date_epoch="$(git -C "$build_root/source" show -s --format=%ct HEAD)"
export SOURCE_DATE_EPOCH="$source_date_epoch"

(
  cd "$build_root/source/packaging/arch"
  makepkg --cleanbuild --clean --noconfirm
)

mapfile -t packages < <(
  find "$build_root/source/packaging/arch" -maxdepth 1 -type f \
    -name 'fluxcast-omarchy-cast-*.pkg.tar.zst' -print
)
[[ ${#packages[@]} -eq 1 ]] || die "expected exactly one built package, found ${#packages[@]}"

package_name="$(basename "${packages[0]}")"
if [[ -e "$output_dir" || -L "$output_dir" ]]; then
  [[ -d "$output_dir" && ! -L "$output_dir" ]] || die "output path must be a real directory: $output_dir"
else
  mkdir -m 0755 -- "$output_dir" || die "could not create output directory: $output_dir"
fi

output_owner="$(stat -c %u -- "$output_dir")"
output_mode="$(stat -c %a -- "$output_dir")"
[[ "$output_owner" == "$UID" ]] || die "output directory is not owned by the current user"
(( (8#$output_mode & 0022) == 0 )) || die "output directory must not be group- or world-writable"
output_identity="$(stat -c %d:%i -- "$output_dir")"
output_dir="$(cd -- "$output_dir" && pwd -P)"

(
  cd -- "$output_dir"
  [[ "$(stat -c %d:%i .)" == "$output_identity" ]] || die "output directory changed during publication"

  publish_root="$(mktemp -d -p . ".omacast-release-output.${UID}.XXXXXXXX")"
  # shellcheck disable=SC2329 # Invoked by the trap below.
  cleanup_publish() {
    case "$publish_root" in
      ./.omacast-release-output."${UID}".*)
        if [[ -d "$publish_root" && ! -L "$publish_root" && "$(stat -c %u "$publish_root")" == "$UID" ]]; then
          rm -rf -- "$publish_root"
        fi
        ;;
    esac
  }
  trap cleanup_publish EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  install -m 0644 "${packages[0]}" "$publish_root/$package_name"
  (
    cd -- "$publish_root"
    sha256sum "$package_name" > SHA256SUMS
    pacman -Qip "$package_name" > PACKAGE-INFO.txt
    LC_ALL=C pacman -Q | sort > BUILD-ENVIRONMENT.txt
    printf '%s\n' "$source_commit" > SOURCE-COMMIT.txt
  )

  for artifact in "$package_name" PACKAGE-INFO.txt BUILD-ENVIRONMENT.txt SOURCE-COMMIT.txt SHA256SUMS; do
    mv -T -- "$publish_root/$artifact" "./$artifact"
  done
  rmdir -- "$publish_root"
  publish_root=""
)

printf 'Built %s from %s\n' "$output_dir/$package_name" "$source_commit"
printf 'Verify with: (cd %q && sha256sum -c SHA256SUMS)\n' "$output_dir"
