+    def test_wheel_does_not_install_legacy_system_integration(self):
+        project = pathlib.Path(__file__).resolve().parents[1] / "pyproject.toml"
+        metadata = project.read_text(encoding="utf-8")
+        for removed in (
+            "fluxcast-install-system",
+            "pypi_sysinstall.py",
+            "fluxcast.desktop",
+            "zz-dev.fluxcast.wpa-supplicant.conf",
+            "src/assets/*.png",
+        ):
+            self.assertNotIn(removed, metadata)
+
+    def test_main_has_no_unreachable_legacy_transport(self):
+        source = pathlib.Path(fluxcast_main.__file__).read_text(encoding="utf-8")
+        for removed in (
+            "get_local_ip",
+            "_wait_for_hls_segments",
+            "StreamServer",
+            "CorsHLSRequestHandler",
+            "from cast import",
+            "from dlna import",
+        ):
+            self.assertNotIn(removed, source)
+
 
 if __name__ == "__main__":
     unittest.main()
