 class SelectedPeerScanTest(unittest.TestCase):
+    def test_networkmanager_byte_property_is_exact_and_bounded(self):
+        self.assertEqual(_variant_byte("(<byte 0x64>,)"), 100)
+        for value in ("(<byte 0xff>,) trailing", "(<byte 0x1>,)", "(<uint32 42>,)", "64"):
+            with self.subTest(value=value):
+                self.assertIsNone(_variant_byte(value))
