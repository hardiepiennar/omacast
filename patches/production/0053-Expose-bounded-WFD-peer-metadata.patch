 )
-from .dbus import _gdbus_call, _nm_get_property, _nm_get_string, _object_paths
+from .dbus import _gdbus_call, _nm_get_property, _nm_get_string, _object_paths, _variant_byte
 
 
 def _p2p_device_path(interface: Optional[str] = None) -> Optional[str]:
@@ -82,9 +82,15 @@ def _nm_scan(interface: Optional[str], timeout: int,
 
     peers: list[WFDPeer] = []
     for peer_path in peer_paths:
-        name = _nm_get_string(peer_path, "org.freedesktop.NetworkManager.WifiP2PPeer", "Name")[:256]
-        address = _nm_get_string(peer_path, "org.freedesktop.NetworkManager.WifiP2PPeer", "HwAddress")
-        wfd_raw = _nm_get_property(peer_path, "org.freedesktop.NetworkManager.WifiP2PPeer", "WfdIEs")
+        peer_interface = "org.freedesktop.NetworkManager.WifiP2PPeer"
+        name = _nm_get_string(peer_path, peer_interface, "Name")[:256]
+        address = _nm_get_string(peer_path, peer_interface, "HwAddress")
+        manufacturer = _nm_get_string(peer_path, peer_interface, "Manufacturer")[:256]
+        model = _nm_get_string(peer_path, peer_interface, "Model")[:256]
+        strength = _variant_byte(_nm_get_property(peer_path, peer_interface, "Strength"))
+        if strength is not None and strength > 100:
+            strength = None
+        wfd_raw = _nm_get_property(peer_path, peer_interface, "WfdIEs")
         if len(wfd_raw) > 65_536:
             wfd_raw = ""
         wfd_ies = _parse_gdbus_byte_array(wfd_raw)
@@ -94,5 +100,6 @@ def _nm_scan(interface: Optional[str], timeout: int,
         peers.append(WFDPeer(
             address=address, name=name, details=details,
             path=peer_path, source="NetworkManager", rtsp_port=sink_port,
+            manufacturer=manufacturer, model=model, strength_percent=strength,
         ))
     return peers
