diff --git a/src/wfd/ie.py b/src/wfd/ie.py
index 5253805..d06ecab 100644
--- a/src/wfd/ie.py
+++ b/src/wfd/ie.py
@@ -26,6 +26,9 @@ class WFDPeer:
     path: str = ""
     source: str = ""
     rtsp_port: int = 7236
+    manufacturer: str = ""
+    model: str = ""
+    strength_percent: Optional[int] = None
 
 def _parse_gdbus_byte_array(raw: str) -> list[int]:
     """Parse a gdbus @ay variant string into a list of integer byte values.
diff --git a/src/wfd/p2p/dbus.py b/src/wfd/p2p/dbus.py
index c4c1999..e2683b1 100644
--- a/src/wfd/p2p/dbus.py
+++ b/src/wfd/p2p/dbus.py
@@ -36,6 +36,12 @@ def _variant_uint_tuple(text: str) -> tuple[Optional[int], Optional[int]]:
         return None, None
     return int(matches[-2]), int(matches[-1])
 
+def _variant_byte(text: str) -> Optional[int]:
+    match = re.fullmatch(r"\s*\(\s*<byte 0x([0-9a-fA-F]{2})>\s*,?\s*\)\s*", text)
+    if not match:
+        return None
+    return int(match.group(1), 16)
+
 NM_ACTIVE_STATE_NAMES = {
     0: "unknown",
     1: "activating",
diff --git a/src/wfd/p2p/nm.py b/src/wfd/p2p/nm.py
index f0102db..b5fb9b3 100644
--- a/src/wfd/p2p/nm.py
+++ b/src/wfd/p2p/nm.py
@@ -13,7 +13,7 @@ from ..ie import (
 from .dbus import (
     NM_ACTIVE_STATE_NAMES, NM_DEVICE_REASON_NAMES, NM_DEVICE_STATE_NAMES,
     _gdbus_call, _nm_get_property, _nm_get_string, _object_paths,
-    _variant_byte_array, _variant_uint, _variant_uint_tuple, _wfd_source_ie,
+    _variant_byte, _variant_byte_array, _variant_uint, _variant_uint_tuple, _wfd_source_ie,
 )
 
 
@@ -173,6 +173,11 @@ def _nm_scan(
         address = _nm_get_string(peer_path, "org.freedesktop.NetworkManager.WifiP2PPeer", "HwAddress")
         model = _nm_get_string(peer_path, "org.freedesktop.NetworkManager.WifiP2PPeer", "Model")
         manufacturer = _nm_get_string(peer_path, "org.freedesktop.NetworkManager.WifiP2PPeer", "Manufacturer")
+        strength = _variant_byte(_nm_get_property(
+            peer_path, "org.freedesktop.NetworkManager.WifiP2PPeer", "Strength"
+        ))
+        if strength is not None and strength > 100:
+            strength = None
         wfd_ies_raw = _nm_get_property(peer_path, "org.freedesktop.NetworkManager.WifiP2PPeer", "WfdIEs")
         
         # wfd_ies_raw is the raw gdbus stdout string (e.g. "<@ay [byte 0x00, ...]>").
@@ -197,6 +202,9 @@ def _nm_scan(
             path=peer_path,
             source="NetworkManager",
             rtsp_port=sink_rtsp_port,
+            manufacturer=manufacturer,
+            model=model,
+            strength_percent=strength,
         ))
     return peers
 
diff --git a/src/wfd/p2p/scan_nm.py b/src/wfd/p2p/scan_nm.py
index d92dbc3..8358a43 100644
--- a/src/wfd/p2p/scan_nm.py
+++ b/src/wfd/p2p/scan_nm.py
@@ -11,7 +11,7 @@ from ..ie import (
     _parse_wfd_ies_rtsp_port,
