diff --git a/src/capture/capture.py b/src/capture/capture.py
index 4d99f6e..0f88824 100644
--- a/src/capture/capture.py
+++ b/src/capture/capture.py
@@ -1,4 +1,5 @@
 import glob
+import json
 import os
 import re
 import subprocess
@@ -181,7 +182,43 @@ def _parse_xrandr(display: str) -> list:
     return monitors
 
 
+def _parse_hyprland_monitors() -> list:
+    hyprctl = shutil.which("hyprctl")
+    if not hyprctl or not detect_session().is_hyprland:
+        return []
+    try:
+        result = subprocess.run(
+            [hyprctl, "monitors", "-j"],
+            capture_output=True, text=True, timeout=4,
+        )
+        payload = json.loads(result.stdout) if result.returncode == 0 else []
+    except (subprocess.TimeoutExpired, FileNotFoundError, json.JSONDecodeError):
+        return []
+
+    monitors: list = []
+    for entry in payload if isinstance(payload, list) else []:
+        try:
+            if entry.get("disabled", False):
+                continue
+            monitors.append(Monitor(
+                display=os.environ.get("WAYLAND_DISPLAY", "wayland"),
+                name=str(entry["name"]),
+                width=int(entry["width"]),
+                height=int(entry["height"]),
+                x=int(entry.get("x", 0)),
+                y=int(entry.get("y", 0)),
+                refresh=float(entry.get("refreshRate", 0.0)),
+                primary=bool(entry.get("focused", False)),
+            ))
+        except (KeyError, TypeError, ValueError):
+            continue
+    return monitors
+
+
 def gather_monitors() -> list:
+    hyprland_monitors = _parse_hyprland_monitors()
+    if hyprland_monitors:
+        return hyprland_monitors
     all_monitors: list = []
     for disp in _detect_live_displays():
         all_monitors.extend(_parse_xrandr(disp))
