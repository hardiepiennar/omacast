index 0000000..92f5079
--- /dev/null
+++ b/tests/test_wfd_media_vaapi.py
@@ -0,0 +1,63 @@
+import io
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest import mock
+
+from wfd.config import WFDMediaConfig
+from wfd.media.pipeline import WFDMediaPipeline
+
+
+class _Process:
+    def __init__(self, with_stdout=False):
+        self.stdout = io.BytesIO() if with_stdout else None
+
+    def poll(self):
+        return None
+
+    def kill(self):
+        pass
+
+    def terminate(self):
+        pass
+
+
+class WlrootsVAAPITest(unittest.TestCase):
+    def test_wf_recorder_uses_vaapi_upload_and_baseline_profile(self):
+        config = WFDMediaConfig(
+            monitor=SimpleNamespace(name="eDP-1", width=1920, height=1080),
+            output_resolution="1280x720",
+            fps=30,
+            bitrate="5M",
+            no_audio=True,
+            capture_backend="wf-recorder",
+            video_encoder="vaapi",
+        )
+        pipeline = WFDMediaPipeline(
+            config,
+            tv_ip="192.168.49.2",
+            local_ip="192.168.49.1",
+            sink_rtp_port=19000,
+        )
+        commands = []
+
+        def popen(command, *args, **kwargs):
+            commands.append(command)
+            return _Process(with_stdout=kwargs.get("stdout") is not None)
+
+        with mock.patch("wfd.media.wlroots.shutil.which", return_value="/usr/bin/wf-recorder"), \
+             mock.patch("wfd.media.wlroots.Path.glob", return_value=[Path("/dev/dri/renderD128")]), \
+             mock.patch("wfd.media.wlroots._detect_audio_monitor", return_value="monitor"), \
+             mock.patch("wfd.media.wlroots.subprocess.Popen", side_effect=popen), \
+             mock.patch("wfd.media.wlroots.time.sleep"):
+            pipeline._start_desktop_wf_recorder()
+
+        ffmpeg = commands[1]
+        self.assertIn("h264_vaapi", ffmpeg)
+        self.assertIn("format=nv12,hwupload", ffmpeg[ffmpeg.index("-vf") + 1])
+        self.assertEqual(ffmpeg[ffmpeg.index("-profile:v") + 1], "constrained_baseline")
+        self.assertEqual(ffmpeg[ffmpeg.index("-vaapi_device") + 1], "/dev/dri/renderD128")
+
+
+if __name__ == "__main__":
+    unittest.main()
