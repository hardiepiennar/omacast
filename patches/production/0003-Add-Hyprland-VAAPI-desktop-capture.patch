diff --git a/tests/test_capture_hyprland.py b/tests/test_capture_hyprland.py
new file mode 100644
index 0000000..adf4449
--- /dev/null
+++ b/tests/test_capture_hyprland.py
@@ -0,0 +1,44 @@
+import json
+import os
+import unittest
+from types import SimpleNamespace
+from unittest import mock
+
+from capture.capture import gather_monitors
+
+
+class HyprlandMonitorDiscoveryTest(unittest.TestCase):
+    def test_gather_monitors_uses_hyprctl_json_on_hyprland(self):
+        payload = [{
+            "name": "eDP-1",
+            "width": 1920,
+            "height": 1080,
+            "x": 0,
+            "y": 0,
+            "refreshRate": 59.934,
+            "focused": True,
+            "disabled": False,
+        }]
+        result = SimpleNamespace(returncode=0, stdout=json.dumps(payload))
+        environment = {
+            **os.environ,
+            "WAYLAND_DISPLAY": "wayland-1",
+            "XDG_SESSION_TYPE": "wayland",
+            "XDG_CURRENT_DESKTOP": "Hyprland",
+            "HYPRLAND_INSTANCE_SIGNATURE": "test",
+        }
+
+        with mock.patch.dict(os.environ, environment, clear=True), \
+             mock.patch("capture.capture.shutil.which", return_value="/usr/bin/hyprctl"), \
+             mock.patch("capture.capture.subprocess.run", return_value=result):
+            monitors = gather_monitors()
+
+        self.assertEqual(len(monitors), 1)
+        self.assertEqual(monitors[0].name, "eDP-1")
+        self.assertEqual((monitors[0].width, monitors[0].height), (1920, 1080))
+        self.assertEqual(monitors[0].display, "wayland-1")
+        self.assertTrue(monitors[0].primary)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_wfd_media_vaapi.py b/tests/test_wfd_media_vaapi.py
