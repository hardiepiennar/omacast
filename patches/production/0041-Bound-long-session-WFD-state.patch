+class RTSPKeepaliveLimitTest(unittest.TestCase):
+    def test_unanswered_keepalive_is_not_duplicated(self):
+        handler = _WFDRTSPHandler.__new__(_WFDRTSPHandler)
+        handler._keepalive_active = True
+        handler.media = None
+        handler.pending = {"7": "M16_KEEPALIVE"}
+        with mock.patch.object(handler, "_send_request") as send, \
+             mock.patch.object(handler, "_schedule_rtsp_keepalive") as schedule:
+            handler._send_rtsp_keepalive()
+        send.assert_not_called()
+        schedule.assert_called_once_with(25.0)
+        self.assertEqual(handler.pending, {"7": "M16_KEEPALIVE"})
+
+
 if __name__ == "__main__":
     unittest.main()
