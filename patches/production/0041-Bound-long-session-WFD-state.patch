index 0cddbe3..c0f1959 100644
--- a/src/wfd/latency.py
+++ b/src/wfd/latency.py
@@ -1,9 +1,84 @@
 import json
+import os
+import re
+import stat
+import threading
 import time
 from datetime import datetime, timezone
 from typing import Optional
 
 
+MAX_LATENCY_LOG_BYTES = 256 * 1024
+MAX_LATENCY_RECORD_BYTES = 16 * 1024
+_PRESERVED_PREFIX_BYTES = 16 * 1024
+_CONTROLLER_FD_PATH = re.compile(r"^/proc/[1-9][0-9]*/fd/[0-9]+$")
+_LATENCY_LOG_LOCK = threading.Lock()
+
+
+def _write_all(descriptor: int, payload: bytes, offset: int) -> None:
+    view = memoryview(payload)
+    while view:
+        written = os.pwrite(descriptor, view, offset)
+        if written <= 0:
+            raise OSError("latency log write made no progress")
+        offset += written
+        view = view[written:]
+
+
+def _complete_prefix(descriptor: int, size: int) -> bytes:
+    prefix = os.pread(descriptor, min(size, _PRESERVED_PREFIX_BYTES), 0)
+    end = prefix.rfind(b"\n")
+    return prefix[:end + 1] if end >= 0 else b""
+
+
+def _complete_tail(descriptor: int, size: int, budget: int) -> bytes:
+    if budget <= 0 or size <= 0:
+        return b""
+    start = max(0, size - budget)
+    tail = os.pread(descriptor, min(size, budget), start)
+    if start:
+        first_line = tail.find(b"\n")
+        return tail[first_line + 1:] if first_line >= 0 else b""
+    return tail
+
+
+def _write_latency_record(path: str, record: bytes) -> None:
+    if len(record) > MAX_LATENCY_RECORD_BYTES:
+        raise ValueError("latency record exceeds its byte limit")
+
+    flags = os.O_RDWR | os.O_CLOEXEC | getattr(os, "O_NONBLOCK", 0)
+    if not _CONTROLLER_FD_PATH.fullmatch(path):
+        flags |= os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
+    descriptor = os.open(path, flags, 0o600)
+    try:
+        metadata = os.fstat(descriptor)
+        if (
+            not stat.S_ISREG(metadata.st_mode)
+            or metadata.st_uid != os.getuid()
+            or metadata.st_mode & 0o077
+            or metadata.st_nlink not in (0, 1)
+        ):
+            raise ValueError("latency log output is unsafe")
+
+        if metadata.st_size + len(record) <= MAX_LATENCY_LOG_BYTES:
+            _write_all(descriptor, record, metadata.st_size)
+            return
+
+        marker = b'{"event":"log_compacted"}\n'
+        prefix = _complete_prefix(descriptor, metadata.st_size)
+        available = MAX_LATENCY_LOG_BYTES - len(prefix) - len(marker) - len(record)
+        tail = _complete_tail(
+            descriptor,
+            metadata.st_size,
+            min(max(0, available), MAX_LATENCY_LOG_BYTES // 2),
+        )
+        payload = prefix + marker + tail + record
+        os.ftruncate(descriptor, 0)
+        _write_all(descriptor, payload, 0)
+    finally:
+        os.close(descriptor)
+
+
 def _append_latency_log(path: Optional[str], event: str, **fields: object) -> None:
     if not path:
         return
@@ -13,8 +88,9 @@ def _append_latency_log(path: Optional[str], event: str, **fields: object) -> No
         "event": event,
         **fields,
     }
+    record = (json.dumps(payload, ensure_ascii=True) + "\n").encode("ascii")
     try:
-        with open(path, "a", encoding="utf-8") as file:
-            file.write(json.dumps(payload, ensure_ascii=True) + "\n")
-    except OSError:
+        with _LATENCY_LOG_LOCK:
+            _write_latency_record(path, record)
+    except (OSError, ValueError):
         pass
