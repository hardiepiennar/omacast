diff --git a/tests/test_wfd_latency.py b/tests/test_wfd_latency.py
new file mode 100644
index 0000000..f940dd1
--- /dev/null
+++ b/tests/test_wfd_latency.py
@@ -0,0 +1,73 @@
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+
+from wfd.latency import (
+    MAX_LATENCY_LOG_BYTES,
+    MAX_LATENCY_RECORD_BYTES,
+    _append_latency_log,
+)
+
+
+class LatencyLogLimitTest(unittest.TestCase):
+    def test_long_session_retains_valid_bounded_json_lines(self):
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / "engine.jsonl"
+            _append_latency_log(str(path), "media_starting", mode="1280x720p60")
+            for sequence in range(4000):
+                _append_latency_log(
+                    str(path),
+                    "sender_health",
+                    sequence=sequence,
+                    detail="x" * 100,
+                )
+
+            payload = path.read_bytes()
+            self.assertLessEqual(len(payload), MAX_LATENCY_LOG_BYTES)
+            records = [json.loads(line) for line in payload.splitlines()]
+            self.assertEqual(records[0]["event"], "media_starting")
+            self.assertEqual(records[-1]["sequence"], 3999)
+            self.assertTrue(any(record["event"] == "log_compacted" for record in records))
+
+    def test_oversized_record_is_not_written(self):
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / "engine.jsonl"
+            _append_latency_log(str(path), "oversized", detail="x" * MAX_LATENCY_RECORD_BYTES)
+            self.assertFalse(path.exists())
+
+    def test_unsafe_existing_path_is_not_modified(self):
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / "engine.jsonl"
+            path.write_text("keep\n", encoding="ascii")
+            path.chmod(0o644)
+            _append_latency_log(str(path), "sender_health")
+            self.assertEqual(path.read_text(encoding="ascii"), "keep\n")
+
+    def test_symlink_output_is_not_followed(self):
+        with tempfile.TemporaryDirectory() as temp:
+            victim = Path(temp) / "victim"
+            victim.write_text("keep\n", encoding="ascii")
+            victim.chmod(0o600)
+            link = Path(temp) / "engine.jsonl"
+            link.symlink_to(victim)
+            _append_latency_log(str(link), "sender_health")
+            self.assertEqual(victim.read_text(encoding="ascii"), "keep\n")
+
+    def test_controller_descriptor_path_is_supported(self):
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / "engine.jsonl"
+            descriptor = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
+            try:
+                _append_latency_log(
+                    f"/proc/{os.getpid()}/fd/{descriptor}",
+                    "media_starting",
+                )
+            finally:
+                os.close(descriptor)
+            self.assertEqual(json.loads(path.read_text(encoding="ascii"))["event"], "media_starting")
+
+
+if __name__ == "__main__":
+    unittest.main()
