From 00f8793d98ec541b86987bed3b0f344df6d4bade Mon Sep 17 00:00:00 2001
From: Omacast maintainers <packaging@localhost>
Date: Wed, 2 Sep 2026 21:52:33 +1200
Subject: [PATCH] Buffer GSR handoff bursts

---
 src/wfd/media/wlroots.py      | 14 +++++++++++++-
 tests/test_wfd_media_vaapi.py |  4 ++++
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/src/wfd/media/wlroots.py b/src/wfd/media/wlroots.py
index 9fc9097..52f88f6 100644
--- a/src/wfd/media/wlroots.py
+++ b/src/wfd/media/wlroots.py
@@ -13,6 +13,13 @@ from ..net import _ffmpeg_sender_args
 from ..progress import _start_ffmpeg_progress_drain
 
 
+# Decouple short Matroska/AAC interleave bursts from the paced RTP mux. This is
+# fixed and bounded: at the 10.5 Mbit/s transport rate it holds under one second
+# of data, while preventing the capture process from stalling on the kernel's
+# much smaller default pipe during ordinary burst delivery.
+_GSR_HANDOFF_PIPE_BYTES = 1_048_576
+
+
 def _stop_startup_process(proc: subprocess.Popen[bytes]) -> None:
     """Best-effort bounded cleanup without hiding the startup failure."""
     try:
@@ -131,7 +138,12 @@ class WlrootsMixin:
         capture_proc = None
         progress_thread = None
         try:
-            capture_proc = subprocess.Popen(capture_cmd, stdout=subprocess.PIPE, stderr=None)
+            capture_proc = subprocess.Popen(
+                capture_cmd,
+                stdout=subprocess.PIPE,
+                stderr=None,
+                pipesize=_GSR_HANDOFF_PIPE_BYTES,
+            )
             started_processes.append(capture_proc)
             if capture_proc.stdout is None:
                 raise WFDNotReady("gpu-screen-recorder did not expose stdout.")
diff --git a/tests/test_wfd_media_vaapi.py b/tests/test_wfd_media_vaapi.py
index 957bf1e..9a9372d 100644
--- a/tests/test_wfd_media_vaapi.py
+++ b/tests/test_wfd_media_vaapi.py
@@ -39,9 +39,11 @@ class WlrootsVAAPITest(unittest.TestCase):
             sink_rtp_port=19000,
         )
         commands = []
+        options = []
 
         def popen(command, *args, **kwargs):
             commands.append(command)
+            options.append(kwargs)
             return _Process(with_stdout=kwargs.get("stdout") is not None)
 
         with mock.patch("wfd.media.wlroots.shutil.which", return_value="/usr/bin/gpu-screen-recorder"), \
@@ -53,6 +55,8 @@ class WlrootsVAAPITest(unittest.TestCase):
         capture, ffmpeg = commands
         self.assertEqual(capture[0], "gpu-screen-recorder")
         self.assertIn("profile=constrained_baseline;level=31;aud=1", capture)
+        self.assertEqual(options[0]["pipesize"], 1_048_576)
+        self.assertNotIn("pipesize", options[1])
         self.assertEqual(ffmpeg[ffmpeg.index("-c:v") + 1], "copy")
         self.assertNotIn("-vf", ffmpeg)
         self.assertNotIn("-vaapi_device", ffmpeg)
