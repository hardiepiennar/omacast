diff --git a/src/wfd/rtsp/handler.py b/src/wfd/rtsp/handler.py
index d7954be..c96d010 100644
--- a/src/wfd/rtsp/handler.py
+++ b/src/wfd/rtsp/handler.py
@@ -24,6 +24,17 @@ from .message import (
 
 class _WFDRTSPHandler(socketserver.StreamRequestHandler):
     def handle(self) -> None:
+        client_ip = self.client_address[0]
+        parent = getattr(self.server, "parent_server", None)
+        if parent is None or not parent.claim_client(client_ip):
+            print(f"[FluxCast WFD RTSP] Rejected unverified client from {client_ip}")
