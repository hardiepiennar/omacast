index 0000000..cbd0ebf
--- /dev/null
+++ b/tests/test_wfd_rtsp_identity.py
@@ -0,0 +1,143 @@
+import subprocess
+import unittest
+from types import SimpleNamespace
+from unittest import mock
+
+from wfd.config import WFDMediaConfig
+from wfd.p2p.addressing import _is_expected_peer_ip, _neighbor_identity
+from wfd.rtsp.handler import _WFDRTSPHandler
+from wfd.rtsp.rtsp_server import WFDRTSPServer
+
+
+class NeighborIdentityTest(unittest.TestCase):
+    def test_parses_one_complete_neighbor_row(self):
+        self.assertEqual(
+            _neighbor_identity(
+                "192.168.49.1 dev p2p-wlan0-0 lladdr AA:BB:CC:DD:EE:FF REACHABLE"
+            ),
+            ("192.168.49.1", "p2p-wlan0-0", "aabbccddeeff"),
+        )
+
+    def test_selected_mac_and_interface_are_both_required(self):
+        result = subprocess.CompletedProcess(
+            args=[],
+            returncode=0,
+            stdout=(
+                "192.168.49.1 dev wlan0 lladdr aa:bb:cc:dd:ee:ff REACHABLE\n"
+                "192.168.49.1 dev p2p-wlan0-0 lladdr 11:22:33:44:55:66 REACHABLE\n"
+                "192.168.49.2 dev p2p-wlan0-0 lladdr 22:33:44:55:66:77 REACHABLE\n"
+                "192.168.49.1 dev p2p-wlan1-0 lladdr aa:bb:cc:dd:ee:ff REACHABLE\n"
+            ),
+            stderr="",
+        )
+        with mock.patch("wfd.p2p.addressing.shutil.which", return_value="/usr/bin/ip"), mock.patch(
+            "wfd.p2p.addressing._run", return_value=result
+        ) as run:
+            self.assertFalse(
+                _is_expected_peer_ip("192.168.49.1", "aa:bb:cc:dd:ee:ff", "wlan0")
+            )
+        run.assert_called_once_with(
+            ["ip", "neigh", "show", "to", "192.168.49.1"], timeout=3.0
+        )
+
+    def test_selected_receiver_on_selected_p2p_interface_is_accepted(self):
+        result = subprocess.CompletedProcess(
+            args=[],
+            returncode=0,
+            stdout=(
+                "192.168.49.1 dev p2p-wlan0-0 lladdr aa:bb:cc:dd:ee:ff STALE\n"
+            ),
+            stderr="",
+        )
+        with mock.patch("wfd.p2p.addressing.shutil.which", return_value="/usr/bin/ip"), mock.patch(
+            "wfd.p2p.addressing._run", return_value=result
+        ):
+            self.assertTrue(
+                _is_expected_peer_ip("192.168.49.1", "AA-BB-CC-DD-EE-FF", "wlan0")
+            )
+
+    def test_sole_group_neighbor_allows_a_distinct_p2p_interface_mac(self):
+        result = subprocess.CompletedProcess(
+            args=[],
+            returncode=0,
+            stdout=(
+                "192.168.49.1 dev p2p-wlan0-0 lladdr 12:34:56:78:9a:bc REACHABLE\n"
+            ),
+            stderr="",
+        )
+        with mock.patch("wfd.p2p.addressing.shutil.which", return_value="/usr/bin/ip"), mock.patch(
+            "wfd.p2p.addressing._run", return_value=result
+        ):
+            self.assertTrue(
+                _is_expected_peer_ip("192.168.49.1", "aa:bb:cc:dd:ee:ff", "wlan0")
+            )
+
+    def test_invalid_identity_fails_closed_without_running_ip(self):
+        with mock.patch("wfd.p2p.addressing._run") as run:
+            self.assertFalse(_is_expected_peer_ip("not-an-ip", "aa:bb:cc:dd:ee:ff", "wlan0"))
+            self.assertFalse(_is_expected_peer_ip("192.168.49.1", "not-a-mac", "wlan0"))
+            self.assertFalse(_is_expected_peer_ip("192.168.49.1", "aa:bb:cc:dd:ee:ff!", "wlan0"))
+            self.assertFalse(_is_expected_peer_ip("192.168.49.1", "aa:bb:cc:dd:ee:ff", "bad/interface"))
+        run.assert_not_called()
+
+
+class RTSPClientClaimTest(unittest.TestCase):
+    def setUp(self):
+        self.server = WFDRTSPServer(
+            WFDMediaConfig(monitor=None),
+            peer_address="aa:bb:cc:dd:ee:ff",
+            interface="wlan0",
+        )
+
+    def test_unverified_client_is_rejected_without_changing_connection_state(self):
+        with mock.patch(
+            "wfd.rtsp.rtsp_server._is_expected_peer_ip", return_value=False
+        ):
+            self.assertFalse(self.server.claim_client("192.168.1.20"))
+        self.assertFalse(self.server.has_connected_client)
+
+    def test_only_one_verified_receiver_can_own_the_session(self):
+        with mock.patch(
+            "wfd.rtsp.rtsp_server._is_expected_peer_ip", return_value=True
+        ) as verify:
+            self.assertTrue(self.server.claim_client("192.168.49.1"))
+            self.assertFalse(self.server.claim_client("192.168.49.1"))
+            self.assertTrue(self.server.has_connected_client)
+            self.server.release_client("192.168.49.2")
+            self.assertTrue(self.server.has_connected_client)
+            self.server.release_client("192.168.49.1")
+            self.assertFalse(self.server.has_connected_client)
+            self.assertTrue(self.server.claim_client("192.168.49.1"))
+        self.assertEqual(verify.call_count, 3)
+
+
+class RTSPHandlerAdmissionTest(unittest.TestCase):
+    def _handler(self, parent):
+        handler = _WFDRTSPHandler.__new__(_WFDRTSPHandler)
+        handler.client_address = ("192.168.49.1", 7236)
+        handler.server = SimpleNamespace(parent_server=parent)
+        return handler
+
+    def test_rejected_client_never_reaches_rtsp_negotiation(self):
+        parent = mock.Mock()
+        parent.claim_client.return_value = False
+        handler = self._handler(parent)
+        with mock.patch.object(handler, "_handle_verified_client") as negotiate:
+            handler.handle()
+        parent.claim_client.assert_called_once_with("192.168.49.1")
+        negotiate.assert_not_called()
+        parent.release_client.assert_not_called()
+
+    def test_verified_client_ownership_is_released_after_handler_failure(self):
+        parent = mock.Mock()
+        parent.claim_client.return_value = True
+        handler = self._handler(parent)
+        with mock.patch.object(
+            handler, "_handle_verified_client", side_effect=RuntimeError("test failure")
+        ), self.assertRaisesRegex(RuntimeError, "test failure"):
+            handler.handle()
+        parent.release_client.assert_called_once_with("192.168.49.1")
+
+
+if __name__ == "__main__":
+    unittest.main()

