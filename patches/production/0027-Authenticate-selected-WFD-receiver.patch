@@ -6,7 +6,62 @@ from typing import Optional
 from ..proc import _run
 
 
-def _get_peer_ip_from_arp(peer_mac: str) -> Optional[str]:
+def _normalized_mac(value: str) -> str:
+    compact = value.replace(":", "").replace("-", "")
+    return compact.lower() if re.fullmatch(r"[0-9a-fA-F]{12}", compact) else ""
+
+
+def _neighbor_identity(line: str) -> tuple[str, str, str] | None:
+    """Return (IP, interface, MAC) for one complete neighbour row."""
+    fields = line.split()
+    if len(fields) < 5 or "dev" not in fields or "lladdr" not in fields:
+        return None
+    try:
+        interface = fields[fields.index("dev") + 1]
+        mac = fields[fields.index("lladdr") + 1]
+    except (IndexError, ValueError):
+        return None
+    if not re.fullmatch(r"\d+\.\d+\.\d+\.\d+", fields[0]):
+        return None
+    normalized = _normalized_mac(mac)
+    return (fields[0], interface, normalized) if normalized else None
+
+
+def _is_expected_peer_ip(peer_ip: str, peer_mac: str, interface: str) -> bool:
+    """Prove that peer_ip is the receiver on this session's P2P link.
+
+    A P2P group-interface MAC may differ from its discovery device address. An
+    exact MAC match is strongest; a sole neighbour on the session-scoped group
+    interface is also attributable because the guard required a clean baseline
+    before forming this selected receiver's group. Ambiguous groups fail closed.
+    """
+    if not re.fullmatch(r"\d+\.\d+\.\d+\.\d+", peer_ip):
+        return False
+    expected_mac = _normalized_mac(peer_mac)
+    if not expected_mac or not re.fullmatch(r"[A-Za-z0-9_.-]{1,15}", interface):
+        return False
+    if not shutil.which("ip"):
+        return False
+    try:
+        result = _run(["ip", "neigh", "show", "to", peer_ip], timeout=3.0)
+    except Exception:
+        return False
+    if result.returncode != 0:
+        return False
+    prefix = f"p2p-{interface}-"
+    candidates: list[tuple[str, str, str]] = []
+    for line in result.stdout.splitlines():
+        identity = _neighbor_identity(line)
+        if identity is None or not identity[1].startswith(prefix):
+            continue
+        candidates.append(identity)
+        if identity[0] == peer_ip and identity[2] == expected_mac:
+            return True
+    unique = {(candidate[0], candidate[2]) for candidate in candidates}
+    return len(unique) == 1 and candidates[0][0] == peer_ip
+
+
+def _get_peer_ip_from_arp(peer_mac: str, interface: Optional[str] = None) -> Optional[str]:
     """Return the IP for peer_mac from the kernel ARP/neighbour table."""
     if not shutil.which("ip"):
         return None
@@ -14,12 +69,23 @@ def _get_peer_ip_from_arp(peer_mac: str) -> Optional[str]:
         result = _run(["ip", "neigh", "show"], timeout=3.0)
         if result.returncode != 0:
             return None
-        mac = peer_mac.lower().replace("-", ":")
+        mac = _normalized_mac(peer_mac)
+        if not mac:
+            return None
+        candidates: list[tuple[str, str, str]] = []
         for line in result.stdout.splitlines():
-            if mac in line.lower():
-                parts = line.split()
-                if parts and re.fullmatch(r"\d+\.\d+\.\d+\.\d+", parts[0]):
-                    return parts[0]
+            identity = _neighbor_identity(line)
+            if not identity:
+                continue
+            if interface is not None and not identity[1].startswith(f"p2p-{interface}-"):
+                continue
+            candidates.append(identity)
+            if identity[2] == mac:
+                return identity[0]
+        if interface is not None:
+            unique = {(candidate[0], candidate[2]) for candidate in candidates}
+            if len(unique) == 1:
+                return candidates[0][0]
     except Exception:
         pass
     return None
@@ -47,11 +113,19 @@ def _get_peer_ip_from_p2p_iface() -> Optional[str]:
         pass
     return None
 
