diff --git a/src/wfd/rtsp/rtsp_server.py b/src/wfd/rtsp/rtsp_server.py
index 15f41e2..9141163 100644
--- a/src/wfd/rtsp/rtsp_server.py
+++ b/src/wfd/rtsp/rtsp_server.py
@@ -5,6 +5,7 @@ from typing import Optional
 from ..config import WFDMediaConfig
 from ..constants import WFD_RTSP_PORT
 from ..media.pipeline import WFDMediaPipeline
+from ..p2p.addressing import _is_expected_peer_ip
 from .handler import _WFDRTSPHandler
 
 
@@ -16,19 +17,42 @@ class WFDRTSPServer:
     def __init__(
         self,
         media_config: WFDMediaConfig,
+        peer_address: str,
+        interface: str,
         host: str = "0.0.0.0",
         port: int = WFD_RTSP_PORT,
     ) -> None:
         self.host = host
         self.port = port
         self.media_config = media_config
+        self.peer_address = peer_address
+        self.interface = interface
         self._server: Optional[socketserver.ThreadingTCPServer] = None
         self._thread: Optional[threading.Thread] = None
         self.has_connected_client = False
+        self._client_lock = threading.Lock()
+        self._connected_client: Optional[str] = None
         self._media_lock = threading.Lock()
         self._active_media: list[WFDMediaPipeline] = []
         self._uibc_server = None  # opt-in UIBC input server; None unless enabled
 
+    def claim_client(self, client_ip: str) -> bool:
+        """Admit only the selected receiver, and only once at a time."""
+        if not _is_expected_peer_ip(client_ip, self.peer_address, self.interface):
+            return False
+        with self._client_lock:
+            if self._connected_client is not None:
+                return False
+            self._connected_client = client_ip
+            self.has_connected_client = True
+            return True
+
+    def release_client(self, client_ip: str) -> None:
+        with self._client_lock:
+            if self._connected_client == client_ip:
+                self._connected_client = None
+                self.has_connected_client = False
+
     def _register_media(self, media: WFDMediaPipeline) -> None:
         with self._media_lock:
             self._active_media.append(media)
