@@ -35,13 +35,19 @@ def _active_rtsp_probe(
 
     print("[FluxCast WFD RTSP] No passive connection; trying Source-initiated RTSP probe...")
 
-    tv_ip = _wait_for_peer_ip(peer.address, timeout=10.0)
+    # A direct-supplicant client group needs to obtain its lease from the sink
+    # before the sink IP appears in the neighbour table. Fire TV took just over
+    # six seconds from group-object creation in the phase-1 trace.
+    tv_ip = _wait_for_peer_ip(peer.address, timeout=8.0)
     if not tv_ip:
         print(
-            f"[FluxCast WFD RTSP] Active probe: TV IP not found for MAC {peer.address} "
-            "— ARP table empty; is the P2P link still up?"
+            f"[FluxCast WFD RTSP] Active probe: TV IP not found for MAC {peer.address}; "
+            "trying conventional Wi-Fi Direct client address 192.168.49.2."
         )
-        return
+        # Some Miracast sinks use the conventional Android Wi-Fi Direct static
+        # address and remain absent from ARP until the source contacts them.
+        # Trying it also creates the ARP request needed to discover that sink.
+        tv_ip = "192.168.49.2"
 
     if rtsp_server.has_connected_client:
         return
