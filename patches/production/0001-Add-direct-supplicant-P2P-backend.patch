diff --git a/src/wfd/p2p/supplicant.py b/src/wfd/p2p/supplicant.py
new file mode 100644
index 0000000..9fde7ac
--- /dev/null
+++ b/src/wfd/p2p/supplicant.py
@@ -0,0 +1,276 @@
+import re
+import time
+from dataclasses import dataclass
+from typing import Optional
+
+from ..config import WFDNotReady
+from ..ie import WFDPeer, _parse_gdbus_byte_array
+from .dbus import _gdbus_call, _object_paths, _variant_byte_array, _wfd_source_ie
+from .device import _p2p_device_iface_paths
+
+
+WPA_DEST = "fi.w1.wpa_supplicant1"
+WPA_ROOT = "/fi/w1/wpa_supplicant1"
+WPA_IFACE = "fi.w1.wpa_supplicant1.Interface"
+WPA_P2P = f"{WPA_IFACE}.P2PDevice"
+WPA_PEER = "fi.w1.wpa_supplicant1.Peer"
+WPA_GROUP = "fi.w1.wpa_supplicant1.Group"
+
+
+@dataclass(frozen=True)
+class SupplicantGroup:
+    group_path: str
+    interface_path: str
+    ifname: str
+    role: str
+
+
+def _wpa_property(path: str, interface: str, prop: str) -> str:
+    result = _gdbus_call([
+        "--dest", WPA_DEST,
+        "--object-path", path,
+        "--method", "org.freedesktop.DBus.Properties.Get",
+        interface,
+        prop,
+    ])
+    if result.returncode != 0:
+        return ""
+    return result.stdout.strip()
+
+
+def _wpa_string_property(path: str, interface: str, prop: str) -> str:
+    raw = _wpa_property(path, interface, prop)
+    match = re.search(r"<['\"](.*?)['\"]>", raw)
+    return match.group(1) if match else ""
+
+
+def _wpa_object_path_property(path: str, interface: str, prop: str) -> str:
+    raw = _wpa_property(path, interface, prop)
+    match = re.search(r"objectpath ['\"]([^'\"]+)['\"]", raw)
+    return match.group(1) if match else ""
+
+
+def _supplicant_interface_path(interface: Optional[str]) -> str:
+    paths = _p2p_device_iface_paths(interface)
+    if not paths:
+        raise WFDNotReady("wpa_supplicant did not expose a P2P control interface.")
+    return paths[0]
+
+
+def _mac_from_byte_array(raw: str) -> str:
+    values = _parse_gdbus_byte_array(raw)
+    if len(values) < 6:
+        return ""
+    return ":".join(f"{value:02x}" for value in values[:6])
+
+
+def _supplicant_peer_path(interface_path: str, peer_address: str) -> str:
+    peers_raw = _wpa_property(interface_path, WPA_P2P, "Peers")
+    wanted = peer_address.lower().replace("-", ":")
+    for peer_path in _object_paths(peers_raw):
+        address_raw = _wpa_property(peer_path, WPA_PEER, "DeviceAddress")
+        if _mac_from_byte_array(address_raw) == wanted:
+            return peer_path
+
+    # wpa_supplicant uses the lower-case, separator-free device address in its
+    # peer object path. Keep this deterministic fallback useful for dry-runs.
+    compact = re.sub(r"[^0-9a-f]", "", wanted)
+    if len(compact) == 12:
+        return f"{interface_path}/Peers/{compact}"
+    raise WFDNotReady(f"Could not resolve supplicant peer object for {peer_address}.")
+
+
+def _supplicant_connect_options(
+    peer_path: str,
+    mode: str,
+    go_intent: int,
+    persistent: bool = False,
+) -> str:
+    if mode not in {"authorize", "connect", "join"}:
+        raise WFDNotReady(f"Unsupported direct supplicant mode: {mode}")
+    if not 0 <= go_intent <= 15:
+        raise WFDNotReady(f"Invalid P2P GO intent: {go_intent}")
+
+    authorize_only = mode == "authorize"
+    join = mode == "join"
+    boolean = lambda value: "true" if value else "false"
+    return (
+        "{"
+        f"'peer': <objectpath '{peer_path}'>, "
+        f"'persistent': <{boolean(persistent)}>, "
+        f"'join': <{boolean(join)}>, "
+        f"'authorize_only': <{boolean(authorize_only)}>, "
+        f"'go_intent': <int32 {go_intent}>, "
+        "'wps_method': <'pbc'>"
+        "}"
+    )
+
+
+def _set_supplicant_wfd_ies(rtsp_port: int, dry_run: bool = False) -> None:
+    value = f"<{_variant_byte_array(_wfd_source_ie(rtsp_port))}>"
+    args = [
+        "--dest", WPA_DEST,
+        "--object-path", WPA_ROOT,
+        "--method", "org.freedesktop.DBus.Properties.Set",
+        WPA_DEST, "WFDIEs", value,
+    ]
+    if dry_run:
+        print("[FluxCast WFD] Dry-run supplicant WFDIEs call:")
+        print("gdbus call --system " + " ".join(args))
+        return
+    result = _gdbus_call(args)
+    if result.returncode != 0:
+        raise WFDNotReady((result.stderr or result.stdout).strip())
+
+
+def _supplicant_connect(
+    interface_path: str,
+    peer: WFDPeer,
+    mode: str,
+    go_intent: int,
+    rtsp_port: int,
+    persistent: bool = False,
+    dry_run: bool = False,
+) -> None:
+    peer_path = _supplicant_peer_path(interface_path, peer.address)
+    options = _supplicant_connect_options(peer_path, mode, go_intent, persistent)
+    args = [
+        "--dest", WPA_DEST,
+        "--object-path", interface_path,
+        "--method", f"{WPA_P2P}.Connect",
+        options,
+    ]
+
+    _set_supplicant_wfd_ies(rtsp_port, dry_run=dry_run)
+    if dry_run:
+        print("[FluxCast WFD] Dry-run direct supplicant Connect call:")
+        print("gdbus call --system " + " ".join(args))
+        return
+
+    print(
+        f"[FluxCast WFD] Direct supplicant mode={mode}, go_intent={go_intent}; "
+        f"target={peer.name or peer.address}."
+    )
+    result = _gdbus_call(args, timeout=15.0)
+    if result.returncode != 0:
+        message = (result.stderr or result.stdout).strip()
+        if "AccessDenied" in message or "denied" in message.lower():
+            raise WFDNotReady(
+                "System D-Bus denied direct P2P control. Install or temporarily "
+                "activate FluxCast's direct-supplicant policy. Raw error: " + message
+            )
+        raise WFDNotReady(message)
+
+
+def _group_from_interface(interface_path: str) -> Optional[SupplicantGroup]:
+    group_path = _wpa_object_path_property(interface_path, WPA_P2P, "Group")
+    if not group_path or group_path == "/":
+        return None
+
+    # The P2PDevice.Group property is exposed on the dynamically-created group
+    # interface itself. The Group object has role/member metadata, but it does
+    # not point back to an Interface object.
+    group_interface = interface_path
+    ifname = _wpa_string_property(interface_path, WPA_IFACE, "Ifname")
+    role = _wpa_string_property(group_path, WPA_GROUP, "Role")
+    return SupplicantGroup(group_path, group_interface, ifname, role)
+
+
+def _wait_for_supplicant_group(timeout: float = 45.0) -> SupplicantGroup:
+    print("[FluxCast WFD] Waiting for direct supplicant P2P group...")
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        interfaces_raw = _wpa_property(WPA_ROOT, WPA_DEST, "Interfaces")
+        for interface_path in _object_paths(interfaces_raw):
+            try:
+                group = _group_from_interface(interface_path)
+            except Exception:
+                group = None
+            if group:
+                print(
+                    f"[FluxCast WFD] Direct P2P group: role={group.role or 'unknown'}, "
+                    f"interface={group.ifname or group.interface_path}."
+                )
+                return group
+        time.sleep(0.5)
+    raise WFDNotReady("Timed out waiting for a direct supplicant P2P group.")
+
+
+def _supplicant_cancel_and_disconnect(interface: Optional[str]) -> None:
+    paths = _p2p_device_iface_paths(interface)
+    for interface_path in paths:
+        for member in ("Cancel", "Disconnect"):
+            try:
+                _gdbus_call([
+                    "--dest", WPA_DEST,
+                    "--object-path", interface_path,
+                    "--method", f"{WPA_P2P}.{member}",
+                ], timeout=3.0)
+            except Exception:
+                pass
+    try:
+        _gdbus_call([
+            "--dest", WPA_DEST,
+            "--object-path", WPA_ROOT,
+            "--method", "org.freedesktop.DBus.Properties.Set",
+            WPA_DEST, "WFDIEs", "<@ay []>",
+        ], timeout=3.0)
+    except Exception:
+        pass
+
+
+def connect_supplicant_group(args, peer: WFDPeer) -> SupplicantGroup:
+    interface_path = _supplicant_interface_path(args.wfd_interface)
+    mode = getattr(args, "wfd_supplicant_mode", "connect")
+    rtsp_port = getattr(args, "wfd_rtsp_port", 7236)
+    go_intent = getattr(args, "wfd_go_intent", 0)
+    dry_run = getattr(args, "wfd_dry_run", False)
+    preconnect_delay = max(
+        0, int(getattr(args, "wfd_supplicant_preconnect_delay", 0))
+    )
+
+    if preconnect_delay and not dry_run:
+        print(
+            "[FluxCast WFD] Direct connection armed; "
+            f"waiting {preconnect_delay}s before negotiation..."
+        )
+        time.sleep(preconnect_delay)
+
+    _supplicant_connect(
+        interface_path,
+        peer,
+        mode=mode,
+        go_intent=go_intent,
+        rtsp_port=rtsp_port,
+        dry_run=dry_run,
+    )
+    if dry_run:
+        raise WFDNotReady("A dry-run does not create a supplicant P2P group.")
+
+    return _wait_for_supplicant_group(
+        timeout=float(getattr(args, "wfd_supplicant_hold", 45))
+    )
+
+
+def run_supplicant_role_test(args, peer: WFDPeer) -> None:
+    if getattr(args, "wfd_dry_run", False):
+        interface_path = _supplicant_interface_path(args.wfd_interface)
+        _supplicant_connect(
+            interface_path,
+            peer,
+            mode=getattr(args, "wfd_supplicant_mode", "connect"),
+            go_intent=getattr(args, "wfd_go_intent", 0),
+            rtsp_port=getattr(args, "wfd_rtsp_port", 7236),
+            dry_run=True,
+        )
+        return
+
+    try:
+        connect_supplicant_group(args, peer)
+        hold = max(1, int(getattr(args, "wfd_supplicant_hold", 45)))
+        print(f"[FluxCast WFD] Holding role-test group for {hold}s. Press Ctrl+C to stop.")
+        time.sleep(hold)
+    except KeyboardInterrupt:
+        print("\n[FluxCast WFD] Stopping direct supplicant role test...")
+    finally:
+        _supplicant_cancel_and_disconnect(args.wfd_interface)
diff --git a/src/wfd/probe.py b/src/wfd/probe.py
