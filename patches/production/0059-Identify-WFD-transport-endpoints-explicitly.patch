From 7ac53b94c131f4b83695e13c17cd518442e03b91 Mon Sep 17 00:00:00 2001
From: Omacast maintainers <packaging@localhost>
Date: Wed, 2 Sep 2026 21:31:37 +1200
Subject: [PATCH] Identify WFD transport endpoints explicitly

---
 src/wfd/rtsp/handler.py       |  5 +++++
 tests/test_wfd_rtsp_limits.py | 25 +++++++++++++++++++++++++
 2 files changed, 30 insertions(+)

diff --git a/src/wfd/rtsp/handler.py b/src/wfd/rtsp/handler.py
index a6a7855..6cfe9fd 100644
--- a/src/wfd/rtsp/handler.py
+++ b/src/wfd/rtsp/handler.py
@@ -400,15 +400,20 @@ class _WFDRTSPHandler(socketserver.StreamRequestHandler):
                 self.sink_rtcp_port,
             )
             source_port = self.source_rtp_port
+            address_attributes = (
+                f"destination={self._client_ip};source={self.local_ip};"
+            )
             if self.sink_rtcp_port:
                 transport = (
                     "RTP/AVP/UDP;unicast;"
+                    f"{address_attributes}"
                     f"client_port={self.sink_rtp_port}-{self.sink_rtcp_port};"
                     f"server_port={source_port}-{source_port + 1}"
                 )
             else:
                 transport = (
                     "RTP/AVP/UDP;unicast;"
+                    f"{address_attributes}"
                     f"client_port={self.sink_rtp_port};"
                     f"server_port={source_port}"
                 )
diff --git a/tests/test_wfd_rtsp_limits.py b/tests/test_wfd_rtsp_limits.py
index d4c12e5..32d999d 100644
--- a/tests/test_wfd_rtsp_limits.py
+++ b/tests/test_wfd_rtsp_limits.py
@@ -147,6 +147,31 @@ class RTSPSetupResponseTest(unittest.TestCase):
         )
         self.assertNotIn("Content-Length", response)
 
+    def test_setup_transport_identifies_verified_sink_and_local_source(self):
+        handler = _WFDRTSPHandler.__new__(_WFDRTSPHandler)
+        handler._client_ip = "192.168.49.1"
+        handler.local_ip = "192.168.49.20"
+        handler.sink_rtp_port = 19000
+        handler.sink_rtcp_port = 19001
+        handler.source_rtp_port = 19002
+        handler.server = mock.Mock(media_config=mock.Mock(source_port=19002))
+        handler._send_setup_response = mock.Mock()
+        request = mock.Mock(
+            method="SETUP",
+            headers={"transport": "RTP/AVP/UDP;unicast;client_port=19000-19001"},
+        )
+
+        with mock.patch("wfd.rtsp.handler._safe_source_port", return_value=19002):
+            handler._handle_request(request)
+
+        transport = handler._send_setup_response.call_args.args[1]
+        self.assertEqual(
+            transport,
+            "RTP/AVP/UDP;unicast;destination=192.168.49.1;"
+            "source=192.168.49.20;client_port=19000-19001;"
+            "server_port=19002-19003",
+        )
+
     def test_rtsp_date_is_always_utc(self):
         self.assertEqual(_rtsp_date(0), "Thu, 01 Jan 1970 00:00:00 +0000")
 
