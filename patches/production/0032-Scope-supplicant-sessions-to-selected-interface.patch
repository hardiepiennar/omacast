-def _wait_for_supplicant_group(timeout: float = 45.0) -> SupplicantGroup:
+def _selected_peer_groups(peer_path: str, *, required: bool = False) -> frozenset[str]:
+    raw = _wpa_property(peer_path, WPA_PEER, "Groups")
+    groups = frozenset(_object_paths(raw))
+    if required and not raw:
+        raise WFDNotReady("Could not establish the selected receiver's P2P group baseline.")
+    return groups
+
+
+def _physical_interface_name(interface: str) -> str:
+    return interface.removeprefix("p2p-dev-")
+
+
+def _group_belongs_to_interface(group: SupplicantGroup, interface: str) -> bool:
+    physical = _physical_interface_name(interface)
+    return group.ifname == physical or group.ifname.startswith(f"p2p-{physical}-")
+
+
+def _wait_for_supplicant_group(
+    interface: str,
+    peer_path: str,
+    baseline_groups: frozenset[str],
+    timeout: float = 45.0,
+) -> SupplicantGroup:
     print("[FluxCast WFD] Waiting for direct supplicant P2P group...")
     deadline = time.monotonic() + timeout
     while time.monotonic() < deadline:
+        new_peer_groups = _selected_peer_groups(peer_path) - baseline_groups
         interfaces_raw = _wpa_property(WPA_ROOT, WPA_DEST, "Interfaces")
+        candidates: dict[str, SupplicantGroup] = {}
         for interface_path in _object_paths(interfaces_raw):
             try:
                 group = _group_from_interface(interface_path)
             except Exception:
                 group = None
-            if group:
-                print(
-                    f"[FluxCast WFD] Direct P2P group: role={group.role or 'unknown'}, "
-                    f"interface={group.ifname or group.interface_path}."
-                )
-                return group
+            if (
+                group
+                and group.group_path in new_peer_groups
+                and _group_belongs_to_interface(group, interface)
+            ):
+                candidates[group.group_path] = group
+        if len(candidates) > 1:
+            raise WFDNotReady(
+                "Selected receiver joined multiple new P2P groups; "
+                "refusing ambiguous ownership."
+            )
+        if candidates:
+            group = next(iter(candidates.values()))
+            print(
+                f"[FluxCast WFD] Direct P2P group: role={group.role or 'unknown'}, "
+                f"interface={group.ifname or group.interface_path}."
+            )
+            return group
         time.sleep(0.5)
     raise WFDNotReady("Timed out waiting for a direct supplicant P2P group.")
 
 
