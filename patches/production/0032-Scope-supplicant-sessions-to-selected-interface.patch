+        return []
+    physical = selected.removeprefix("p2p-dev-")
+    p2p_dev = f"p2p-dev-{physical}"
+    matches: list[tuple[int, str]] = []
+    for path in iface_paths:
+        try:
+            result = _gdbus_call([
+                "--dest", wpa_dest,
