diff --git a/tests/test_wfd_p2p_ownership.py b/tests/test_wfd_p2p_ownership.py
new file mode 100644
index 0000000..9db33f1
--- /dev/null
+++ b/tests/test_wfd_p2p_ownership.py
@@ -0,0 +1,176 @@
+import subprocess
+import unittest
+from types import SimpleNamespace
+from unittest import mock
+
+from wfd.config import WFDNotReady
+from wfd.ie import WFDPeer
+from wfd.p2p.device import _p2p_device_iface_paths
+from wfd.p2p.supplicant import (
+    SupplicantGroup,
+    _selected_peer_groups,
+    _supplicant_cancel_and_disconnect,
+    _wait_for_supplicant_group,
+)
+
+
+def _result(stdout="", returncode=0):
+    return subprocess.CompletedProcess([], returncode, stdout=stdout, stderr="")
+
+
+class SelectedSupplicantInterfaceTest(unittest.TestCase):
+    def test_only_exact_selected_adapter_paths_are_returned(self):
+        ifnames = {
+            "/wlan0": "wlan0",
+            "/p2p0": "p2p-dev-wlan0",
+            "/wlan1": "wlan1",
+            "/p2p1": "p2p-dev-wlan1",
+            "/group0": "p2p-wlan0-0",
+        }
+
+        def call(args, timeout=3.0):
+            path = args[args.index("--object-path") + 1]
+            if path == "/fi/w1/wpa_supplicant1":
+                return _result("(" + ", ".join(f"objectpath '{item}'" for item in ifnames) + ",)")
+            return _result(f"(<'{ifnames[path]}'>,)")
+
+        with mock.patch("wfd.p2p.device._gdbus_call", side_effect=call):
+            self.assertEqual(_p2p_device_iface_paths("wlan0"), ["/p2p0", "/wlan0"])
+            self.assertEqual(
+                _p2p_device_iface_paths("p2p-dev-wlan0"), ["/p2p0", "/wlan0"]
+            )
+
+    def test_missing_selected_adapter_does_not_fall_back_to_another_radio(self):
+        def call(args, timeout=3.0):
+            path = args[args.index("--object-path") + 1]
+            if path == "/fi/w1/wpa_supplicant1":
+                return _result("([objectpath '/wlan1'],)")
+            return _result("(<'wlan1'>,)")
+
+        with mock.patch("wfd.p2p.device._gdbus_call", side_effect=call):
+            self.assertEqual(_p2p_device_iface_paths("wlan0"), [])
+
+
+class SupplicantGroupOwnershipTest(unittest.TestCase):
+    def test_group_baseline_fails_closed_when_peer_property_is_unavailable(self):
+        with mock.patch("wfd.p2p.supplicant._wpa_property", return_value=""):
+            with self.assertRaisesRegex(WFDNotReady, "group baseline"):
+                _selected_peer_groups("/peer", required=True)
+
+        with mock.patch(
+            "wfd.p2p.supplicant._wpa_property", return_value="(@ao [],)"
+        ):
+            self.assertEqual(
+                _selected_peer_groups("/peer", required=True), frozenset()
+            )
+
+    def test_wait_ignores_preexisting_and_foreign_adapter_groups(self):
+        groups = {
+            "/old-iface": SupplicantGroup("/old", "/old-iface", "p2p-wlan0-0", "client"),
+            "/foreign-iface": SupplicantGroup(
+                "/foreign", "/foreign-iface", "p2p-wlan1-0", "client"
+            ),
+            "/owned-iface": SupplicantGroup(
+                "/owned", "/owned-iface", "p2p-wlan0-1", "client"
+            ),
+            "/unrelated-iface": SupplicantGroup(
+                "/unrelated", "/unrelated-iface", "p2p-wlan0-2", "client"
+            ),
+        }
+
+        def prop(path, interface, name):
+            if path == "/peer" and name == "Groups":
+                return "([objectpath '/old', '/foreign', '/owned'],)"
+            if name == "Interfaces":
+                return "(" + ", ".join(f"objectpath '{item}'" for item in groups) + ",)"
+            return ""
+
+        with mock.patch("wfd.p2p.supplicant._wpa_property", side_effect=prop), mock.patch(
+            "wfd.p2p.supplicant._group_from_interface",
+            side_effect=lambda path: groups[path],
+        ), mock.patch("wfd.p2p.supplicant.time.monotonic", side_effect=[0.0, 0.0]):
+            group = _wait_for_supplicant_group(
+                "wlan0", "/peer", frozenset({"/old"}), timeout=1.0
+            )
+
+        self.assertEqual(group.group_path, "/owned")
+
+    def test_wait_fails_closed_when_two_new_owned_groups_are_attributable(self):
+        groups = {
+            "/one-iface": SupplicantGroup("/one", "/one-iface", "p2p-wlan0-0", "client"),
+            "/two-iface": SupplicantGroup("/two", "/two-iface", "p2p-wlan0-1", "client"),
+        }
+
+        def prop(path, interface, name):
+            if path == "/peer" and name == "Groups":
+                return "([objectpath '/one', '/two'],)"
+            if name == "Interfaces":
+                return "([objectpath '/one-iface', '/two-iface'],)"
+            return ""
+
+        with mock.patch("wfd.p2p.supplicant._wpa_property", side_effect=prop), mock.patch(
+            "wfd.p2p.supplicant._group_from_interface",
+            side_effect=lambda path: groups[path],
+        ), mock.patch("wfd.p2p.supplicant.time.monotonic", side_effect=[0.0, 0.0]):
+            with self.assertRaisesRegex(WFDNotReady, "ambiguous ownership"):
+                _wait_for_supplicant_group(
+                    "wlan0", "/peer", frozenset(), timeout=1.0
+                )
+
+    def test_cleanup_calls_only_the_recorded_control_path(self):
+        with mock.patch("wfd.p2p.supplicant._gdbus_call", return_value=_result()) as call:
+            _supplicant_cancel_and_disconnect("/owned-control")
+
+        control_calls = [
+            entry.args[0]
+            for entry in call.call_args_list
+            if "--object-path" in entry.args[0]
+            and entry.args[0][entry.args[0].index("--object-path") + 1]
+            != "/fi/w1/wpa_supplicant1"
+        ]
+        self.assertEqual(len(control_calls), 2)
+        self.assertTrue(all("/owned-control" in args for args in control_calls))
+
+
+class SupplicantSessionCleanupTest(unittest.TestCase):
+    def test_failed_connection_cleans_only_the_preselected_control_path(self):
+        args = SimpleNamespace(
+            wfd_no_firewall=True,
+            wfd_test_pattern=True,
+            wfd_dry_run=False,
+            wfd_interface="wlan0",
+            wfd_timeout=1,
+            wfd_p2p_backend="supplicant",
+            fps=60,
+            bitrate="4M",
+            output_res="1280x720",
+        )
+        report = SimpleNamespace(wfd_candidate=True)
+        peer = WFDPeer(address="00:11:22:33:44:55", name="TV")
+        rtsp = mock.Mock()
+
+        with mock.patch("wfd.session.run_diagnostics", return_value=report), mock.patch(
+            "wfd.session.print_report"
+        ), mock.patch("wfd.session._set_p2p_device_name"), mock.patch(
+            "wfd.session._scan_and_select", return_value=peer
+        ), mock.patch(
+            "wfd.session._supplicant_interface_path", return_value="/owned-control"
+        ), mock.patch(
+            "wfd.session.WFDRTSPServer", return_value=rtsp
+        ), mock.patch(
+            "wfd.session.connect_supplicant_group",
+            side_effect=WFDNotReady("connect failed"),
+        ) as connect, mock.patch(
+            "wfd.session._supplicant_cancel_and_disconnect"
+        ) as cleanup, mock.patch("wfd.session.report_ts_dump"):
+            with self.assertRaisesRegex(WFDNotReady, "connect failed"):
+                from wfd.session import start_experimental_backend
+
+                start_experimental_backend(args)
+
+        connect.assert_called_once_with(args, peer, "/owned-control")
+        cleanup.assert_called_once_with("/owned-control")
+
+
+if __name__ == "__main__":
+    unittest.main()
