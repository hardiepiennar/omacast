+        except Exception:
+            continue
+        match = (
+            re.search(r"<['\"]([^'\"]+)['\"]>", result.stdout)
+            if result.returncode == 0 else None
+        )
         ifname = match.group(1) if match else ""
         if ifname == p2p_dev:
-            return 0
-        if ifname == physical:
-            return 1
-        return 2
-
-    return sorted(iface_paths, key=_priority)
+            matches.append((0, path))
+        elif ifname == physical:
+            matches.append((1, path))
