index 0000000..f313baa
--- /dev/null
+++ b/tests/test_wfd_rtp_pacer.py
@@ -0,0 +1,161 @@
+import socket
+import struct
+import time
+import unittest
+
+from wfd.media.rtp_pacer import RTPPacer, _bind_loopback_pair
+
+
+def _available_pair() -> int:
+    sockets = _bind_loopback_pair()
+    try:
+        return sockets[0].getsockname()[1]
+    finally:
+        for sock in sockets:
+            sock.close()
+
+
+def _input_port(pacer: RTPPacer) -> int:
+    return int(pacer.input_url.split(":", 2)[2].split("?", 1)[0])
+
+
+def _rtp(sequence: int, size: int = 1328) -> bytes:
+    header = struct.pack("!BBHII", 0x80, 33, sequence, 0, 1)
+    return header + bytes(size - len(header))
+
+
+class RTPPacerTest(unittest.TestCase):
+    def test_paces_rtp_without_loss_and_preserves_source_port(self):
+        receivers = _bind_loopback_pair()
+        source_port = _available_pair()
+        pacer = RTPPacer(
