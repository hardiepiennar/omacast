diff --git a/src/wfd/media/rtp_pacer.py b/src/wfd/media/rtp_pacer.py
new file mode 100644
index 0000000..639c7bc
--- /dev/null
+++ b/src/wfd/media/rtp_pacer.py
@@ -0,0 +1,236 @@
+import ipaddress
+import socket
+import threading
+import time
+from typing import Optional
+
+
+_MAX_RTP_DATAGRAM = 1328
+_MAX_RTCP_DATAGRAM = 1500
+_RECEIVE_BUFFER_BYTES = 1 << 20
+_SOCKET_TIMEOUT_SECONDS = 0.1
+_THREAD_JOIN_SECONDS = 1.0
+_INPUT_PAIR_ATTEMPTS = 32
+
+
+class RTPPacer:
+    """Bounded loopback relay for paced WFD RTP and immediate RTCP."""
+
+    def __init__(
+        self,
+        *,
+        remote_ip: str,
+        remote_rtp_port: int,
+        local_ip: str,
+        local_rtp_port: int,
+        bitrate: int,
+        burst_packets: int = 4,
+    ) -> None:
+        self.remote_ip = _ipv4(remote_ip, "receiver")
+        self.local_ip = _ipv4(local_ip, "local")
+        self.remote_rtp_port = _port(remote_rtp_port, "receiver RTP")
+        self.local_rtp_port = _port(local_rtp_port, "source RTP")
+        if self.remote_rtp_port == 65535 or self.local_rtp_port == 65535:
+            raise ValueError("RTP ports must leave room for the adjacent RTCP port")
+        if type(bitrate) is not int or bitrate <= 0 or bitrate > 1_000_000_000:
+            raise ValueError("RTP pacing bitrate is outside the supported range")
+        if type(burst_packets) is not int or not 1 <= burst_packets <= 64:
+            raise ValueError("RTP burst packet count is outside the supported range")
+
+        self.bitrate = bitrate
+        self.burst_bits = burst_packets * _MAX_RTP_DATAGRAM * 8
+        self._stop = threading.Event()
+        self._lock = threading.Lock()
+        self._error: Optional[str] = None
+        self._sent_rtp = 0
+        self._sent_rtcp = 0
+        self._dropped = 0
+        self._inputs: list[socket.socket] = []
+        self._outputs: list[socket.socket] = []
+        self._threads: list[threading.Thread] = []
+        self._input_rtp_port: Optional[int] = None
+
+    @property
+    def input_url(self) -> str:
+        if self._input_rtp_port is None:
+            raise RuntimeError("RTP pacer has not started")
+        return (
+            f"rtp://127.0.0.1:{self._input_rtp_port}"
+            "?localaddr=127.0.0.1&pkt_size=1328"
+        )
+
+    def start(self) -> None:
+        if self._threads:
+            return
+        inputs: list[socket.socket] = []
+        outputs: list[socket.socket] = []
+        try:
+            inputs = _bind_loopback_pair()
+            outputs = [socket.socket(socket.AF_INET, socket.SOCK_DGRAM) for _ in range(2)]
+            for sock in (*inputs, *outputs):
+                sock.settimeout(_SOCKET_TIMEOUT_SECONDS)
+            for sock in inputs:
+                sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, _RECEIVE_BUFFER_BYTES)
+
+            outputs[0].bind((self.local_ip, self.local_rtp_port))
+            outputs[1].bind((self.local_ip, self.local_rtp_port + 1))
+            outputs[0].connect((self.remote_ip, self.remote_rtp_port))
+            outputs[1].connect((self.remote_ip, self.remote_rtp_port + 1))
+
+            self._inputs = inputs
+            self._outputs = outputs
+            self._input_rtp_port = inputs[0].getsockname()[1]
+            self._stop.clear()
+            with self._lock:
+                self._error = None
+            self._threads = [
+                threading.Thread(target=self._pace_rtp, name="wfd-rtp-pacer", daemon=True),
+                threading.Thread(target=self._forward_rtcp, name="wfd-rtcp-relay", daemon=True),
+            ]
+            for thread in self._threads:
+                thread.start()
+        except BaseException:
+            self._stop.set()
+            for sock in (*inputs, *outputs):
+                sock.close()
+            for thread in self._threads:
+                if thread.is_alive():
+                    thread.join(timeout=_THREAD_JOIN_SECONDS)
+            self._inputs = []
+            self._outputs = []
+            self._threads = []
+            self._input_rtp_port = None
+            raise
+
+    def stop(self) -> None:
+        self._stop.set()
+        for sock in self._inputs:
+            sock.close()
+        for thread in self._threads:
+            thread.join(timeout=_THREAD_JOIN_SECONDS)
+        if any(thread.is_alive() for thread in self._threads):
+            self._fail("stop-timeout")
+        self._threads = []
+        for sock in self._outputs:
+            sock.close()
+        self._inputs = []
+        self._outputs = []
+        self._input_rtp_port = None
+
+    def healthy(self) -> bool:
+        with self._lock:
+            error = self._error
+        return bool(self._threads) and error is None and all(t.is_alive() for t in self._threads)
+
+    def summary(self) -> str:
+        with self._lock:
+            error = self._error
+            rtp, rtcp, dropped = self._sent_rtp, self._sent_rtcp, self._dropped
+        state = f"error={error}" if error else "running"
+        return f"pacer={state},rtp={rtp},rtcp={rtcp},dropped={dropped}"
+
+    def _pace_rtp(self) -> None:
+        tokens = float(self.burst_bits)
+        previous = time.monotonic()
+        try:
+            while not self._stop.is_set():
+                packet = self._receive(self._inputs[0], _MAX_RTP_DATAGRAM)
+                if packet is None:
+                    continue
+                if len(packet) < 12 or packet[0] >> 6 != 2 or packet[1] & 0x7f != 33:
+                    self._count_drop()
+                    continue
+
+                packet_bits = len(packet) * 8
+                while not self._stop.is_set():
+                    now = time.monotonic()
+                    tokens = min(
+                        float(self.burst_bits),
+                        tokens + (now - previous) * self.bitrate,
+                    )
+                    previous = now
+                    if tokens >= packet_bits:
+                        break
+                    self._stop.wait(min((packet_bits - tokens) / self.bitrate, 0.05))
+                if self._stop.is_set():
+                    break
+                self._outputs[0].send(packet)
+                tokens -= packet_bits
+                with self._lock:
+                    self._sent_rtp += 1
+        except OSError as exc:
+            if not self._stop.is_set():
+                self._fail(f"rtp:{exc.errno}")
+
+    def _forward_rtcp(self) -> None:
+        try:
+            while not self._stop.is_set():
+                packet = self._receive(self._inputs[1], _MAX_RTCP_DATAGRAM)
+                if packet is None:
+                    continue
+                if len(packet) < 4 or packet[0] >> 6 != 2 or not 192 <= packet[1] <= 223:
+                    self._count_drop()
+                    continue
+                self._outputs[1].send(packet)
+                with self._lock:
+                    self._sent_rtcp += 1
+        except OSError as exc:
+            if not self._stop.is_set():
+                self._fail(f"rtcp:{exc.errno}")
+
+    def _receive(self, sock: socket.socket, maximum: int) -> Optional[bytes]:
+        try:
+            packet = sock.recv(maximum + 1)
+        except socket.timeout:
+            return None
+        if len(packet) > maximum:
+            self._count_drop()
+            return None
+        return packet
+
+    def _count_drop(self) -> None:
+        with self._lock:
+            self._dropped += 1
+
+    def _fail(self, message: str) -> None:
+        with self._lock:
+            self._error = message
+        self._stop.set()
+
+
+def _bind_loopback_pair() -> list[socket.socket]:
+    for _ in range(_INPUT_PAIR_ATTEMPTS):
+        rtp = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        rtcp = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        success = False
+        try:
+            rtp.bind(("127.0.0.1", 0))
+            port = rtp.getsockname()[1]
+            if port == 65535:
+                continue
+            rtcp.bind(("127.0.0.1", port + 1))
+            success = True
+            return [rtp, rtcp]
+        except OSError:
+            pass
+        finally:
+            if not success:
+                rtp.close()
+                rtcp.close()
+    raise OSError("could not allocate an adjacent loopback RTP/RTCP port pair")
+
+
+def _ipv4(value: str, label: str) -> str:
+    try:
+        address = ipaddress.ip_address(value)
+    except ValueError as exc:
+        raise ValueError(f"invalid {label} IPv4 address") from exc
+    if address.version != 4:
+        raise ValueError(f"invalid {label} IPv4 address")
+    return str(address)
+
+
+def _port(value: int, label: str) -> int:
+    if type(value) is not int or not 1 <= value <= 65535:
+        raise ValueError(f"invalid {label} port")
+    return value
