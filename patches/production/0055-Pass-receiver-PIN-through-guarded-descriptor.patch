+    wfd.add_argument("--wfd-pairing-pin-fd", type=int, default=None,
+                     dest="wfd_pairing_pin_fd", metavar="FD")
     return parser.parse_args()
 
 
@@ -105,6 +107,16 @@ def _validate_omacast_session(args: argparse.Namespace) -> None:
         raise WFDNotReady("The P2P frequency is outside the supported range.")
     if not 1 <= args.wfd_supplicant_hold <= 75:
         raise WFDNotReady("The P2P group timeout is outside the supported range.")
+    if args.wfd_pairing_pin_fd is not None:
+        if type(args.wfd_pairing_pin_fd) is not int or args.wfd_pairing_pin_fd <= 2:
+            raise WFDNotReady("The pairing PIN descriptor is invalid.")
+        try:
+            metadata = os.fstat(args.wfd_pairing_pin_fd)
+        except OSError as exc:
+            raise WFDNotReady("The pairing PIN descriptor is unavailable.") from exc
+        import stat
+        if not stat.S_ISFIFO(metadata.st_mode) or metadata.st_uid != os.getuid():
+            raise WFDNotReady("The pairing PIN descriptor is unsafe.")
 
 
 def main() -> None:
@@ -113,7 +125,7 @@ def main() -> None:
         print(json.dumps({
             "schemaVersion": 1,
             "kind": "omacast-engine-contract",
-            "apiRevision": 2,
