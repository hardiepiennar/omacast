diff --git a/tests/test_wfd_p2p_broker.py b/tests/test_wfd_p2p_broker.py
index f6b5315..51fddfc 100644
--- a/tests/test_wfd_p2p_broker.py
+++ b/tests/test_wfd_p2p_broker.py
@@ -1,4 +1,5 @@
 import json
+import os
 import stat
 import unittest
 from types import SimpleNamespace
@@ -58,6 +59,32 @@ class SupplicantBrokerClientTest(unittest.TestCase):
         self.assertEqual(client.path, BROKER)
         self.assertEqual(json.loads(client.sent), {"schemaVersion": 1, "op": "cleanup"})
 
+    def test_receiver_pin_is_read_from_a_pipe_and_never_an_argument(self):
+        response = json.dumps({
+            "schemaVersion": 1, "kind": "omarchy-cast-supplicant-response",
+            "ok": True, "result": {"group": {"interface": "p2p-wlan0-0", "role": "client"}},
+            "error": None,
+        }).encode() + b"\n"
+        read_fd, write_fd = os.pipe()
+        os.write(write_fd, b"12345670")
+        os.close(write_fd)
+        client = _Socket(response)
+        with mock.patch("wfd.p2p.broker.os.stat", return_value=self.metadata()), mock.patch(
+            "wfd.p2p.broker.os.getuid", return_value=1000
+        ), mock.patch("wfd.p2p.broker.socket.socket", return_value=client):
+            broker_request(BROKER, "connect", timeout=1, pairing_pin_fd=read_fd)
+        self.assertEqual(json.loads(client.sent), {
+            "schemaVersion": 1, "op": "connect", "pin": "12345670",
+        })
+
+    def test_pairing_pin_rejects_bad_checksum_and_cleanup_use(self):
+        for pin, operation in ((b"12345671", "connect"), (b"12345670", "cleanup")):
+            read_fd, write_fd = os.pipe()
+            os.write(write_fd, pin)
+            os.close(write_fd)
+            with self.subTest(pin=pin, operation=operation), self.assertRaises(WFDNotReady):
+                broker_request(BROKER, operation, timeout=1, pairing_pin_fd=read_fd)
+
     def test_client_rejects_paths_socket_metadata_and_response_shapes(self):
         with self.assertRaisesRegex(WFDNotReady, "outside the guarded session"):
             broker_request("/tmp/broker", "connect", timeout=1)
@@ -129,7 +156,7 @@ class SupplicantBrokerClientTest(unittest.TestCase):
             return_value={"group": {"interface": "p2p-wlan0-0", "role": "client"}},
         ) as request, mock.patch("wfd.p2p.supplicant._supplicant_interface_path") as direct:
             group = connect_supplicant_group(args, WFDPeer(address="00:11:22:33:44:55"))
-        request.assert_called_once_with(BROKER, "connect", timeout=50.0)
+        request.assert_called_once_with(BROKER, "connect", timeout=50.0, pairing_pin_fd=None)
         direct.assert_not_called()
         self.assertEqual((group.ifname, group.role), ("p2p-wlan0-0", "client"))
 
