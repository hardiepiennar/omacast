+            "pairing": {"receiverPinDescriptor": True},
         }, sort_keys=True, separators=(",", ":")))
         return
     if args.doctor or args.doctor_json:
diff --git a/src/wfd/p2p/broker.py b/src/wfd/p2p/broker.py
index 0fdfbe6..cc247cd 100644
--- a/src/wfd/p2p/broker.py
+++ b/src/wfd/p2p/broker.py
@@ -10,9 +10,42 @@ from ..config import WFDNotReady
 
 _BROKER_PATH = re.compile(r"^/run/omarchy-cast/[a-f0-9]{32}/supplicant\.sock$")
 _INTERFACE = re.compile(r"^[A-Za-z0-9_.-]{1,64}$")
+_PIN = re.compile(r"^[0-9]{8}$")
 
 
-def broker_request(path: str, operation: str, *, timeout: float) -> dict:
+def _pin_checksum(pin: str) -> int:
+    accumulator = 0
+    value = int(pin[:7])
+    while value:
+        accumulator += 3 * (value % 10)
+        value //= 10
+        accumulator += value % 10
+        value //= 10
+    return (10 - accumulator % 10) % 10
+
+
+def _read_pairing_pin(descriptor: int | None) -> str | None:
+    if descriptor is None:
+        return None
+    try:
+        encoded = os.read(descriptor, 9)
+    except OSError as exc:
+        raise WFDNotReady("The pairing PIN could not be read.") from exc
+    finally:
+        try:
+            os.close(descriptor)
+        except OSError:
+            pass
+    try:
+        pin = encoded.decode("ascii")
+    except UnicodeDecodeError as exc:
+        raise WFDNotReady("The pairing PIN is invalid.") from exc
+    if not _PIN.fullmatch(pin) or _pin_checksum(pin) != int(pin[7]):
+        raise WFDNotReady("The pairing PIN is invalid.")
+    return pin
+
+
+def broker_request(path: str, operation: str, *, timeout: float, pairing_pin_fd: int | None = None) -> dict:
     if operation not in {"connect", "cleanup"}:
         raise WFDNotReady("The supplicant broker operation is unsupported.")
     if not _BROKER_PATH.fullmatch(path):
@@ -27,9 +60,13 @@ def broker_request(path: str, operation: str, *, timeout: float) -> dict:
         or stat.S_IMODE(metadata.st_mode) != 0o600
     ):
         raise WFDNotReady("The supplicant broker socket is unsafe.")
-    request = json.dumps(
-        {"schemaVersion": 1, "op": operation}, separators=(",", ":")
-    ).encode("utf-8") + b"\n"
+    pairing_pin = _read_pairing_pin(pairing_pin_fd)
+    if pairing_pin is not None and operation != "connect":
+        raise WFDNotReady("A pairing PIN is accepted only for connection setup.")
+    request_payload = {"schemaVersion": 1, "op": operation}
+    if pairing_pin is not None:
+        request_payload["pin"] = pairing_pin
+    request = json.dumps(request_payload, separators=(",", ":")).encode("utf-8") + b"\n"
     response = bytearray()
     try:
         with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
