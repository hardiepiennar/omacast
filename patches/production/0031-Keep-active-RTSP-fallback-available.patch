+            self.server.release_client("192.168.49.1", claim)
+            self.assertFalse(self.server.has_connected_client)
+            self.assertIsNotNone(self.server.claim_client("192.168.49.1"))
         self.assertEqual(verify.call_count, 3)
 
+    def test_active_probe_can_supersede_only_an_unconfirmed_claim(self):
+        with mock.patch("wfd.rtsp.rtsp_server._is_expected_peer_ip", return_value=True):
+            passive = self.server.claim_client("192.168.49.1")
+            active = self.server.claim_client(
+                "192.168.49.1", replace_unconfirmed=True
+            )
+        self.assertIsNotNone(passive)
+        self.assertIsNotNone(active)
+        assert passive is not None and active is not None
+        self.assertNotEqual(passive, active)
+        self.assertFalse(self.server.confirm_client("192.168.49.1", passive))
+        self.server.release_client("192.168.49.1", passive)
+        self.assertTrue(self.server.confirm_client("192.168.49.1", active))
+        self.assertTrue(self.server.has_connected_client)
+        self.server.release_client("192.168.49.1", passive)
+        self.assertTrue(self.server.has_connected_client)
+        with mock.patch("wfd.rtsp.rtsp_server._is_expected_peer_ip", return_value=True):
+            self.assertIsNone(
+                self.server.claim_client("192.168.49.1", replace_unconfirmed=True)
+            )
+
 
