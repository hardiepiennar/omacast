 RTSP_MAX_HEADER_BYTES = 64 * 1024
 RTSP_MAX_HEADERS = 64
 RTSP_MAX_BODY_BYTES = 64 * 1024
+WFD_NEGOTIATION_METHODS = frozenset(
+    {"OPTIONS", "GET_PARAMETER", "SET_PARAMETER", "SETUP", "PLAY", "TEARDOWN"}
