             self.assertFalse(self.server.has_connected_client)
-            self.assertTrue(self.server.claim_client("192.168.49.1"))
+            self.assertTrue(self.server.confirm_client("192.168.49.1", claim))
+            self.assertTrue(self.server.has_connected_client)
+            self.server.release_client("192.168.49.2", claim)
