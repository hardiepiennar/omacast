+++ b/src/wfd/media/wlroots.py
@@ -13,6 +13,20 @@ from ..net import _ffmpeg_sender_args
 from ..progress import _start_ffmpeg_progress_drain
 
 
+def _stop_startup_process(proc: subprocess.Popen[bytes]) -> None:
+    """Best-effort bounded cleanup without hiding the startup failure."""
+    try:
+        if proc.poll() is None:
+            proc.terminate()
+        try:
+            proc.wait(timeout=2)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+            proc.wait(timeout=1)
+    except (OSError, subprocess.SubprocessError):
+        pass
+
