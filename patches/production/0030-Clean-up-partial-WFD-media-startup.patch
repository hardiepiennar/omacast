index 0000000..6ba29d1
--- /dev/null
+++ b/tests/test_wfd_media_startup_cleanup.py
@@ -0,0 +1,141 @@
+import io
+import subprocess
+import unittest
+from types import SimpleNamespace
+from unittest import mock
+
+from wfd.config import WFDMediaConfig, WFDNotReady
+from wfd.media.pipeline import WFDMediaPipeline
+
+
+class _Process:
+    def __init__(self, *, stdout=False, running=True, ignore_terminate=False):
+        self.stdout = io.BytesIO() if stdout else None
+        self.stderr = None
+        self.running = running
+        self.ignore_terminate = ignore_terminate
+        self.terminate_calls = 0
+        self.kill_calls = 0
+        self.wait_timeouts = []
+
+    def poll(self):
+        return None if self.running else 1
+
+    def terminate(self):
+        self.terminate_calls += 1
+        if not self.ignore_terminate:
+            self.running = False
+
+    def kill(self):
+        self.kill_calls += 1
+        self.running = False
+
+    def wait(self, timeout=None):
+        self.wait_timeouts.append(timeout)
+        if self.running:
+            raise subprocess.TimeoutExpired("process", timeout)
+        return 0
+
+
+def _pipeline():
+    config = WFDMediaConfig(
+        monitor=SimpleNamespace(name="eDP-1", width=1920, height=1080),
+        output_resolution="1280x720",
+        fps=60,
+        bitrate="5M",
+        no_audio=True,
+        capture_backend="wf-recorder",
+    )
+    return WFDMediaPipeline(
+        config,
+        tv_ip="192.168.49.2",
+        local_ip="192.168.49.1",
+        sink_rtp_port=19000,
+    )
+
+
+class WlrootsStartupCleanupTest(unittest.TestCase):
+    def _start(self, pipeline, popen):
+        responses = iter(popen)
+
+        def next_process(*_args, **_kwargs):
+            response = next(responses)
+            if isinstance(response, BaseException):
+                raise response
+            return response
+
+        with mock.patch(
+            "wfd.media.wlroots.shutil.which", return_value="/usr/bin/gpu-screen-recorder"
+        ), mock.patch(
+            "wfd.media.wlroots._detect_audio_monitor", return_value="monitor"
+        ), mock.patch("wfd.media.wlroots.subprocess.Popen", side_effect=next_process), mock.patch(
+            "wfd.media.wlroots.time.sleep"
+        ):
+            pipeline._start_desktop_wf_recorder()
+
+    def test_ffmpeg_spawn_failure_reaps_capture_and_preserves_error(self):
+        pipeline = _pipeline()
+        capture = _Process(stdout=True)
+
+        with self.assertRaisesRegex(OSError, "ffmpeg spawn failed"):
+            self._start(pipeline, [capture, OSError("ffmpeg spawn failed")])
+
+        self.assertTrue(capture.stdout.closed)
+        self.assertEqual(capture.terminate_calls, 1)
+        self.assertEqual(capture.wait_timeouts, [2])
+        self.assertEqual(pipeline.processes, [])
+
+    def test_immediate_capture_exit_reaps_both_children(self):
+        pipeline = _pipeline()
+        capture = _Process(stdout=True, running=False)
+        ffmpeg = _Process()
+
+        with self.assertRaisesRegex(WFDNotReady, "gpu-screen-recorder exited immediately"):
+            self._start(pipeline, [capture, ffmpeg])
+
+        self.assertEqual(ffmpeg.terminate_calls, 1)
+        self.assertEqual(ffmpeg.wait_timeouts, [2])
+        self.assertEqual(capture.terminate_calls, 0)
+        self.assertEqual(capture.wait_timeouts, [2])
+        self.assertEqual(pipeline.processes, [])
+
+    def test_immediate_ffmpeg_exit_reaps_both_children(self):
+        pipeline = _pipeline()
+        capture = _Process(stdout=True)
+        ffmpeg = _Process(running=False)
+
+        with self.assertRaisesRegex(WFDNotReady, "ffmpeg exited immediately"):
+            self._start(pipeline, [capture, ffmpeg])
+
+        self.assertEqual(capture.terminate_calls, 1)
+        self.assertEqual(capture.wait_timeouts, [2])
+        self.assertEqual(ffmpeg.terminate_calls, 0)
+        self.assertEqual(ffmpeg.wait_timeouts, [2])
+        self.assertEqual(pipeline.processes, [])
+
+    def test_cleanup_kills_child_that_ignores_termination(self):
+        pipeline = _pipeline()
+        capture = _Process(stdout=True, ignore_terminate=True)
+
+        with self.assertRaises(OSError):
+            self._start(pipeline, [capture, OSError("ffmpeg spawn failed")])
+
+        self.assertEqual(capture.terminate_calls, 1)
+        self.assertEqual(capture.kill_calls, 1)
+        self.assertEqual(capture.wait_timeouts, [2, 1])
+        self.assertEqual(pipeline.processes, [])
+
+    def test_success_publishes_processes_without_stopping_them(self):
+        pipeline = _pipeline()
+        capture = _Process(stdout=True)
+        ffmpeg = _Process()
+
+        self._start(pipeline, [capture, ffmpeg])
+
+        self.assertEqual(pipeline.processes, [capture, ffmpeg])
+        self.assertEqual(capture.terminate_calls, 0)
+        self.assertEqual(ffmpeg.terminate_calls, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
