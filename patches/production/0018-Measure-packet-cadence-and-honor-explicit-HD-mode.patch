         capture_backend=getattr(args, "wfd_capture_backend", "auto"),
         video_encoder=getattr(args, "wfd_video_encoder", "auto"),
         peer_name=peer.name,
@@ -131,6 +132,8 @@ def start_experimental_backend(args) -> None:
         print(f"[FluxCast WFD] Latency log file: {media_config.latency_log_path}")
     if media_config.progress_log_path:
         print(f"[FluxCast WFD] Progress log file: {media_config.progress_log_path}")
+    if media_config.packet_log_path:
+        print(f"[FluxCast WFD] Packet timing log enabled")
 
     rtsp_port = getattr(args, "wfd_rtsp_port", WFD_RTSP_PORT)
     rtsp = WFDRTSPServer(
diff --git a/tests/test_wfd.py b/tests/test_wfd.py
index 325ed09..5a8822c 100644
--- a/tests/test_wfd.py
+++ b/tests/test_wfd.py
@@ -94,6 +94,14 @@ class VideoModeTableTest(unittest.TestCase):
 
         self.assertEqual(wfd._choose_cea_mode(config, sink).name, "640x480p60")
 
+    def test_explicit_1080p_is_not_silently_downgraded_to_advertised_720p(self):
+        config = wfd.WFDMediaConfig(monitor=None, output_resolution="1920x1080", fps=30)
+        sink = wfd.WFDVideoFormat(
