 src/wfd/session.py       |  3 +++
 tests/test_wfd.py        | 13 +++++++++++++
 6 files changed, 51 insertions(+)

diff --git a/src/main.py b/src/main.py
index 72c439a..f7b5231 100644
--- a/src/main.py
+++ b/src/main.py
@@ -163,6 +163,8 @@ def parse_args() -> argparse.Namespace:
                           "(default: /tmp/fluxcast-wfd-latency.jsonl)")
     wfd.add_argument("--wfd-progress-log", default=None, dest="wfd_progress_log",
                      help="For --protocol wfd, write machine-readable ffmpeg progress at 250 ms intervals")
+    wfd.add_argument("--wfd-packet-log", default=None, dest="wfd_packet_log",
+                     help="For --protocol wfd, write per-stream packet timestamps before muxing")
     wfd.add_argument("--wfd-dump-ts", nargs="?", const="/tmp/fluxcast-wfd-stream.ts",
                      default=None, dest="wfd_dump_ts",
                      help="For --protocol wfd, write the transmitted MPEG-TS to this file and "
diff --git a/src/wfd/config.py b/src/wfd/config.py
index 4a976b8..d808fc4 100644
--- a/src/wfd/config.py
+++ b/src/wfd/config.py
@@ -19,6 +19,7 @@ class WFDMediaConfig:
     media_pipeline: str = "auto"
     latency_log_path: Optional[str] = None
     progress_log_path: Optional[str] = None
+    packet_log_path: Optional[str] = None
     capture_backend: str = "auto"
     video_encoder: str = "auto"
     peer_name: str = ""
diff --git a/src/wfd/media/wlroots.py b/src/wfd/media/wlroots.py
index e03dba7..06d445b 100644
--- a/src/wfd/media/wlroots.py
+++ b/src/wfd/media/wlroots.py
@@ -82,6 +82,18 @@ class WlrootsMixin:
             ]
 
         ffmpeg_cmd += self._common_output_args()
+        if self.config.packet_log_path:
+            # stats_mux_pre is silently ignored for stream-copy outputs. A
+            # second framecrc output observes every encoded H.264/AAC packet
+            # and PTS without re-encoding or changing the paced RTP output.
+            ffmpeg_cmd += [
+                "-map", "0:v:0",
+                "-map", "0:a:0",
+                "-c", "copy",
+                "-flush_packets", "1",
+                "-f", "framecrc",
+                self.config.packet_log_path,
+            ]
 
         print(f"[FluxCast WFD Media] Capturing screen : {monitor.name} ({src_res})")
         print("[FluxCast WFD Media] Capture/encoder   : GPU Screen Recorder")
diff --git a/src/wfd/modes.py b/src/wfd/modes.py
index 9f1de90..1faccee 100644
--- a/src/wfd/modes.py
+++ b/src/wfd/modes.py
@@ -121,6 +121,26 @@ def _choose_cea_mode(
                 )
         return WFD_CEA_MODES[WFD_CEA_640P60]
 
+    # An explicit standard-HD request is an operator choice, not a hint. Some
+    # Android sinks advertise only the mandatory 720p30 bit while accepting
+    # 720p60 and 1080p30/60. Preserve the requested stress/quality mode so the
+    # caller can measure it instead of silently testing a lower workload.
+    requested_bit = None
+    if resolution == (1280, 720):
+        requested_bit = WFD_CEA_720P60 if wants_60 else WFD_CEA_720P30
+    elif resolution == (1920, 1080):
+        requested_bit = WFD_CEA_1080P60 if wants_60 else WFD_CEA_1080P30
+    if requested_bit is not None:
+        mode = WFD_CEA_MODES[requested_bit]
+        if not supports(requested_bit):
+            if not _mode_force_warned:
+                _mode_force_warned = True
+                print(
+                    f"[FluxCast WFD RTSP] WARNING: Sink does not advertise "
+                    f"{mode.name}; forcing the explicitly requested mode."
+                )
+        return mode
+
     # Build preference order: if monitor is 1200p, prefer VESA 1200p modes first
     if wants_1200:
         preferred = (
