diff --git a/tests/test_wfd_cooperative_shutdown.py b/tests/test_wfd_cooperative_shutdown.py
new file mode 100644
index 0000000..d425a48
--- /dev/null
+++ b/tests/test_wfd_cooperative_shutdown.py
@@ -0,0 +1,142 @@
+import signal
+import socket
+import unittest
+from types import SimpleNamespace
+from unittest import mock
+
+import main as fluxcast_main
+from wfd.config import WFDMediaConfig
+from wfd.ie import WFDPeer
+from wfd.p2p.addressing import _wait_for_peer_ip
+from wfd.probe import ActiveRTSPProbe, _start_probe_media, _stop_probe_media
+from wfd.session import start_experimental_backend
+
+
+class WFDSignalTest(unittest.TestCase):
+    def test_sigterm_enters_the_existing_keyboard_interrupt_unwind(self):
+        with self.assertRaises(KeyboardInterrupt):
+            fluxcast_main._wfd_sigterm(signal.SIGTERM, None)
+
+    def test_wfd_main_installs_and_restores_its_sigterm_handler(self):
+        args = SimpleNamespace(
+            transport="unused",
+            protocol="wfd",
+            tray=False,
+            doctor=False,
+            doctor_json=False,
+            wfd_scan=False,
+        )
+        previous = signal.getsignal(signal.SIGTERM)
+        with mock.patch.object(fluxcast_main, "parse_args", return_value=args), mock.patch(
+            "wfd.start_experimental_backend",
+            side_effect=lambda _args: fluxcast_main._wfd_sigterm(signal.SIGTERM, None),
+        ) as start:
+            fluxcast_main.main()
+        start.assert_called_once_with(args)
+        self.assertIs(signal.getsignal(signal.SIGTERM), previous)
+
+
+class ActiveProbeOwnershipTest(unittest.TestCase):
+    def test_stop_cancels_and_joins_probe_during_initial_wait(self):
+        probe = ActiveRTSPProbe(
+            SimpleNamespace(has_connected_client=False),
+            WFDPeer(address="00:11:22:33:44:55", name="TV"),
+            WFDMediaConfig(monitor=None),
+        )
+        probe.start()
+        probe.stop()
+        self.assertIsNotNone(probe._thread)
+        self.assertFalse(probe._thread.is_alive())
+
+    def test_stop_closes_an_owned_outbound_socket(self):
+        probe = ActiveRTSPProbe(
+            SimpleNamespace(),
+            WFDPeer(address="00:11:22:33:44:55", name="TV"),
+            WFDMediaConfig(monitor=None),
+        )
+        owned, peer = socket.socketpair()
+        try:
+            self.assertTrue(probe.attach_socket(owned))
+            probe.stop()
+            self.assertEqual(owned.fileno(), -1)
+            self.assertEqual(peer.recv(1), b"")
+        finally:
+            peer.close()
+
+    def test_probe_media_is_registered_before_start_and_always_unregistered(self):
+        parent = mock.Mock()
+        media = mock.Mock()
+        calls = mock.Mock()
+        calls.attach_mock(parent._register_media, "register")
+        calls.attach_mock(media.start, "start")
+        calls.attach_mock(media.stop, "stop")
+        calls.attach_mock(parent._unregister_media, "unregister")
+
+        _start_probe_media(parent, media)
+        _stop_probe_media(parent, media)
+
+        self.assertEqual(
+            calls.mock_calls,
+            [mock.call.register(media), mock.call.start(), mock.call.stop(), mock.call.unregister(media)],
+        )
+
+    def test_probe_media_start_failure_releases_session_ownership(self):
+        parent = mock.Mock()
+        media = mock.Mock()
+        media.start.side_effect = RuntimeError("spawn failed")
+        with self.assertRaisesRegex(RuntimeError, "spawn failed"):
+            _start_probe_media(parent, media)
+        parent._register_media.assert_called_once_with(media)
+        parent._unregister_media.assert_called_once_with(media)
+
+    def test_peer_lookup_observes_cancellation_before_polling(self):
+        with mock.patch("wfd.p2p.addressing._get_peer_ip_from_arp") as lookup:
+            self.assertIsNone(
+                _wait_for_peer_ip(
+                    "00:11:22:33:44:55",
+                    interface="wlan0",
+                    cancelled=lambda: True,
+                )
+            )
+        lookup.assert_not_called()
+
+
+class WFDSessionShutdownTest(unittest.TestCase):
+    def test_keyboard_interrupt_stops_probe_media_server_and_broker(self):
+        args = SimpleNamespace(
+            wfd_no_firewall=True,
+            wfd_test_pattern=True,
+            wfd_dry_run=False,
+            wfd_interface="wlan0",
+            wfd_timeout=1,
+            wfd_p2p_backend="supplicant",
+            wfd_supplicant_broker="/run/omarchy-cast/" + "a" * 32 + "/supplicant.sock",
+            fps=60,
+            bitrate="4M",
+            output_res="1280x720",
+        )
+        report = SimpleNamespace(wfd_candidate=True)
+        peer = WFDPeer(address="00:11:22:33:44:55", name="TV")
+        rtsp = mock.Mock()
+        probe = mock.Mock()
+
+        with mock.patch("wfd.session.run_diagnostics", return_value=report), mock.patch(
+            "wfd.session.print_report"
+        ), mock.patch("wfd.session._scan_and_select", return_value=peer), mock.patch(
+            "wfd.session.WFDRTSPServer", return_value=rtsp
+        ), mock.patch("wfd.session.connect_supplicant_group"), mock.patch(
+            "wfd.session.ActiveRTSPProbe", return_value=probe
+        ), mock.patch("wfd.session.time.sleep", side_effect=KeyboardInterrupt), mock.patch(
+            "wfd.session.broker_request", return_value={"cleaned": True}
+        ) as broker, mock.patch("wfd.session.report_ts_dump"):
+            start_experimental_backend(args)
+
+        probe.start.assert_called_once_with()
+        probe.stop.assert_called_once_with()
+        rtsp.stop_all_media.assert_called_once_with()
+        rtsp.stop.assert_called_once_with()
+        broker.assert_called_once_with(args.wfd_supplicant_broker, "cleanup", timeout=10.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
