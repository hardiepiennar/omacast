diff --git a/src/wfd/probe.py b/src/wfd/probe.py
index f2362c8..eae78b4 100644
--- a/src/wfd/probe.py
+++ b/src/wfd/probe.py
@@ -1,5 +1,6 @@
 import random
 import socket
+import threading
 import time
 from dataclasses import replace
 from typing import Optional
@@ -23,14 +24,105 @@ from .rtsp.message import (
 from .rtsp.rtsp_server import WFDRTSPServer
 
 
+class ActiveRTSPProbe:
+    """Own the outbound probe thread and the socket that can unblock it."""
+
+    def __init__(self, rtsp_server: WFDRTSPServer, peer: WFDPeer, media_config: WFDMediaConfig) -> None:
+        self.rtsp_server = rtsp_server
+        self.peer = peer
+        self.media_config = media_config
+        self._stop = threading.Event()
+        self._socket_lock = threading.Lock()
+        self._socket: Optional[socket.socket] = None
+        self._thread: Optional[threading.Thread] = None
+
+    def start(self) -> None:
+        if self._thread is not None:
+            raise RuntimeError("active RTSP probe already started")
+        self._thread = threading.Thread(
+            target=_active_rtsp_probe,
+            args=(self.rtsp_server, self.peer, self.media_config, self),
+            daemon=True,
+            name="wfd-active-rtsp-probe",
+        )
+        self._thread.start()
+
+    def cancelled(self) -> bool:
+        return self._stop.is_set()
+
+    def wait(self, timeout: float) -> bool:
+        return self._stop.wait(timeout)
+
+    def attach_socket(self, value: socket.socket) -> bool:
+        with self._socket_lock:
+            if self.cancelled():
+                return False
+            self._socket = value
+            return True
+
+    def detach_socket(self, value: socket.socket) -> None:
+        with self._socket_lock:
+            if self._socket is value:
+                self._socket = None
+
+    def stop(self) -> None:
+        self._stop.set()
+        with self._socket_lock:
+            active_socket = self._socket
+            self._socket = None
+        if active_socket is not None:
+            try:
+                active_socket.shutdown(socket.SHUT_RDWR)
+            except OSError:
+                pass
+            try:
+                active_socket.close()
+            except OSError:
+                pass
+        thread = self._thread
+        if (
+            thread is not None
+            and thread.ident is not None
+            and thread is not threading.current_thread()
+        ):
+            thread.join(timeout=6.0)
+            if thread.is_alive():
+                raise RuntimeError("active RTSP probe did not stop within its deadline")
+
+
+def _start_probe_media(rtsp_server: WFDRTSPServer, media: WFDMediaPipeline) -> None:
+    """Publish probe media to the session before starting its child processes."""
+    rtsp_server._register_media(media)
+    try:
+        media.start()
+    except BaseException:
+        try:
+            rtsp_server._unregister_media(media)
+        except Exception:
+            pass
+        raise
+
+
+def _stop_probe_media(rtsp_server: WFDRTSPServer, media: WFDMediaPipeline) -> None:
+    try:
+        media.stop()
+    finally:
+        rtsp_server._unregister_media(media)
+
+
 def _active_rtsp_probe(
     rtsp_server: WFDRTSPServer,
     peer: WFDPeer,
     media_config: WFDMediaConfig,
+    control: Optional[ActiveRTSPProbe] = None,
 ) -> None:
     # 4s: give passive-RTSP TVs a window to connect first, without burning too
     # much of the cca 15 s timeout that some TVs enforce after P2P activation.
-    time.sleep(4.0)
+    if control is not None:
+        if control.wait(4.0):
+            return
+    else:
+        time.sleep(4.0)
     if rtsp_server.has_connected_client:
         return
 
@@ -44,7 +136,10 @@ def _active_rtsp_probe(
         timeout=8.0,
         interface=rtsp_server.interface,
         allow_interface_fallback=False,
+        cancelled=control.cancelled if control is not None else None,
     )
+    if control is not None and control.cancelled():
+        return
     if not tv_ip:
         print(
             f"[FluxCast WFD RTSP] Active probe: selected TV IP not found for MAC "
@@ -71,11 +166,17 @@ def _active_rtsp_probe(
         print(f"[FluxCast WFD RTSP] Active probe: connect error: {exc}")
         return
 
+    if control is not None and not control.attach_socket(sock):
+        sock.close()
+        return
+
     print(f"[FluxCast WFD RTSP] Active probe: connected to TV RTSP at {tv_ip}:{tv_port}")
     claim = rtsp_server.claim_client(tv_ip, replace_unconfirmed=True)
     if claim is None:
         print(f"[FluxCast WFD RTSP] Active probe: rejected unverified or duplicate client {tv_ip}")
         sock.close()
+        if control is not None:
+            control.detach_socket(sock)
         return
     try:
         sock.settimeout(8.0)
@@ -86,6 +187,8 @@ def _active_rtsp_probe(
         print(f"[FluxCast WFD RTSP] Active probe: socket setup failed: {exc}")
         sock.close()
         rtsp_server.release_client(tv_ip, claim)
+        if control is not None:
+            control.detach_socket(sock)
         return
     local_uri = f"rtsp://{local_ip}:{rtsp_server.port}/wfd1.0"
     session_id = str(random.randint(1_000_000, 9_999_999))
@@ -258,7 +361,7 @@ def _active_rtsp_probe(
                         )
                         if eff_cfg.aosp_pmt_pid:
                             print("[FluxCast WFD RTSP] AOSP-compatible MPEG-TS requested: PMT 0x0100, PSI version 1 (#84).")
-                        media.start()
+                        _start_probe_media(rtsp_server, media)
                         schedule_ts_dump_report(eff_cfg.dump_ts_path)
                         # Keep-alive: respond to GET_PARAMETER/SET_PARAMETER heartbeats.
