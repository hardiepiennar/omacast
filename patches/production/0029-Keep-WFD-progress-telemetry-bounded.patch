diff --git a/src/wfd/progress.py b/src/wfd/progress.py
new file mode 100644
index 0000000..233ae37
--- /dev/null
+++ b/src/wfd/progress.py
@@ -0,0 +1,105 @@
+import os
+import re
+import stat
+import sys
+import threading
+from typing import BinaryIO, Optional
+
+
+MAX_PROGRESS_LINE_BYTES = 8 * 1024
+MAX_PROGRESS_RECORD_BYTES = 16 * 1024
+_CONTROLLER_FD_PATH = re.compile(r"^/proc/[1-9][0-9]*/fd/[0-9]+$")
+_PROGRESS_KEYS = frozenset({
+    b"frame", b"fps", b"stream_0_0_q", b"bitrate", b"total_size",
+    b"out_time_us", b"out_time_ms", b"out_time", b"dup_frames",
+    b"drop_frames", b"speed", b"progress",
+})
+
+
+def _write_progress_snapshot(path: str, payload: bytes) -> None:
+    if len(payload) > MAX_PROGRESS_RECORD_BYTES:
+        raise ValueError("FFmpeg progress record exceeds its byte limit")
+    flags = os.O_WRONLY | os.O_CLOEXEC | getattr(os, "O_NONBLOCK", 0)
+    if not _CONTROLLER_FD_PATH.fullmatch(path):
+        flags |= getattr(os, "O_NOFOLLOW", 0)
+    descriptor = os.open(path, flags)
+    try:
+        metadata = os.fstat(descriptor)
+        if (
+            not stat.S_ISREG(metadata.st_mode)
+            or metadata.st_uid != os.getuid()
+            or metadata.st_mode & 0o077
+            or metadata.st_nlink not in (0, 1)
+        ):
+            raise ValueError("FFmpeg progress output is unsafe")
+        os.ftruncate(descriptor, 0)
+        view = memoryview(payload)
+        offset = 0
+        while view:
+            written = os.pwrite(descriptor, view, offset)
+            if written <= 0:
+                raise OSError("FFmpeg progress write made no progress")
+            offset += written
+            view = view[written:]
+    finally:
+        os.close(descriptor)
+
+
+def _drain_ffmpeg_progress(
+    stream: BinaryIO,
+    path: str,
+    diagnostic: Optional[BinaryIO] = None,
+) -> None:
+    """Drain FFmpeg stderr, retaining only its latest complete progress record."""
+    diagnostic = diagnostic or sys.stderr.buffer
+    record = bytearray()
+    collecting = False
+    output_failed = False
+    try:
+        while True:
+            line = stream.readline(MAX_PROGRESS_LINE_BYTES + 1)
+            if not line:
+                break
+            if len(line) > MAX_PROGRESS_LINE_BYTES or not line.endswith(b"\n"):
+                while line and not line.endswith(b"\n"):
+                    line = stream.readline(MAX_PROGRESS_LINE_BYTES + 1)
+                record.clear()
+                collecting = False
+                continue
+            key, separator, _ = line.partition(b"=")
+            if separator and key == b"frame":
+                record = bytearray(line)
+                collecting = True
+                continue
+            if collecting and separator and key in _PROGRESS_KEYS:
+                if len(record) + len(line) > MAX_PROGRESS_RECORD_BYTES:
+                    record.clear()
+                    collecting = False
+                    continue
+                record.extend(line)
+                if key == b"progress":
+                    try:
+                        _write_progress_snapshot(path, bytes(record))
+                    except (OSError, ValueError) as exc:
+                        if not output_failed:
+                            diagnostic.write(f"[FluxCast WFD] progress output disabled: {exc}\n".encode())
+                            diagnostic.flush()
+                        output_failed = True
+                    record.clear()
+                    collecting = False
+                continue
+            diagnostic.write(line)
+            diagnostic.flush()
+    finally:
+        stream.close()
+
+
+def _start_ffmpeg_progress_drain(stream: BinaryIO, path: str) -> threading.Thread:
+    thread = threading.Thread(
+        target=_drain_ffmpeg_progress,
+        args=(stream, path),
+        name="fluxcast-wfd-progress",
+        daemon=True,
+    )
+    thread.start()
+    return thread
