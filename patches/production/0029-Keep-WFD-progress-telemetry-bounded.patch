diff --git a/tests/test_wfd_progress_bounds.py b/tests/test_wfd_progress_bounds.py
new file mode 100644
index 0000000..c6d3565
--- /dev/null
+++ b/tests/test_wfd_progress_bounds.py
@@ -0,0 +1,73 @@
+import io
+import os
+from pathlib import Path
+import tempfile
+import unittest
+
+from wfd.progress import (
+    MAX_PROGRESS_LINE_BYTES,
+    MAX_PROGRESS_RECORD_BYTES,
+    _drain_ffmpeg_progress,
+    _write_progress_snapshot,
+)
+
+
+def record(frame: int) -> bytes:
+    return (
+        f"frame={frame}\n"
+        "fps=60.0\n"
+        f"out_time_us={frame * 16667}\n"
+        "dup_frames=0\n"
+        "drop_frames=0\n"
+        "speed=1.0x\n"
+        "progress=continue\n"
+    ).encode()
+
+
+class WFDProgressBoundsTest(unittest.TestCase):
+    def test_many_records_leave_only_the_latest_bounded_snapshot(self):
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / "progress"
+            path.write_bytes(b"")
+            path.chmod(0o600)
+            diagnostic = io.BytesIO()
+            payload = b"warning before progress\n" + b"".join(record(index) for index in range(10_000))
+            _drain_ffmpeg_progress(io.BytesIO(payload), str(path), diagnostic)
+            retained = path.read_bytes()
+            self.assertLessEqual(len(retained), MAX_PROGRESS_RECORD_BYTES)
+            self.assertIn(b"frame=9999\n", retained)
+            self.assertNotIn(b"frame=9998\n", retained)
+            self.assertEqual(diagnostic.getvalue(), b"warning before progress\n")
+
+    def test_oversized_partial_line_is_discarded_without_hiding_later_progress(self):
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / "progress"
+            path.write_bytes(b"")
+            path.chmod(0o600)
+            payload = b"frame=" + b"9" * (MAX_PROGRESS_LINE_BYTES * 2) + b"\n" + record(7)
+            _drain_ffmpeg_progress(io.BytesIO(payload), str(path), io.BytesIO())
+            self.assertIn(b"frame=7\n", path.read_bytes())
+
+    def test_linked_or_public_output_is_rejected_before_truncation(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            for kind in ("symlink", "hardlink", "public"):
+                with self.subTest(kind=kind):
+                    target = root / f"target-{kind}"
+                    target.write_bytes(b"preserve")
+                    target.chmod(0o600)
+                    candidate = root / f"candidate-{kind}"
+                    if kind == "symlink":
+                        candidate.symlink_to(target)
+                    elif kind == "hardlink":
+                        os.link(target, candidate)
+                    else:
+                        candidate = target
+                        candidate.chmod(0o644)
+                    with self.assertRaises((OSError, ValueError)):
+                        _write_progress_snapshot(str(candidate), record(1))
+                    self.assertEqual(target.read_bytes(), b"preserve")
+
+
+if __name__ == "__main__":
+    unittest.main()
