diff --git a/src/wfd/rtsp/handler.py b/src/wfd/rtsp/handler.py
index c96d010..d07e444 100644
--- a/src/wfd/rtsp/handler.py
+++ b/src/wfd/rtsp/handler.py
@@ -17,11 +17,14 @@ from ..modes import (
 )
 from ..net import _netdev_tx_bytes, _safe_source_port
 from .message import (
-    RTSPMessage, _parse_parameters, _parse_rtp_ports,
+    RTSPMessage, RTSPMessageError, _parse_parameters, _parse_rtp_ports,
     _parse_transport_client_ports, _read_rtsp_message, _sink_advertises_uibc,
 )
 
 
+RTSP_MESSAGE_TIMEOUT = 10.0
+
+
 class _WFDRTSPHandler(socketserver.StreamRequestHandler):
     def handle(self) -> None:
         client_ip = self.client_address[0]
@@ -64,7 +67,7 @@ class _WFDRTSPHandler(socketserver.StreamRequestHandler):
         try:
             self._send_m1_options()
             while True:
-                msg = _read_rtsp_message(self.rfile)
+                msg = self._read_next_message()
                 if msg is None:
                     print(f"[FluxCast WFD RTSP] TV disconnected from {peer}")
                     return
@@ -75,12 +78,28 @@ class _WFDRTSPHandler(socketserver.StreamRequestHandler):
                     self._handle_request(msg)
         except WFDNotReady as exc:
             print(f"[FluxCast WFD RTSP] ERROR: {exc}")
+        except RTSPMessageError as exc:
+            print(f"[FluxCast WFD RTSP] Rejected invalid message: {exc}")
         except OSError as exc:
             print(f"[FluxCast WFD RTSP] Socket closed: {exc}")
         finally:
             self._keepalive_active = False
             self._stop_media()
 
+    def _read_next_message(self) -> Optional[RTSPMessage]:
+        # Negotiation must begin promptly. Once media is established a sink may
+        # legitimately stay silent for a long time, so wait without an idle
+        # deadline but bound completion after the first buffered byte arrives.
+        if self.media is not None:
+            self.request.settimeout(None)
+            if not self.rfile.peek(1):
+                return None
+        self.request.settimeout(RTSP_MESSAGE_TIMEOUT)
+        try:
+            return _read_rtsp_message(self.rfile)
+        finally:
+            self.request.settimeout(None)
+
     @property
     def media_config(self) -> WFDMediaConfig:
         return self.server.media_config  # type: ignore[attr-defined]
diff --git a/src/wfd/rtsp/message.py b/src/wfd/rtsp/message.py
