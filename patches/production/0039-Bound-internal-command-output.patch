diff --git a/src/wfd/proc.py b/src/wfd/proc.py
index 779acb2..d1d181a 100644
--- a/src/wfd/proc.py
+++ b/src/wfd/proc.py
@@ -1,10 +1,91 @@
+import locale
+import os
+import selectors
 import subprocess
+import time
+from collections.abc import Mapping
 
 
-def _run(args: list[str], timeout: float = 5.0) -> subprocess.CompletedProcess[str]:
-    return subprocess.run(
+MAX_COMMAND_OUTPUT_BYTES = 128 * 1024
+_READ_CHUNK_BYTES = 16 * 1024
+
+
+class CommandOutputLimitExceeded(OSError):
+    pass
+
+
+def _decode_output(value: bytearray) -> str:
+    return bytes(value).decode(locale.getpreferredencoding(False), errors="replace")
+
+
+def _stop(process: "subprocess.Popen[bytes]") -> None:
+    if process.poll() is None:
+        process.kill()
+    process.wait()
+
+
+def _run(
+    args: list[str],
+    timeout: float = 5.0,
+    env: Mapping[str, str] | None = None,
+) -> subprocess.CompletedProcess[str]:
+    process = subprocess.Popen(
         args,
-        capture_output=True,
-        text=True,
-        timeout=timeout,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        env=env,
+    )
+    assert process.stdout is not None and process.stderr is not None
+
+    selector = selectors.DefaultSelector()
+    streams = {process.stdout: bytearray(), process.stderr: bytearray()}
+    selector.register(process.stdout, selectors.EVENT_READ)
+    selector.register(process.stderr, selectors.EVENT_READ)
+    deadline = time.monotonic() + timeout
+
+    try:
+        while selector.get_map():
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                _stop(process)
+                raise subprocess.TimeoutExpired(
+                    args,
+                    timeout,
+                    output=_decode_output(streams[process.stdout]),
+                    stderr=_decode_output(streams[process.stderr]),
+                )
+            for key, _ in selector.select(min(remaining, 0.1)):
+                stream = key.fileobj
+                chunk = os.read(stream.fileno(), _READ_CHUNK_BYTES)
+                if not chunk:
+                    selector.unregister(stream)
+                    continue
+                retained = streams[stream]
+                available = MAX_COMMAND_OUTPUT_BYTES - len(retained)
+                retained.extend(chunk[:available])
+                if len(chunk) > available:
+                    _stop(process)
+                    raise CommandOutputLimitExceeded(
+                        f"command output exceeded {MAX_COMMAND_OUTPUT_BYTES} bytes: {args[0]}"
+                    )
+
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            _stop(process)
+            raise subprocess.TimeoutExpired(args, timeout)
+        returncode = process.wait(timeout=remaining)
+    except BaseException:
+        if process.poll() is None:
+            _stop(process)
+        raise
+    finally:
+        selector.close()
+        process.stdout.close()
+        process.stderr.close()
+
+    return subprocess.CompletedProcess(
+        args,
+        returncode,
+        _decode_output(streams[process.stdout]),
+        _decode_output(streams[process.stderr]),
     )
