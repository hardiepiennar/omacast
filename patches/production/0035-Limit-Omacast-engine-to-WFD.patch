diff --git a/tests/test_wfd_only_cli.py b/tests/test_wfd_only_cli.py
new file mode 100644
index 0000000..3520520
--- /dev/null
+++ b/tests/test_wfd_only_cli.py
@@ -0,0 +1,50 @@
+import contextlib
+import io
+import pathlib
+import sys
+import unittest
+from unittest import mock
+
+import main as fluxcast_main
+
+
+class WFDOnlyCLITest(unittest.TestCase):
+    def parse(self, *arguments):
+        with mock.patch.object(sys, "argv", ["fluxcast", *arguments]):
+            return fluxcast_main.parse_args()
+
+    def test_default_and_explicit_wfd_remain_available(self):
+        self.assertEqual(self.parse().protocol, "wfd")
+        self.assertEqual(self.parse("--protocol", "wfd").protocol, "wfd")
+
+    def test_unused_protocols_are_rejected_by_the_parser(self):
+        for protocol in ("dlna", "cast"):
+            with self.subTest(protocol=protocol), contextlib.redirect_stderr(io.StringIO()):
+                with self.assertRaisesRegex(SystemExit, "2"):
+                    self.parse("--protocol", protocol)
+
+    def test_tray_mode_is_not_exposed(self):
+        for option in ("--tray", "--host", "--port", "--transport", "--tv-ip"):
+            with self.subTest(option=option), contextlib.redirect_stderr(io.StringIO()):
+                with self.assertRaisesRegex(SystemExit, "2"):
+                    self.parse(option)
+
+    def test_help_advertises_only_the_wfd_protocol(self):
+        output = io.StringIO()
+        with mock.patch.object(sys, "argv", ["fluxcast", "--help"]), contextlib.redirect_stdout(output):
+            with self.assertRaisesRegex(SystemExit, "0"):
+                fluxcast_main.parse_args()
+        help_text = output.getvalue()
+        self.assertIn("--protocol {wfd}", help_text)
+        self.assertNotIn("--tray", help_text)
+        self.assertNotIn("DLNA / Cast Options", help_text)
+
+    def test_wheel_excludes_unused_protocol_and_tray_modules(self):
+        project = pathlib.Path(__file__).resolve().parents[1] / "pyproject.toml"
+        metadata = project.read_text(encoding="utf-8")
+        for excluded in ("src/cast/**", "src/dlna/**", "src/ui/**", "src/server.py"):
+            self.assertIn(f'"{excluded}"', metadata)
+
+
+if __name__ == "__main__":
+    unittest.main()
