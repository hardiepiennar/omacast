Subject: [PATCH] Preserve WFD sink role in NetworkManager discovery

---
 src/wfd/ie.py              | 50 +++++++++++++++++++++++++++++---------
 src/wfd/p2p/nm.py          | 10 ++++++--
 src/wfd/p2p/scan_nm.py     | 14 ++++++++---
 tests/test_wfd_p2p_scan.py | 44 ++++++++++++++++++++++++++++++++-
 4 files changed, 100 insertions(+), 18 deletions(-)

diff --git a/src/wfd/ie.py b/src/wfd/ie.py
index eb29fa3..5253805 100644
--- a/src/wfd/ie.py
+++ b/src/wfd/ie.py
@@ -1,5 +1,6 @@
 import re
 from dataclasses import dataclass
+from typing import Optional
 
 
 def _wfd_ie_device_info(rtsp_port: int) -> bytes:
@@ -34,6 +35,40 @@ def _parse_gdbus_byte_array(raw: str) -> list[int]:
     """
     return [int(h, 16) for h in re.findall(r"0x([0-9a-fA-F]+)", raw)]
 
+def _parse_wfd_ies_device_info(
+    wfd_ies: list[int],
+) -> Optional[tuple[int, int, int]]:
+    """Return the Device Information word, RTSP port, and throughput.
+
+    NetworkManager exposes the WFD IE as bytes but does not project the peer's
+    source/sink role.  Preserve that role along with the port so callers do not
+    have to infer a receiver from the conventional port alone.
+    """
+    if not wfd_ies or any(type(value) is not int or not 0 <= value <= 0xff for value in wfd_ies):
+        return None
+
+    i = 0
+    while i + 3 <= len(wfd_ies):
+        sub_id = wfd_ies[i]
+        sub_len = (wfd_ies[i + 1] << 8) | wfd_ies[i + 2]
+        end = i + 3 + sub_len
+        if end > len(wfd_ies):
+            return None
+        if sub_id == 0 and sub_len >= 6:
+            device_info = (wfd_ies[i + 3] << 8) | wfd_ies[i + 4]
+            port = (wfd_ies[i + 5] << 8) | wfd_ies[i + 6]
+            throughput = (wfd_ies[i + 7] << 8) | wfd_ies[i + 8]
+            return device_info, port, throughput
+        i = end
+    return None
+
+def _wfd_device_info_detail(wfd_ies: list[int]) -> str:
+    parsed = _parse_wfd_ies_device_info(wfd_ies)
+    if parsed is None:
+        return ""
+    device_info, port, throughput = parsed
+    return f"wfd_dev_info=0x{device_info:04x}{port:04x}{throughput:04x}"
+
 def _parse_wfd_ies_rtsp_port(wfd_ies: list[int]) -> int:
     """
     Parse the WFD Information Element bytes to find the Sink's RTSP port.
@@ -41,16 +76,7 @@ def _parse_wfd_ies_rtsp_port(wfd_ies: list[int]) -> int:
     Bytes 3-4 of the subelement (offset 3 and 4 after ID and Length) 
     contain the RTSP port.
     """
-    if not wfd_ies or len(wfd_ies) < 6:
+    parsed = _parse_wfd_ies_device_info(wfd_ies)
+    if parsed is None:
         return 7236
-    
-    i = 0
-    while i + 3 <= len(wfd_ies):
-        sub_id = wfd_ies[i]
-        sub_len = (wfd_ies[i+1] << 8) | wfd_ies[i+2]
-        if sub_id == 0 and sub_len >= 6 and i + 3 + sub_len <= len(wfd_ies):
-            # Port is at index i + 3 + 2 and i + 3 + 3
-            port = (wfd_ies[i+5] << 8) | wfd_ies[i+6]
-            return port if port > 0 else 7236
-        i += 3 + sub_len
-    return 7236
+    return parsed[1] if parsed[1] > 0 else 7236
