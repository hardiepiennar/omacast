From f7dd416ba9e781f256ac4d67d3fe93dba45b8315 Mon Sep 17 00:00:00 2001
From: Omarchy Cast package build <packaging@localhost>
Date: Sat, 22 Aug 2026 20:21:16 +1200
Subject: [PATCH] Pace RTP at the MPEG-TS clock

---
 src/wfd/media/pipeline.py | 11 ++++-------
 tests/test_wfd.py         |  2 +-
 2 files changed, 5 insertions(+), 8 deletions(-)

diff --git a/src/wfd/media/pipeline.py b/src/wfd/media/pipeline.py
index d90391e..6185a9c 100644
--- a/src/wfd/media/pipeline.py
+++ b/src/wfd/media/pipeline.py
@@ -123,12 +123,10 @@ class WFDMediaPipeline(TestPatternMixin, PortalMixin, X11Mixin, WlrootsMixin):
 
     def _rtp_output(self) -> str:
         transport_rate = self._transport_rate_bps()
-        # The MPEG-TS muxrate counts only 188-byte TS packets, while the UDP
-        # pacer sees RTP framing too. Scheduler latency makes single-datagram
-        # bursts miss their ~1.7 ms wake-up deadline and back up the socket.
-        # Four datagrams every ~6 ms remain smooth while giving the wire pacer
-        # enough headroom to drain each muxer batch promptly.
-        wire_rate = transport_rate * 120 // 100
+        # The UDP pacer counts the 12-byte RTP header as well as each 1316-byte
+        # (7 * 188) TS payload. Pace at that exact clock instead of draining
+        # queued batches 20% fast and then starving the sink between bursts.
+        wire_rate = transport_rate * 101 // 100
         return _rtp_url(
             self.tv_ip,
             self.sink_rtp_port,
@@ -229,4 +227,3 @@ class WFDMediaPipeline(TestPatternMixin, PortalMixin, X11Mixin, WlrootsMixin):
 
 
 
-
diff --git a/tests/test_wfd.py b/tests/test_wfd.py
index 0f1812e..720ffd6 100644
--- a/tests/test_wfd.py
+++ b/tests/test_wfd.py
@@ -314,7 +314,7 @@ class AospTablesVersionTest(unittest.TestCase):
 
         self.assertEqual(args[args.index("-muxrate") + 1], "6000000")
         output = args[-1]
-        self.assertIn("bitrate=7200000", output)
+        self.assertIn("bitrate=6060000", output)
         self.assertIn("burst_bits=42496", output)
 
     def test_transport_does_not_force_per_packet_flushes(self):
