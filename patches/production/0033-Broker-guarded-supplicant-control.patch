diff --git a/tests/test_wfd_p2p_broker.py b/tests/test_wfd_p2p_broker.py
new file mode 100644
index 0000000..ac1b30b
--- /dev/null
+++ b/tests/test_wfd_p2p_broker.py
@@ -0,0 +1,98 @@
+import json
+import stat
+import unittest
+from types import SimpleNamespace
+from unittest import mock
+
+from wfd.config import WFDNotReady
+from wfd.ie import WFDPeer
+from wfd.p2p.broker import broker_request
+from wfd.p2p.supplicant import connect_supplicant_group
+
+
+BROKER = "/run/omarchy-cast/" + "a" * 32 + "/supplicant.sock"
+
+
+class _Socket:
+    def __init__(self, response):
+        self.response = response
+        self.sent = b""
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_args):
+        return False
+
+    def settimeout(self, _timeout):
+        pass
+
+    def connect(self, path):
+        self.path = path
+
+    def sendall(self, payload):
+        self.sent = payload
+
+    def recv(self, _size):
+        response, self.response = self.response, b""
+        return response
+
+
+class SupplicantBrokerClientTest(unittest.TestCase):
+    def metadata(self):
+        return SimpleNamespace(st_mode=stat.S_IFSOCK | 0o600, st_uid=1000)
+
+    def test_client_sends_only_versioned_operation_and_validates_response(self):
+        response = json.dumps({
+            "schemaVersion": 1,
+            "kind": "omarchy-cast-supplicant-response",
+            "ok": True,
+            "result": {"cleaned": True},
+            "error": None,
+        }).encode() + b"\n"
+        client = _Socket(response)
+        with mock.patch("wfd.p2p.broker.os.stat", return_value=self.metadata()), mock.patch(
+            "wfd.p2p.broker.os.getuid", return_value=1000
+        ), mock.patch("wfd.p2p.broker.socket.socket", return_value=client):
+            self.assertEqual(broker_request(BROKER, "cleanup", timeout=1), {"cleaned": True})
+        self.assertEqual(client.path, BROKER)
+        self.assertEqual(json.loads(client.sent), {"schemaVersion": 1, "op": "cleanup"})
+
+    def test_client_rejects_paths_socket_metadata_and_response_shapes(self):
+        with self.assertRaisesRegex(WFDNotReady, "outside the guarded session"):
+            broker_request("/tmp/broker", "connect", timeout=1)
+        unsafe = SimpleNamespace(st_mode=stat.S_IFREG | 0o600, st_uid=1000)
+        with mock.patch("wfd.p2p.broker.os.stat", return_value=unsafe):
+            with self.assertRaisesRegex(WFDNotReady, "unsafe"):
+                broker_request(BROKER, "connect", timeout=1)
+
+    def test_group_connection_uses_broker_without_direct_supplicant_calls(self):
+        args = SimpleNamespace(
+            wfd_supplicant_broker=BROKER,
+            wfd_supplicant_network_trigger=None,
+            wfd_supplicant_preconnect_delay=0,
+            wfd_interface="wlan0",
+        )
+        with mock.patch(
+            "wfd.p2p.supplicant.broker_request",
+            return_value={"group": {"interface": "p2p-wlan0-0", "role": "client"}},
+        ) as request, mock.patch("wfd.p2p.supplicant._supplicant_interface_path") as direct:
+            group = connect_supplicant_group(args, WFDPeer(address="00:11:22:33:44:55"))
+        request.assert_called_once_with(BROKER, "connect", timeout=50.0)
+        direct.assert_not_called()
+        self.assertEqual((group.ifname, group.role), ("p2p-wlan0-0", "client"))
+
+    def test_group_connection_rejects_unsanitized_broker_status(self):
+        args = SimpleNamespace(
+            wfd_supplicant_broker=BROKER,
+            wfd_supplicant_network_trigger=None,
+            wfd_supplicant_preconnect_delay=0,
+            wfd_interface="wlan0",
+        )
+        with mock.patch("wfd.p2p.supplicant.broker_request", return_value={"group": {"path": "/foreign"}}):
+            with self.assertRaisesRegex(WFDNotReady, "invalid group status"):
+                connect_supplicant_group(args, WFDPeer(address="00:11:22:33:44:55"))
+
+
+if __name__ == "__main__":
+    unittest.main()
