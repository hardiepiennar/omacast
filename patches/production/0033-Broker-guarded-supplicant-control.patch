diff --git a/src/wfd/p2p/broker.py b/src/wfd/p2p/broker.py
new file mode 100644
index 0000000..627e75a
--- /dev/null
+++ b/src/wfd/p2p/broker.py
@@ -0,0 +1,64 @@
+import json
+import os
+import re
+import socket
+import stat
+
+from ..config import WFDNotReady
+
+
+_BROKER_PATH = re.compile(r"^/run/omarchy-cast/[a-f0-9]{32}/supplicant\.sock$")
+
+
+def broker_request(path: str, operation: str, *, timeout: float) -> dict:
+    if not _BROKER_PATH.fullmatch(path):
+        raise WFDNotReady("The supplicant broker path is outside the guarded session.")
+    try:
+        metadata = os.stat(path, follow_symlinks=False)
+    except OSError as exc:
+        raise WFDNotReady(f"The supplicant broker is unavailable: {exc}") from exc
+    if (
+        not stat.S_ISSOCK(metadata.st_mode)
+        or metadata.st_uid != os.getuid()
+        or stat.S_IMODE(metadata.st_mode) != 0o600
+    ):
+        raise WFDNotReady("The supplicant broker socket is unsafe.")
+    request = json.dumps(
+        {"schemaVersion": 1, "op": operation}, separators=(",", ":")
+    ).encode("utf-8") + b"\n"
+    response = bytearray()
+    try:
+        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
+            client.settimeout(timeout)
+            client.connect(path)
+            client.sendall(request)
+            while b"\n" not in response:
+                chunk = client.recv(4097 - len(response))
+                if not chunk:
+                    break
+                response.extend(chunk)
+                if len(response) > 4096:
+                    raise WFDNotReady("The supplicant broker returned an oversized response.")
+    except (OSError, TimeoutError) as exc:
+        raise WFDNotReady(f"The supplicant broker request failed: {exc}") from exc
+    if not response.endswith(b"\n"):
+        raise WFDNotReady("The supplicant broker returned an incomplete response.")
+    try:
+        payload = json.loads(response)
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise WFDNotReady("The supplicant broker returned invalid JSON.") from exc
+    if (
+        not isinstance(payload, dict)
+        or set(payload) != {"schemaVersion", "kind", "ok", "result", "error"}
+        or payload.get("schemaVersion") != 1
+        or payload.get("kind") != "omarchy-cast-supplicant-response"
+        or not isinstance(payload.get("ok"), bool)
+    ):
+        raise WFDNotReady("The supplicant broker returned an invalid response.")
+    if payload["ok"] is not True:
+        detail = payload.get("error")
+        raise WFDNotReady(detail if isinstance(detail, str) and detail else "The supplicant broker refused the request.")
+    result = payload.get("result")
+    if not isinstance(result, dict):
+        raise WFDNotReady("The supplicant broker omitted its result.")
+    return result
