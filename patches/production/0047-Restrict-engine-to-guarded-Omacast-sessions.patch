new file mode 100644
index 0000000..0b5f3c0
--- /dev/null
+++ b/src/wfd/p2p/scan_nm.py
@@ -0,0 +1,90 @@
+"""NetworkManager-backed receiver discovery without connection mutation APIs."""
+
+import time
+from typing import Optional
+
+from ..config import WFDNotReady
+from ..constants import NM_DEST, NM_PATH
+from ..ie import WFDPeer, _parse_gdbus_byte_array, _parse_wfd_ies_rtsp_port
+from .dbus import _gdbus_call, _nm_get_property, _nm_get_string, _object_paths
+
+
+def _p2p_device_path(interface: Optional[str] = None) -> Optional[str]:
+    result = _gdbus_call([
+        "--dest", NM_DEST, "--object-path", NM_PATH,
+        "--method", "org.freedesktop.DBus.Properties.Get",
+        "org.freedesktop.NetworkManager", "Devices",
+    ])
+    if result.returncode != 0:
+        raise WFDNotReady((result.stderr or result.stdout).strip())
+    requested = interface or ""
+    for path in _object_paths(result.stdout):
+        iface = _nm_get_string(path, "org.freedesktop.NetworkManager.Device", "Interface")
+        if iface and "p2p" in iface.lower() and (not requested or requested in iface):
+            return path
+    return None
+
+
+def _start_find(path: str, timeout: int) -> None:
+    result = _gdbus_call([
+        "--dest", NM_DEST, "--object-path", path,
+        "--method", "org.freedesktop.NetworkManager.Device.WifiP2P.StartFind",
+        f"{{'timeout': <int32 {timeout}>}}",
+    ])
+    if result.returncode != 0:
+        raise WFDNotReady((result.stderr or result.stdout).strip())
+
+
+def _stop_find(path: str) -> None:
+    try:
+        _gdbus_call([
+            "--dest", NM_DEST, "--object-path", path,
+            "--method", "org.freedesktop.NetworkManager.Device.WifiP2P.StopFind",
+        ], timeout=3.0)
+    except Exception:
+        pass
+
+
+def _peer_paths(path: str) -> list[str]:
+    raw = _nm_get_property(path, "org.freedesktop.NetworkManager.Device.WifiP2P", "Peers")
+    return _object_paths(raw)[:256]
+
+
+def _nm_scan(interface: Optional[str], timeout: int,
+             selected_address: Optional[str] = None) -> list[WFDPeer]:
+    path = _p2p_device_path(interface)
+    if not path:
+        raise WFDNotReady("NetworkManager did not expose a Wi-Fi P2P device.")
+    iface = _nm_get_string(path, "org.freedesktop.NetworkManager.Device", "Interface") or path
+    print(f"[FluxCast WFD] Starting NetworkManager Wi-Fi Direct scan on {iface} for {timeout}s...")
+    _start_find(path, timeout)
+    try:
+        deadline = time.monotonic() + max(1, timeout)
+        while selected_address and time.monotonic() < deadline:
+            found = any(
+                _nm_get_string(peer, "org.freedesktop.NetworkManager.WifiP2PPeer", "HwAddress").lower()
+                == selected_address.lower()
+                for peer in _peer_paths(path)
+            )
+            if found:
+                break
+            time.sleep(min(0.5, max(0, deadline - time.monotonic())))
+        if not selected_address:
+            time.sleep(max(1, timeout))
+        peer_paths = _peer_paths(path)
+    finally:
+        _stop_find(path)
+
+    peers: list[WFDPeer] = []
+    for peer_path in peer_paths:
+        name = _nm_get_string(peer_path, "org.freedesktop.NetworkManager.WifiP2PPeer", "Name")[:256]
+        address = _nm_get_string(peer_path, "org.freedesktop.NetworkManager.WifiP2PPeer", "HwAddress")
+        wfd_raw = _nm_get_property(peer_path, "org.freedesktop.NetworkManager.WifiP2PPeer", "WfdIEs")
+        if len(wfd_raw) > 65_536:
+            wfd_raw = ""
+        sink_port = _parse_wfd_ies_rtsp_port(_parse_gdbus_byte_array(wfd_raw))
+        peers.append(WFDPeer(
+            address=address, name=name, details=f"sink_rtsp_port={sink_port}",
+            path=peer_path, source="NetworkManager", rtsp_port=sink_port,
+        ))
+    return peers
