+class GuardedLaunchContractTest(unittest.TestCase):
+    def parse(self, *extra):
+        arguments = [
+            "--omacast-session", SESSION,
+            "--protocol", "wfd", "--output-res", "1280x720",
+            "--fps", "60", "--bitrate", "7M",
+            "--wfd-video-encoder", "vaapi",
