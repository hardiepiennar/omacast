+            "--wfd-capture-backend", "gpu-screen-recorder",
+            "--wfd-audio-device", "sink.monitor",
+            "--wfd-progress-log", f"/proc/{os.getpid()}/fd/10",
+            "--wfd-latency-log", f"/proc/{os.getpid()}/fd/11",
+            "--wfd-supplicant-network-trigger",
+            f"/run/omarchy-cast/{SESSION}/user/trigger",
+            "--wfd-supplicant-broker",
+            f"/run/omarchy-cast/{SESSION}/supplicant.sock",
+            "--wfd-supplicant-hold", "45",
+            *extra,
+        ]
+        with mock.patch.object(sys, "argv", ["fluxcast", *arguments]):
+            return main.parse_args()
+
+    def test_exact_controller_contract_is_accepted(self):
+        with mock.patch("main.os.getppid", return_value=os.getpid()):
+            main._validate_omacast_session(self.parse())
+
+    def test_unguarded_stream_is_rejected(self):
+        with mock.patch.object(sys, "argv", ["fluxcast"]):
+            args = main.parse_args()
+        with self.assertRaisesRegex(WFDNotReady, "guarded session"):
+            main._validate_omacast_session(args)
+
+    def test_receiver_must_be_an_exact_mac(self):
+        args = self.parse()
+        args.wfd_peer = "Living Room TV"
+        with mock.patch("main.os.getppid", return_value=os.getpid()), self.assertRaisesRegex(
+            WFDNotReady, "MAC address"
+        ):
+            main._validate_omacast_session(args)
+
+    def test_controller_outputs_must_be_parent_descriptors(self):
+        args = self.parse()
+        args.wfd_progress_log = "/tmp/progress"
+        with mock.patch("main.os.getppid", return_value=os.getpid()), self.assertRaisesRegex(
+            WFDNotReady, "owned by the controller"
+        ):
+            main._validate_omacast_session(args)
+
+    def test_removed_routes_are_parser_errors(self):
+        for option in ("--wfd-test-pattern", "--wfd-dry-run", "--wfd-dump-ts"):
+            with self.subTest(option=option), contextlib.redirect_stderr(io.StringIO()):
+                with mock.patch.object(sys, "argv", ["fluxcast", option]), self.assertRaises(SystemExit):
+                    main.parse_args()
+
+
+class SupportedPipelineTest(unittest.TestCase):
+    def test_start_has_only_the_gpu_screen_recorder_route(self):
