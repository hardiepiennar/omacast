diff --git a/src/json_bounds.py b/src/json_bounds.py
new file mode 100644
index 0000000..5f31d49
--- /dev/null
+++ b/src/json_bounds.py
@@ -0,0 +1,46 @@
+"""Small iterative JSON shape budgets for shipped command boundaries."""
+
+import math
+
+
+def json_shape_is_bounded(
+    value,
+    *,
+    max_depth: int = 16,
+    max_nodes: int = 4096,
+    max_collection: int = 256,
+    max_string: int = 4096,
+) -> bool:
+    """Return whether a decoded JSON value fits the closed resource budget."""
+    stack = [(value, 0)]
+    nodes = 0
+    while stack:
+        current, depth = stack.pop()
+        nodes += 1
+        if nodes > max_nodes or depth > max_depth:
+            return False
+        if current is None or type(current) is bool or type(current) is int:
+            continue
+        if type(current) is float:
+            if not math.isfinite(current):
+                return False
+            continue
+        if type(current) is str:
+            if len(current) > max_string:
+                return False
+            continue
+        if type(current) is list:
+            if len(current) > max_collection:
+                return False
+            stack.extend((item, depth + 1) for item in current)
+            continue
+        if type(current) is dict:
+            if len(current) > max_collection:
+                return False
+            for key, item in current.items():
+                if type(key) is not str or len(key) > max_string:
+                    return False
+                stack.append((item, depth + 1))
+            continue
+        return False
+    return True
diff --git a/src/wfd/p2p/broker.py b/src/wfd/p2p/broker.py
index 627e75a..0fdfbe6 100644
--- a/src/wfd/p2p/broker.py
+++ b/src/wfd/p2p/broker.py
@@ -4,13 +4,17 @@ import re
 import socket
 import stat
 
+from json_bounds import json_shape_is_bounded
 from ..config import WFDNotReady
 
 
 _BROKER_PATH = re.compile(r"^/run/omarchy-cast/[a-f0-9]{32}/supplicant\.sock$")
+_INTERFACE = re.compile(r"^[A-Za-z0-9_.-]{1,64}$")
 
 
 def broker_request(path: str, operation: str, *, timeout: float) -> dict:
+    if operation not in {"connect", "cleanup"}:
+        raise WFDNotReady("The supplicant broker operation is unsupported.")
     if not _BROKER_PATH.fullmatch(path):
         raise WFDNotReady("The supplicant broker path is outside the guarded session.")
     try:
@@ -45,20 +49,38 @@ def broker_request(path: str, operation: str, *, timeout: float) -> dict:
         raise WFDNotReady("The supplicant broker returned an incomplete response.")
     try:
         payload = json.loads(response)
-    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as exc:
         raise WFDNotReady("The supplicant broker returned invalid JSON.") from exc
     if (
         not isinstance(payload, dict)
+        or not json_shape_is_bounded(payload, max_depth=8, max_nodes=64, max_collection=8, max_string=256)
         or set(payload) != {"schemaVersion", "kind", "ok", "result", "error"}
+        or type(payload.get("schemaVersion")) is not int
         or payload.get("schemaVersion") != 1
         or payload.get("kind") != "omarchy-cast-supplicant-response"
-        or not isinstance(payload.get("ok"), bool)
+        or type(payload.get("ok")) is not bool
     ):
         raise WFDNotReady("The supplicant broker returned an invalid response.")
     if payload["ok"] is not True:
         detail = payload.get("error")
+        if payload.get("result") is not None or not isinstance(detail, str):
+            raise WFDNotReady("The supplicant broker returned an invalid response.")
         raise WFDNotReady(detail if isinstance(detail, str) and detail else "The supplicant broker refused the request.")
     result = payload.get("result")
-    if not isinstance(result, dict):
-        raise WFDNotReady("The supplicant broker omitted its result.")
+    if payload.get("error") is not None or not isinstance(result, dict):
+        raise WFDNotReady("The supplicant broker returned an invalid response.")
+    if operation == "cleanup":
+        if set(result) != {"cleaned"} or result.get("cleaned") is not True:
+            raise WFDNotReady("The supplicant broker returned invalid cleanup status.")
+    else:
+        if set(result) != {"group"} or not isinstance(result.get("group"), dict):
+            raise WFDNotReady("The supplicant broker returned invalid group status.")
+        group = result["group"]
+        if (
+            set(group) != {"interface", "role"}
+            or not isinstance(group.get("interface"), str)
+            or not _INTERFACE.fullmatch(group["interface"])
+            or group.get("role") not in {"client", "GO"}
+        ):
+            raise WFDNotReady("The supplicant broker returned invalid group status.")
     return result
