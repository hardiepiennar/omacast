+        encoder_args = (
+            ["-c:v", "h264_vaapi", "-rc_mode", "CBR", "-quality", "7", "-aud", "1"]
+            if use_vaapi
+            else ["-c:v", "libx264", "-preset", "ultrafast" if out_h > 1080 else "veryfast", "-tune", "zerolatency"]
+        )
         ffmpeg_cmd += [
