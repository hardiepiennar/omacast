+    def test_window_portal_requests_only_a_window_and_uses_vaapi(self):
+        class Sess:
+            session_handle, pw_node_id, pw_fd, restore_token = "/h", 7, 42, None
+            source_type, position, size = 2, None, (1896, 1030)
+            stream_label, runtime, bus = "window", None, None
+
+        class Proc:
+            pid = 4242
+            stdout = io.BytesIO()
+            def poll(self): return None
+            def terminate(self): pass
+
+        captured = []
+        config = wfd.WFDMediaConfig(
+            monitor=None, output_resolution="1280x720", fps=30,
+            bitrate="7M", no_audio=True, capture_backend="portal",
+            portal_source="window", video_encoder="vaapi",
+        )
+        pipeline = wfd.WFDMediaPipeline(
+            config, tv_ip="10.42.0.2", local_ip="10.42.0.1",
+            sink_rtp_port=35034,
+        )
+        with (
+            mock.patch.object(wfd.shutil, "which", return_value="/usr/bin/tool"),
+            patch_all("_gst_has_element", return_value=True),
+            patch_all("_gst_pipewiresrc_properties", return_value=set()),
+            patch_all("_pipewiresrc_selector_attempts", return_value=[("path", ["path=7"])]),
+            patch_all("start_portal_capture", return_value=Sess()) as start,
+            patch_all("_process_written_bytes", return_value=None),
+            mock.patch("wfd.media.portal.Path.glob", return_value=[Path("/dev/dri/renderD129")]),
+            mock.patch.object(wfd.subprocess, "Popen", side_effect=lambda cmd, *a, **k: (captured.append(list(cmd)), Proc())[1]),
+            mock.patch.object(wfd.time, "sleep"),
+            contextlib.redirect_stdout(io.StringIO()),
+        ):
+            pipeline._start_desktop_portal_ffmpeg()
+
+        self.assertEqual(start.call_args.kwargs["source_types"], 2)
+        ffmpeg = next(command for command in captured if command[0] == "ffmpeg")
+        self.assertEqual(ffmpeg[ffmpeg.index("-vaapi_device") + 1], "/dev/dri/renderD129")
+        self.assertEqual(ffmpeg[ffmpeg.index("-c:v") + 1], "h264_vaapi")
+        self.assertIn("format=nv12,hwupload", ffmpeg[ffmpeg.index("-vf") + 1])
+
+    def test_window_portal_rejects_unproven_source_metadata(self):
+        for source_type in (None, 1, 4):
+            session = SimpleNamespace(source_type=source_type)
+            config = wfd.WFDMediaConfig(monitor=None, portal_source="window")
+            pipeline = wfd.WFDMediaPipeline(config, tv_ip="10.42.0.2", local_ip="10.42.0.1", sink_rtp_port=35034)
+            with (
+                patch_all("start_portal_capture", return_value=session),
+                patch_all("close_portal_capture"),
+                self.assertRaisesRegex(wfd.WFDNotReady, "wrong source type"),
+            ):
+                pipeline._open_portal_session(None)
+
 def _sequence(values):
     """Yield the given values, then repeat the last one forever."""
     state = list(values)
