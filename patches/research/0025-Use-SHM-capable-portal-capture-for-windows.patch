                 "-c:a", "aac", "-profile:a", "aac_low",
@@ -151,6 +177,8 @@ class PortalMixin:
         print(f"[FluxCast WFD Media] Pipeline             : portal->ffmpeg (AOSP TS)")
         source = f"{session.size[0]}x{session.size[1]}" if session.size else "unknown"
