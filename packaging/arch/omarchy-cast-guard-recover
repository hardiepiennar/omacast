#!/usr/bin/env bash
# Independent, bounded cleanup for a helper that was killed or orphaned.
set -euo pipefail
[[ ${EUID} -eq 0 && $# -eq 7 ]] || exit 2
startup_seconds="$1"; lease_seconds="$2"; session="$3"; token="$4"; uid="$5"; interface="$6"; nm_pid="$7"
[[ "$startup_seconds" =~ ^[0-9]+$ && "$lease_seconds" =~ ^[0-9]+$ && "$lease_seconds" -ge 60 && "$lease_seconds" -le 1800 && "$session" =~ ^[a-f0-9]{32}$ && "$token" =~ ^[a-f0-9]{48}$ && "$uid" =~ ^[1-9][0-9]{3,9}$ && "$interface" =~ ^[A-Za-z0-9_.-]{1,15}$ && "$nm_pid" =~ ^[0-9]+$ ]] || exit 2
root="/run/omarchy-cast/$session"; user_root="/run/user/$uid/omarchy-cast/$session"; telemetry_root="/run/user/$uid/omarchy-cast/telemetry/$session"; token_file="$root/token"; heartbeat_file="$user_root/heartbeat"; network_root='/run/systemd/network'; networkd_state_file="$root/networkd-units"; network_root_marker="$root/network-root-created"
started="$EPOCHSECONDS"
while [[ -r "$token_file" && "$(<"$token_file")" == "$token" ]]; do
  if [[ -f "$heartbeat_file" && ! -L "$heartbeat_file" && "$(stat -c '%u:%a' "$heartbeat_file" 2>/dev/null)" == "$uid:600" ]]; then
    renewed="$(<"$heartbeat_file")"
    if [[ ! "$renewed" =~ ^[0-9]+$ ]] || (( EPOCHSECONDS < renewed || EPOCHSECONDS - renewed > lease_seconds )); then break; fi
  elif (( EPOCHSECONDS - started > startup_seconds )); then
    break
  fi
  sleep 1
done
[[ -r "$token_file" && "$(<"$token_file")" == "$token" ]] || exit 0
kill -CONT "$nm_pid" 2>/dev/null || true
if command -v ufw >/dev/null && ufw status | grep -Fq "omarchy-cast-$session"; then ufw --force delete allow in on "p2p-$interface+" to any port 7236 proto tcp >/dev/null 2>&1 || true; fi
remove_network_root=false; [[ -f "$network_root_marker" ]] && remove_network_root=true
rm -f -- "$network_root/80-omarchy-cast-$session.network" "/etc/dbus-1/system.d/zz-omarchy-cast-$session.conf" "$root/ready.json" "$user_root/trigger" "$heartbeat_file" "$user_root/stop"
rm -f -- "$telemetry_root/current.json" "$telemetry_root/ffmpeg.progress" "$telemetry_root/mux-packets.csv" "$telemetry_root/engine.jsonl" "$telemetry_root/engine.log" "$telemetry_root/qos.pid"
rmdir --ignore-fail-on-non-empty "$telemetry_root" 2>/dev/null || true
systemctl reload dbus.service 2>/dev/null || true
if [[ -f "$networkd_state_file" && ! -L "$networkd_state_file" && "$(stat -c '%u:%a' "$networkd_state_file" 2>/dev/null)" == '0:600' ]]; then
  while read -r unit state; do [[ "$state" == inactive ]] && systemctl stop "$unit" 2>/dev/null || true; done < "$networkd_state_file"
  while read -r unit state; do [[ "$state" == active ]] && systemctl start "$unit" 2>/dev/null || true; done < "$networkd_state_file"
  ! systemctl is-active --quiet systemd-networkd.service || systemctl reload systemd-networkd.service
fi
rm -f -- "$networkd_state_file" "$network_root_marker" "$token_file"
rmdir --ignore-fail-on-non-empty "$root" "$user_root" 2>/dev/null || true
[[ "$remove_network_root" == true ]] && rmdir "$network_root" 2>/dev/null || true
