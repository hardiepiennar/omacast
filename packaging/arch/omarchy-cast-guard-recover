#!/usr/bin/env bash
# Independent, bounded cleanup for a helper that was killed or orphaned.
set -euo pipefail
[[ ${EUID} -eq 0 && $# -eq 6 ]] || exit 2
readonly status_ack_timeout_seconds=15
startup_seconds="$1"; lease_seconds="$2"; session="$3"; token="$4"; uid="$5"; interface="$6"
readonly max_p2p_interfaces=64 max_interfaces_file_bytes=1024
[[ "$startup_seconds" =~ ^[0-9]{2,4}$ && "$startup_seconds" -ge 60 && "$startup_seconds" -le 600 && "$lease_seconds" =~ ^[0-9]{2,4}$ && "$lease_seconds" -ge 60 && "$lease_seconds" -le 1800 && "$session" =~ ^[a-f0-9]{32}$ && "$token" =~ ^[a-f0-9]{48}$ && "$uid" =~ ^[1-9][0-9]{3,9}$ && "$interface" =~ ^[A-Za-z0-9_.-]{1,15}$ ]] || exit 2
root="/run/omarchy-cast/$session"; user_root="$root/user"; token_file="$root/token"; ready_file="$root/status.json"; status_ack_file="$user_root/status-ack"; trigger_file="$user_root/trigger"; heartbeat_file="$user_root/heartbeat"; stop_file="$user_root/stop"; heartbeat_fd=''; network_root='/run/systemd/network'; network_file="$network_root/80-omarchy-cast-$session.network"; networkd_state_file="$root/networkd-units"; networkd_state_pending_file="$root/networkd-units.pending"; network_root_marker="$root/network-root-created"; interfaces_file="$root/p2p-interfaces"; interfaces_armed_file="$root/p2p-armed"; network_manager_resume_file="$root/network-manager-resume-required"; recovery_ready_file="$root/recovery-ready"; broker_unit="omarchy-cast-supplicant-$session.service"; broker_socket="$root/supplicant.sock"; broker_wfd_file="$root/supplicant-wfd-owned"; recovery_cleanup_ok=true
publish_status() {
  local ok="$1" phase="$2" error="${3:-null}" payload temporary="$root/.status.$BASHPID"
  payload="$(printf '{"schemaVersion":1,"kind":"omarchy-cast-guard-status","ok":%s,"phase":"%s","sessionId":"%s","error":%s}' "$ok" "$phase" "$session" "$error")"
  (umask 077; printf '%s\n' "$payload" > "$temporary") || return 1
  chmod 644 "$temporary" || { rm -f -- "$temporary"; return 1; }
  mv -T -- "$temporary" "$ready_file" || { rm -f -- "$temporary"; return 1; }
}
status_ack_valid() {
  local metadata
  [[ -f "$status_ack_file" && ! -L "$status_ack_file" ]] || return 1
  metadata="$(stat -c '%u:%a:%h:%s' "$status_ack_file" 2>/dev/null)" || return 1
  [[ "$metadata" == "$uid:600:1:0" ]]
}
finalize_status() {
  local deadline=$((SECONDS + status_ack_timeout_seconds))
  while (( SECONDS <= deadline )); do status_ack_valid && break; sleep 0.1; done
  status_ack_valid && rm -f -- "$status_ack_file" || true
  rm -f -- "$ready_file" || true
  rmdir --ignore-fail-on-non-empty "$user_root" "$root" 2>/dev/null || true
}
valid_recorded_interface() { [[ "$1" =~ ^[A-Za-z0-9_.-]{1,15}$ ]]; }
bounded_session_interfaces() {
  timeout --signal=KILL 5s iw dev | awk -v prefix="p2p-$interface-" -v limit="$max_p2p_interfaces" '
    $1 == "Interface" && index($2, prefix) == 1 { print $2; if (++count > limit) exit }
  '
}
interfaces_file_valid() {
  local metadata owner mode size
  [[ -f "$interfaces_file" && ! -L "$interfaces_file" ]] || return 1
  metadata="$(stat -c '%u:%a:%s' "$interfaces_file" 2>/dev/null)" || return 1
  IFS=: read -r owner mode size <<< "$metadata"
  [[ "$owner" == "$EUID" && "$mode" == 600 && "$size" =~ ^[0-9]{1,4}$ ]] || return 1
  (( size <= max_interfaces_file_bytes ))
}
record_session_interfaces() {
  local candidate listed existing_count=0
  local -A seen=()
  interfaces_file_valid || return 1
  while IFS= read -r candidate; do
    (( ++existing_count <= max_p2p_interfaces )) || return 1
    [[ -n "$candidate" && "$candidate" == "p2p-$interface-"* ]] || return 1
    valid_recorded_interface "$candidate" || return 1
    seen["$candidate"]=1
  done < "$interfaces_file"
  listed="$(bounded_session_interfaces)" || return 1
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    valid_recorded_interface "$candidate" || return 1
    [[ -n "${seen[$candidate]:-}" ]] && continue
    (( ${#seen[@]} < max_p2p_interfaces )) || return 1
    printf '%s\n' "$candidate" >> "$interfaces_file" || return 1
    seen["$candidate"]=1
  done <<< "$listed"
  interfaces_file_valid
}
remove_session_interfaces() {
  local owned details type removed all_removed=true count=0
  interfaces_file_valid || return 1
  while IFS= read -r owned; do
    (( ++count <= max_p2p_interfaces )) || return 1
    if [[ -z "$owned" || "$owned" != "p2p-$interface-"* ]] || ! valid_recorded_interface "$owned"; then all_removed=false; continue; fi
    if ! details="$(iw dev "$owned" info 2>/dev/null)"; then continue; fi
    type="$(awk '$1 == "type" {print $2; exit}' <<< "$details")"
    if [[ "$type" != P2P-client ]]; then all_removed=false; continue; fi
    removed=false
    for _ in 1 2 3; do
      iw dev "$owned" del 2>/dev/null || true
      if ! iw dev "$owned" info >/dev/null 2>&1; then removed=true; break; fi
      sleep 0.1
    done
    [[ "$removed" == true ]] || all_removed=false
  done < "$interfaces_file"
  [[ "$all_removed" == true ]]
}
open_heartbeat() {
  local metadata kind owner mode size
  [[ -e "$heartbeat_file" && ! -L "$heartbeat_file" ]] || return 1
  exec {heartbeat_fd}<>"$heartbeat_file" 2>/dev/null || return 1
  metadata="$(stat -Lc '%F:%u:%a:%s' "/proc/self/fd/$heartbeat_fd" 2>/dev/null)" || { exec {heartbeat_fd}>&-; heartbeat_fd=''; return 1; }
  IFS=: read -r kind owner mode size <<< "$metadata"
  if [[ "$kind" != 'regular file' || "$owner" != "$uid" || "$mode" != 600 || ! "$size" =~ ^[0-9]{1,2}$ ]] || (( size > 32 )); then
    exec {heartbeat_fd}>&-
    heartbeat_fd=''
    return 1
  fi
}
lease_fresh() {
  local renewed
  [[ -n "$heartbeat_fd" ]] || open_heartbeat || return 1
  IFS= read -r -n 32 -t 0.1 renewed < "/proc/self/fd/$heartbeat_fd" || return 1
  [[ "$renewed" =~ ^[0-9]{1,12}$ ]] && (( EPOCHSECONDS >= renewed && EPOCHSECONDS - renewed <= lease_seconds ))
}
network_manager_marker_valid() { [[ -f "$network_manager_resume_file" && ! -L "$network_manager_resume_file" && "$(stat -c '%u:%a' "$network_manager_resume_file" 2>/dev/null)" == "$EUID:600" ]]; }
resume_network_manager() { network_manager_marker_valid || { [[ ! -e "$network_manager_resume_file" ]] && return 0; return 1; }; for _ in 1 2 3; do if systemctl kill --kill-whom=main --signal=SIGCONT NetworkManager.service; then rm -f -- "$network_manager_resume_file" || return 1; return 0; fi; sleep 0.1; done; return 1; }
restore_networkd_state() {
  [[ -f "$networkd_state_file" && ! -L "$networkd_state_file" && "$(stat -c '%u:%a' "$networkd_state_file" 2>/dev/null)" == '0:600' ]] || return 1
  local unit state
  while read -r unit state; do [[ "$state" == inactive ]] && systemctl stop "$unit" 2>/dev/null || true; done < "$networkd_state_file"
  while read -r unit state; do [[ "$state" == active ]] && systemctl start "$unit" 2>/dev/null || true; done < "$networkd_state_file"
  ! systemctl is-active --quiet systemd-networkd.service || systemctl reload systemd-networkd.service
}
remove_recovery_file() { if ! rm -f -- "$1"; then recovery_cleanup_ok=false; fi; return 0; }
remove_broker_socket() {
  [[ ! -e "$broker_socket" && ! -L "$broker_socket" ]] && return 0
  [[ -S "$broker_socket" && ! -L "$broker_socket" && "$(stat -c '%u:%a' "$broker_socket" 2>/dev/null)" == "$uid:600" ]] || return 1
  rm -f -- "$broker_socket"
}
clear_owned_wfd_ies() {
  local current expected='0x00 0x00 0x06 0x00 0x10 0x1c 0x44 0x00 0xc8'
  [[ ! -e "$broker_wfd_file" ]] && return 0
  [[ -f "$broker_wfd_file" && ! -L "$broker_wfd_file" && "$(stat -c '%u:%a' "$broker_wfd_file" 2>/dev/null)" == "$EUID:600" ]] || return 1
  current="$(gdbus call --system --dest fi.w1.wpa_supplicant1 --object-path /fi/w1/wpa_supplicant1 --method org.freedesktop.DBus.Properties.Get fi.w1.wpa_supplicant1 WFDIEs 2>/dev/null | { grep -oE '0x[0-9A-Fa-f]{2}' || true; } | tr '[:upper:]' '[:lower:]' | paste -sd ' ' -)" || return 1
  if [[ -z "$current" ]]; then rm -f -- "$broker_wfd_file"; return; fi
  [[ "$current" == "$expected" ]] || return 1
  gdbus call --system --dest fi.w1.wpa_supplicant1 --object-path /fi/w1/wpa_supplicant1 --method org.freedesktop.DBus.Properties.Set fi.w1.wpa_supplicant1 WFDIEs '<@ay []>' >/dev/null || return 1
  rm -f -- "$broker_wfd_file"
}
recovery_identity_valid() {
  [[ -d "$root" && ! -L "$root" && "$(stat -c '%u:%a' "$root" 2>/dev/null)" == "$EUID:711" ]] || return 1
  [[ -d "$user_root" && ! -L "$user_root" && "$(stat -c '%u:%a' "$user_root" 2>/dev/null)" == "$uid:700" ]] || return 1
  [[ -f "$token_file" && ! -L "$token_file" && "$(stat -c '%u:%a' "$token_file" 2>/dev/null)" == "$EUID:600" ]] || return 1
  [[ "$(<"$token_file")" == "$token" ]]
}
publish_recovery_ready() {
  recovery_identity_valid || return 1
  [[ ! -e "$recovery_ready_file" && ! -L "$recovery_ready_file" ]] || return 1
  install -m600 /dev/null "$recovery_ready_file" || return 1
  [[ -f "$recovery_ready_file" && ! -L "$recovery_ready_file" && "$(stat -c '%u:%a' "$recovery_ready_file" 2>/dev/null)" == "$EUID:600" ]]
}
recover_session() {
  local remove_network_root=false interface_cleanup_ok=true networkd_cleanup_ok=true broker_cleanup_ok=true _
  for _ in 1 2 3; do systemctl is-active --quiet "$broker_unit" || break; systemctl stop "$broker_unit" 2>/dev/null || true; sleep 0.1; done
  if systemctl is-active --quiet "$broker_unit"; then broker_cleanup_ok=false; recovery_cleanup_ok=false; fi
  if [[ "$broker_cleanup_ok" == true ]]; then remove_broker_socket || recovery_cleanup_ok=false; clear_owned_wfd_ies || recovery_cleanup_ok=false; fi
  if [[ -f "$interfaces_armed_file" && ! -L "$interfaces_armed_file" && "$(stat -c '%u:%a' "$interfaces_armed_file" 2>/dev/null)" == "$EUID:600" ]]; then
    record_session_interfaces || interface_cleanup_ok=false
    remove_session_interfaces || interface_cleanup_ok=false
  fi
  resume_network_manager || recovery_cleanup_ok=false
  if command -v ufw >/dev/null && ufw status | grep -Fq "omarchy-cast-$session"; then
    ufw --force delete allow in on "p2p-$interface+" to any port 7236 proto tcp >/dev/null 2>&1 || recovery_cleanup_ok=false
  fi
  [[ -f "$network_root_marker" ]] && remove_network_root=true

  remove_recovery_file "$network_file"
  remove_recovery_file "$trigger_file"
  remove_recovery_file "$heartbeat_file"
  remove_recovery_file "$stop_file"
  if [[ -e "$networkd_state_file" ]] && ! restore_networkd_state; then recovery_cleanup_ok=false; networkd_cleanup_ok=false; fi

  remove_recovery_file "$networkd_state_pending_file"
  if [[ "$networkd_cleanup_ok" == true ]]; then
    remove_recovery_file "$networkd_state_file"
    remove_recovery_file "$network_root_marker"
  fi
  if [[ "$interface_cleanup_ok" == true ]]; then
    remove_recovery_file "$interfaces_armed_file"
    remove_recovery_file "$interfaces_file"
  else
    recovery_cleanup_ok=false
  fi
  if [[ "$recovery_cleanup_ok" == true ]]; then remove_recovery_file "$recovery_ready_file"; fi
  if [[ "$recovery_cleanup_ok" == true ]]; then remove_recovery_file "$token_file"; fi
  [[ "$remove_network_root" == true ]] && rmdir "$network_root" 2>/dev/null || true
  return 0
}
started="$EPOCHSECONDS"
publish_recovery_ready || exit 1
while [[ -r "$token_file" && "$(<"$token_file")" == "$token" ]]; do
  if [[ -n "$heartbeat_fd" ]] || open_heartbeat; then
    lease_fresh || break
  elif (( EPOCHSECONDS - started > startup_seconds )); then
    break
  fi
  sleep 1
done
[[ -r "$token_file" && "$(<"$token_file")" == "$token" ]] || exit 0
recover_session
if [[ "$recovery_cleanup_ok" == true ]]; then
  publish_status true cleaned null
else
  publish_status false error '"independent session recovery was incomplete"'
fi
finalize_status
[[ "$recovery_cleanup_ok" == true ]]
