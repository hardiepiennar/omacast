#!/usr/bin/env python3
"""Session-scoped root broker for Omacast's two supplicant operations."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import selectors
import signal
import socket
import stat
import subprocess
import threading
import time


SCHEMA_VERSION = 1
MAX_REQUEST = 1024
MAX_COMMAND_OUTPUT = 65_536
MAX_OBJECT_PATHS = 256
MAX_VARIANT_BYTES = 4_096
MAX_MONITOR_LINE = 4_096
MAX_MONITOR_LINES = 1_024
MAX_MONITOR_STDERR = 4_096
MONITOR_START_TIMEOUT_SECONDS = 3.0
NETWORK_ARM_TIMEOUT_SECONDS = 10.0
WPA_DEST = "fi.w1.wpa_supplicant1"
WPA_ROOT = "/fi/w1/wpa_supplicant1"
WPA_IFACE = "fi.w1.wpa_supplicant1.Interface"
WPA_P2P = f"{WPA_IFACE}.P2PDevice"
WPA_PEER = "fi.w1.wpa_supplicant1.Peer"
WPA_GROUP = "fi.w1.wpa_supplicant1.Group"
SESSION_RE = re.compile(r"^[a-f0-9]{32}$")
INTERFACE_RE = re.compile(r"^[A-Za-z0-9_.-]{1,15}$")
PEER_RE = re.compile(r"^(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$")
PIN_RE = re.compile(r"^[0-9]{8}$")


class BrokerError(RuntimeError):
    pass


def object_paths(text: str) -> list[str]:
    paths: list[str] = []
    for match in re.finditer(r"(?:objectpath )?['\"](/[^'\"]{1,512})['\"]", text):
        if len(paths) >= MAX_OBJECT_PATHS:
            raise BrokerError("supplicant returned too many object paths")
        paths.append(match.group(1))
    return paths


def byte_values(text: str) -> list[int]:
    values: list[int] = []
    for match in re.finditer(r"0x([0-9A-Fa-f]{1,2})", text):
        if len(values) >= MAX_VARIANT_BYTES:
            raise BrokerError("supplicant returned too many byte values")
        values.append(int(match.group(1), 16))
    return values


def validate_json_budget(value: object) -> None:
    pending = [(value, 0)]
    nodes = 0
    while pending:
        item, depth = pending.pop()
        nodes += 1
        if nodes > 32 or depth > 4:
            raise BrokerError("broker request exceeds its JSON shape limit")
        if isinstance(item, str):
            if len(item) > 64:
                raise BrokerError("broker request contains an oversized string")
        elif isinstance(item, dict):
            if len(item) > 8:
                raise BrokerError("broker request contains too many fields")
            pending.extend((child, depth + 1) for child in item.values())
        elif isinstance(item, list):
            if len(item) > 8:
                raise BrokerError("broker request contains too many values")
            pending.extend((child, depth + 1) for child in item)
        elif item is not None and type(item) not in {bool, int, float}:
            raise BrokerError("broker request contains an unsupported value")


def run_bounded(arguments: list[str], *, timeout: float) -> tuple[int, str, str]:
    """Drain both child pipes while retaining a fixed maximum from each."""
    process = subprocess.Popen(
        arguments,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        close_fds=True,
        start_new_session=True,
    )
    if process.stdout is None or process.stderr is None:
        process.kill()
        try:
            process.wait(timeout=1.0)
        except subprocess.TimeoutExpired:
            pass
        raise BrokerError("supplicant command did not expose bounded output pipes")
    streams = {process.stdout: bytearray(), process.stderr: bytearray()}
    selector = selectors.DefaultSelector()
    for stream in streams:
        os.set_blocking(stream.fileno(), False)
        selector.register(stream, selectors.EVENT_READ)
    deadline = time.monotonic() + timeout
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(arguments, timeout)
            events = selector.select(min(remaining, 0.1))
            if not events and process.poll() is not None:
                events = [(key, selectors.EVENT_READ) for key in selector.get_map().values()]
            for key, _mask in events:
                stream = key.fileobj
                try:
                    chunk = os.read(stream.fileno(), 8192)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(stream)
                    continue
                retained = streams[stream]
                if len(retained) + len(chunk) > MAX_COMMAND_OUTPUT:
                    raise BrokerError("supplicant command output exceeded its limit")
                retained.extend(chunk)
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise subprocess.TimeoutExpired(arguments, timeout)
        returncode = process.wait(timeout=remaining)
    except BaseException:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        try:
            process.wait(timeout=1.0)
        except subprocess.TimeoutExpired:
            pass
        raise
    finally:
        selector.close()
        process.stdout.close()
        process.stderr.close()
    stdout = bytes(streams[process.stdout]).decode("utf-8", errors="replace")
    stderr = bytes(streams[process.stderr]).decode("utf-8", errors="replace")
    return returncode, stdout, stderr


def call(arguments: list[str], *, timeout: float = 5.0) -> str:
    try:
        returncode, stdout, stderr = run_bounded(
            ["gdbus", "call", "--system", *arguments], timeout=timeout
        )
    except subprocess.TimeoutExpired as exc:
        raise BrokerError("supplicant request timed out") from exc
    if returncode != 0:
        detail = (stderr or stdout).strip()
        raise BrokerError(detail[:512] or "supplicant request failed")
    return stdout.strip()


def get_property(path: str, interface: str, name: str) -> str:
    return call([
        "--dest", WPA_DEST,
        "--object-path", path,
        "--method", "org.freedesktop.DBus.Properties.Get",
        interface, name,
    ])


def set_property(path: str, interface: str, name: str, value: str) -> None:
    call([
        "--dest", WPA_DEST,
        "--object-path", path,
        "--method", "org.freedesktop.DBus.Properties.Set",
        interface, name, value,
    ])


def source_wfd_ies() -> bytes:
    port = 7236
    return bytes((0, 0, 6, 0, 0x10, port >> 8, port & 0xFF, 0, 0xC8))


def byte_variant(data: bytes) -> str:
    return "<@ay [" + ", ".join(f"byte 0x{value:02x}" for value in data) + "]>"


def validate_pairing_pin(value: object) -> str:
    if type(value) is not str or not PIN_RE.fullmatch(value):
        raise BrokerError("pairing PIN must contain exactly eight digits")
    accumulator = 0
    prefix = int(value[:7])
    while prefix:
        accumulator += 3 * (prefix % 10)
        prefix //= 10
        accumulator += prefix % 10
        prefix //= 10
    if (10 - accumulator % 10) % 10 != int(value[7]):
        raise BrokerError("pairing PIN checksum is invalid")
    return value


def connect_with_pin(control_path: str, peer_path: str, pin: str, frequency: int) -> None:
    """Call supplicant in-process so the credential never appears in argv."""
    validated = validate_pairing_pin(pin)
    try:
        import dbus

        options = dbus.Dictionary({
            "peer": dbus.ObjectPath(peer_path),
            "persistent": dbus.Boolean(True),
            "join": dbus.Boolean(False),
            "authorize_only": dbus.Boolean(False),
            "go_intent": dbus.Int32(0),
            "wps_method": dbus.String("keypad"),
            "pin": dbus.String(validated),
        }, signature="sv")
        if frequency:
            options["frequency"] = dbus.Int32(frequency)
        interface = dbus.Interface(
            dbus.SystemBus().get_object(WPA_DEST, control_path),
            dbus_interface=WPA_P2P,
        )
        interface.Connect(options, timeout=15.0)
    except BrokerError:
        raise
    except Exception as exc:
        raise BrokerError("supplicant PIN pairing request failed") from exc


def go_negotiation_failure(line: str, *, control_path: str, peer_path: str) -> int | None:
    """Return an exactly attributed P2P status from one bounded gdbus line."""
    signal_name = f"{WPA_P2P}.GONegotiationFailure"
    if signal_name not in line:
        return None
    if len(line) > MAX_MONITOR_LINE or not line.startswith(f"{control_path}: {signal_name} "):
        raise BrokerError("supplicant emitted an invalid negotiation-failure signal")
    peer_match = re.search(r"['\"]peer_object['\"]:\s*<objectpath\s+['\"]([^'\"]{1,512})['\"]>", line)
    status_match = re.search(r"['\"]status['\"]:\s*<(?:int32\s+)?([0-9]{1,3})>", line)
    if peer_match is None or status_match is None:
        raise BrokerError("supplicant emitted an invalid negotiation-failure signal")
    status = int(status_match.group(1))
    if not 1 <= status <= 255:
        raise BrokerError("supplicant emitted an invalid negotiation-failure status")
    if peer_match.group(1) != peer_path:
        return None
    return status


def wps_failure(line: str, *, control_path: str) -> tuple[int, int] | None:
    """Return the current control object's bounded WPS failure details."""
    signal_name = f"{WPA_P2P}.WpsFailed"
    if signal_name not in line:
        return None
    if len(line) > MAX_MONITOR_LINE or not line.startswith(f"{control_path}: {signal_name} "):
        raise BrokerError("supplicant emitted an invalid WPS-failure signal")
    message = re.search(r"['\"]msg['\"]:\s*<(?:int32\s+)?([0-9]{1,5})>", line)
    config = re.search(r"['\"]config_error['\"]:\s*<(?:int16\s+)?([0-9]{1,5})>", line)
    if message is None or config is None:
        raise BrokerError("supplicant emitted an invalid WPS-failure signal")
    values = (int(message.group(1)), int(config.group(1)))
    if any(not 0 <= value <= 65_535 for value in values):
        raise BrokerError("supplicant emitted an invalid WPS-failure value")
    return values


class SupplicantSignalMonitor:
    """Continuously drain a fixed gdbus monitor and retain only bounded state."""

    def __init__(self, *, control_path: str, peer_path: str, watch_wps: bool = False) -> None:
        self.control_path = control_path
        self.peer_path = peer_path
        self.process: subprocess.Popen[bytes] | None = None
        self.threads: list[threading.Thread] = []
        self.ready = threading.Event()
        self.lock = threading.Lock()
        self.error: str | None = None
        self.status: int | None = None
        self.wps_failure: tuple[int, int] | None = None
        self.watch_wps = watch_wps
        self.stderr = bytearray()
        self.closing = False

    def _set_error(self, detail: str) -> None:
        with self.lock:
            if self.error is None:
                self.error = detail

    def _stdout_line(self, raw: bytes) -> None:
        line = raw.decode("utf-8", errors="replace")
        if line.startswith("Monitoring signals on object "):
            self.ready.set()
            return
        try:
            status = go_negotiation_failure(
                line, control_path=self.control_path, peer_path=self.peer_path
            )
        except BrokerError as exc:
            self._set_error(str(exc))
            return
        if status is not None:
            with self.lock:
                if self.status is None:
                    self.status = status
            return
        if self.watch_wps:
            try:
                failure = wps_failure(line, control_path=self.control_path)
            except BrokerError as exc:
                self._set_error(str(exc))
                return
            if failure is not None:
                with self.lock:
                    if self.wps_failure is None:
                        self.wps_failure = failure

    def _drain(self, stream: object, *, stdout: bool) -> None:
        descriptor = stream.fileno()  # type: ignore[attr-defined]
        pending = bytearray()
        lines = 0
        while True:
            try:
                chunk = os.read(descriptor, 4_096)
            except OSError:
                return
            if not chunk:
                break
            if stdout:
                pending.extend(chunk)
                if len(pending) > MAX_MONITOR_LINE and b"\n" not in pending:
                    self._set_error("supplicant signal monitor emitted an oversized line")
                    pending.clear()
                    continue
                while b"\n" in pending:
                    raw, _, remainder = pending.partition(b"\n")
                    pending = bytearray(remainder)
                    lines += 1
                    if lines > MAX_MONITOR_LINES:
                        self._set_error("supplicant signal monitor exceeded its event limit")
                        continue
                    if len(raw) > MAX_MONITOR_LINE:
                        self._set_error("supplicant signal monitor emitted an oversized line")
                        continue
                    self._stdout_line(bytes(raw))
            else:
                remaining = MAX_MONITOR_STDERR - len(self.stderr)
                if remaining > 0:
                    self.stderr.extend(chunk[:remaining])
        if stdout and pending:
            self._set_error("supplicant signal monitor ended with an incomplete line")

    def start(self) -> None:
        self.process = subprocess.Popen(
            [
                "gdbus", "monitor", "--system", "--dest", WPA_DEST,
                "--object-path", self.control_path,
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            close_fds=True,
            start_new_session=True,
        )
        if self.process.stdout is None or self.process.stderr is None:
            self.close()
            raise BrokerError("supplicant signal monitor did not expose bounded pipes")
        self.threads = [
            threading.Thread(target=self._drain, args=(self.process.stdout,), kwargs={"stdout": True}, daemon=True),
            threading.Thread(target=self._drain, args=(self.process.stderr,), kwargs={"stdout": False}, daemon=True),
        ]
        for thread in self.threads:
            thread.start()
        deadline = time.monotonic() + MONITOR_START_TIMEOUT_SECONDS
        while not self.ready.wait(0.05):
            with self.lock:
                error = self.error
            if error is not None or self.process.poll() is not None or time.monotonic() >= deadline:
                detail = error or bytes(self.stderr).decode("utf-8", errors="replace").strip()
                self.close()
                raise BrokerError(detail[:512] or "supplicant signal monitor did not become ready")

    def failure_status(self) -> int | None:
        with self.lock:
            if self.error is not None:
                raise BrokerError(self.error)
            if (
                not self.closing
                and self.process is not None
                and self.process.poll() is not None
            ):
                detail = bytes(self.stderr).decode("utf-8", errors="replace").strip()
                raise BrokerError(detail[:512] or "supplicant signal monitor stopped unexpectedly")
            return self.status

    def pairing_failure(self) -> tuple[int, int] | None:
        with self.lock:
            if self.error is not None:
                raise BrokerError(self.error)
            return self.wps_failure

    def close(self) -> None:
        with self.lock:
            self.closing = True
        process = self.process
        if process is not None and process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                process.wait(timeout=1.0)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                try:
                    process.wait(timeout=1.0)
                except subprocess.TimeoutExpired:
                    self._set_error("supplicant signal monitor did not stop")
        for thread in self.threads:
            thread.join(timeout=1.0)
            if thread.is_alive():
                self._set_error("supplicant signal monitor drain did not stop")
        if process is not None:
            if process.stdout is not None:
                process.stdout.close()
            if process.stderr is not None:
                process.stderr.close()


def negotiation_failure_detail(status: int, *, keypad: bool = False) -> str:
    if status == 10:
        if keypad:
            return (
                "receiver rejected PIN pairing (Wi-Fi Direct status 10: "
                "incompatible provisioning method)"
            )
        return (
            "receiver rejected push-button pairing (Wi-Fi Direct status 10: "
            "incompatible provisioning method); this display may require PIN pairing"
        )
    if status == 11:
        return "receiver rejected the Wi-Fi Direct connection request (status 11)"
    return f"receiver rejected Wi-Fi Direct group negotiation (status {status})"


class SupplicantBroker:
    def __init__(self, *, session: str, uid: int, interface: str, peer: str, frequency: int) -> None:
        self.session = session
        self.uid = uid
        self.interface = interface
        self.peer = peer.lower()
        self.frequency = frequency
        self.root = Path("/run/omarchy-cast") / session
        self.user_root = self.root / "user"
        self.socket_path = self.root / "supplicant.sock"
        self.wfd_marker = self.root / "supplicant-wfd-owned"
        self.armed_marker = self.root / "p2p-armed"
        self.stop = threading.Event()
        self.control_path: str | None = None
        self.peer_path: str | None = None
        self.baseline_groups: frozenset[str] = frozenset()
        self.wfd_owned = False
        self.connect_attempted = False
        self.p2p_mutation_attempted = False

    def validate_session(self) -> None:
        if os.geteuid() != 0:
            raise BrokerError("broker must run as root")
        root = self.root.stat(follow_symlinks=False)
        user = self.user_root.stat(follow_symlinks=False)
        if not stat.S_ISDIR(root.st_mode) or root.st_uid != 0 or stat.S_IMODE(root.st_mode) != 0o711:
            raise BrokerError("protected session directory is unsafe")
        if not stat.S_ISDIR(user.st_mode) or user.st_uid != self.uid or stat.S_IMODE(user.st_mode) != 0o700:
            raise BrokerError("session user directory is unsafe")
        if self.socket_path.exists() or self.socket_path.is_symlink():
            raise BrokerError("broker socket already exists")
        if self.wfd_marker.exists() or self.wfd_marker.is_symlink():
            raise BrokerError("broker ownership marker already exists")

    def resolve_control(self) -> str:
        interfaces = object_paths(get_property(WPA_ROOT, WPA_DEST, "Interfaces"))
        expected = (f"p2p-dev-{self.interface}", self.interface)
        matches: dict[str, str] = {}
        for path in interfaces:
            raw = get_property(path, WPA_IFACE, "Ifname")
            match = re.search(r"<['\"]([^'\"]+)['\"]>", raw)
            if match and match.group(1) in expected:
                matches[match.group(1)] = path
        for name in expected:
            if name in matches:
                return matches[name]
        raise BrokerError("selected adapter has no supplicant P2P control object")

    def network_armed(self) -> bool:
        try:
            marker = self.armed_marker.stat(follow_symlinks=False)
        except OSError:
            return False
        return (
            stat.S_ISREG(marker.st_mode)
            and marker.st_uid == 0
            and stat.S_IMODE(marker.st_mode) == 0o600
        )

    def wait_for_network_arm(self, timeout: float = NETWORK_ARM_TIMEOUT_SECONDS) -> bool:
        """Wait only for the root guard's owned readiness marker."""
        deadline = time.monotonic() + timeout
        while not self.network_armed():
            remaining = deadline - time.monotonic()
            if remaining <= 0 or self.stop.wait(min(0.1, remaining)):
                return False
        return True

    def resolve_peer(self, control_path: str) -> str:
        for path in object_paths(get_property(control_path, WPA_P2P, "Peers")):
            address = byte_values(get_property(path, WPA_PEER, "DeviceAddress"))
            if len(address) >= 6 and ":".join(f"{value:02x}" for value in address[:6]) == self.peer:
                return path
        raise BrokerError("selected receiver is not present on the selected adapter")

    def peer_groups(self, peer_path: str) -> frozenset[str]:
        return frozenset(object_paths(get_property(peer_path, WPA_PEER, "Groups")))

    def group_candidate(self, group_path: str) -> dict[str, str] | None:
        for interface_path in object_paths(get_property(WPA_ROOT, WPA_DEST, "Interfaces")):
            try:
                current = object_paths(get_property(interface_path, WPA_P2P, "Group"))
            except BrokerError:
                continue
            if group_path not in current:
                continue
            raw_name = get_property(interface_path, WPA_IFACE, "Ifname")
            name_match = re.search(r"<['\"]([^'\"]+)['\"]>", raw_name)
            ifname = name_match.group(1) if name_match else ""
            if not INTERFACE_RE.fullmatch(ifname) or (
                ifname != self.interface and not ifname.startswith(f"p2p-{self.interface}-")
            ):
                return None
            raw_role = get_property(group_path, WPA_GROUP, "Role")
            role_match = re.search(r"<['\"]([^'\"]+)['\"]>", raw_role)
            role = role_match.group(1) if role_match else ""
            if role not in {"client", "GO"}:
                return None
            return {"interface": ifname, "role": role}
        return None

    def connect(self, pin: str | None = None) -> dict[str, object]:
        if self.connect_attempted:
            raise BrokerError("this session already consumed its connect operation")
        if not self.wait_for_network_arm():
            raise BrokerError("guarded networking is not active for this session")
        self.connect_attempted = True
        self.control_path = self.resolve_control()
        self.peer_path = self.resolve_peer(self.control_path)
        self.baseline_groups = self.peer_groups(self.peer_path)
        if byte_values(get_property(WPA_ROOT, WPA_DEST, "WFDIEs")):
            raise BrokerError("another Wi-Fi Display owner already configured supplicant")
        marker = os.open(self.wfd_marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        os.close(marker)
        self.wfd_owned = True
        set_property(WPA_ROOT, WPA_DEST, "WFDIEs", byte_variant(source_wfd_ies()))
        pairing_pin = validate_pairing_pin(pin) if pin is not None else None
        options = {
            "peer": f"<objectpath '{self.peer_path}'>",
            "persistent": "<true>",
            "join": "<false>",
            "authorize_only": "<false>",
            "go_intent": "<int32 0>",
            "wps_method": "<'pbc'>",
        }
        if self.frequency:
            options["frequency"] = f"<int32 {self.frequency}>"
        encoded = "{" + ", ".join(f"'{key}': {value}" for key, value in options.items()) + "}"
        monitor = SupplicantSignalMonitor(
            control_path=self.control_path, peer_path=self.peer_path,
            watch_wps=pairing_pin is not None,
        )
        monitor.start()
        try:
            self.p2p_mutation_attempted = True
            if pairing_pin is None:
                call([
                    "--dest", WPA_DEST,
                    "--object-path", self.control_path,
                    "--method", f"{WPA_P2P}.Connect",
                    encoded,
                ], timeout=15.0)
            else:
                connect_with_pin(
                    self.control_path, self.peer_path, pairing_pin, self.frequency
                )
            deadline = time.monotonic() + 45
            while time.monotonic() < deadline and not self.stop.is_set():
                failure = monitor.failure_status()
                if failure is not None:
                    raise BrokerError(negotiation_failure_detail(failure, keypad=pairing_pin is not None))
                if pairing_pin is not None and monitor.pairing_failure() is not None:
                    raise BrokerError("receiver rejected the pairing PIN; check the displayed digits and try again")
                candidates: list[dict[str, str]] = []
                for group_path in self.peer_groups(self.peer_path) - self.baseline_groups:
                    candidate = self.group_candidate(group_path)
                    if candidate is not None:
                        candidates.append(candidate)
                if len(candidates) > 1:
                    raise BrokerError("selected receiver created ambiguous P2P groups")
                if candidates:
                    return {"group": candidates[0]}
                self.stop.wait(0.1)
            if pairing_pin is not None:
                raise BrokerError("timed out waiting for receiver PIN pairing")
            raise BrokerError("timed out waiting for the selected receiver P2P group")
        finally:
            monitor.close()
            late_failure = monitor.failure_status()
            if late_failure is not None:
                raise BrokerError(negotiation_failure_detail(late_failure, keypad=pairing_pin is not None))

    def cleanup(self) -> bool:
        cleaned = True
        if self.control_path is not None and self.p2p_mutation_attempted:
            for member in ("Cancel", "Disconnect"):
                try:
                    call([
                        "--dest", WPA_DEST,
                        "--object-path", self.control_path,
                        "--method", f"{WPA_P2P}.{member}",
                    ], timeout=3.0)
                except Exception:
                    cleaned = False
        if self.wfd_owned:
            try:
                if bytes(byte_values(get_property(WPA_ROOT, WPA_DEST, "WFDIEs"))) != source_wfd_ies():
                    raise BrokerError("supplicant WFD ownership changed before cleanup")
                set_property(WPA_ROOT, WPA_DEST, "WFDIEs", "<@ay []>")
                self.wfd_marker.unlink()
                self.wfd_owned = False
            except Exception:
                cleaned = False
        return cleaned

    @staticmethod
    def response(ok: bool, *, result: object = None, error: str | None = None) -> bytes:
        payload = {
            "schemaVersion": SCHEMA_VERSION,
            "kind": "omarchy-cast-supplicant-response",
            "ok": ok,
            "result": result,
            "error": error,
        }
        return (json.dumps(payload, separators=(",", ":")) + "\n").encode("utf-8")

    def handle(self, connection: socket.socket) -> None:
        connection.settimeout(2)
        request = bytearray()
        while b"\n" not in request and len(request) <= MAX_REQUEST:
            chunk = connection.recv(MAX_REQUEST + 1 - len(request))
            if not chunk:
                break
            request.extend(chunk)
        if len(request) > MAX_REQUEST or not request.endswith(b"\n"):
            raise BrokerError("broker request is oversized or incomplete")
        try:
            payload = json.loads(request)
            validate_json_budget(payload)
        except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as exc:
            raise BrokerError("broker request is not valid JSON") from exc
        if not isinstance(payload, dict) or set(payload) not in (
            {"schemaVersion", "op"}, {"schemaVersion", "op", "pin"},
        ):
            raise BrokerError("broker request has an unexpected shape")
        if type(payload.get("schemaVersion")) is not int or payload.get("schemaVersion") != SCHEMA_VERSION:
            raise BrokerError("broker request schema is unsupported")
        operation = payload.get("op")
        if operation == "connect":
            result = self.connect(
                validate_pairing_pin(payload["pin"]) if "pin" in payload else None
            )
        elif operation == "cleanup":
            if "pin" in payload:
                raise BrokerError("a pairing PIN is accepted only for connection setup")
            cleaned = self.cleanup()
            self.stop.set()
            if not cleaned:
                raise BrokerError("supplicant cleanup was incomplete")
            result = {"cleaned": True}
        else:
            raise BrokerError("broker operation is not permitted")
        connection.sendall(self.response(True, result=result))

    def serve(self) -> None:
        self.validate_session()
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            server.bind(str(self.socket_path))
            os.chown(self.socket_path, self.uid, -1)
            os.chmod(self.socket_path, 0o600)
            server.listen(1)
            server.settimeout(0.2)
            while not self.stop.is_set():
                try:
                    connection, _ = server.accept()
                except TimeoutError:
                    continue
                with connection:
                    try:
                        self.handle(connection)
                    except Exception as exc:
                        try:
                            connection.sendall(self.response(False, error=str(exc)[:512]))
                        except OSError:
                            pass
        finally:
            self.cleanup()
            server.close()
            try:
                self.socket_path.unlink()
            except FileNotFoundError:
                pass


def parse_args() -> argparse.Namespace:
    def decimal(value: str, *, name: str, minimum: int, maximum: int, width: int) -> int:
        if not re.fullmatch(rf"[0-9]{{1,{width}}}", value):
            raise argparse.ArgumentTypeError(f"invalid {name}")
        parsed = int(value)
        if not minimum <= parsed <= maximum:
            raise argparse.ArgumentTypeError(f"invalid {name}")
        return parsed

    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--session", required=True)
    parser.add_argument("--uid", required=True, type=lambda value: decimal(value, name="uid", minimum=1000, maximum=2_147_483_647, width=10))
    parser.add_argument("--interface", required=True)
    parser.add_argument("--peer", required=True)
    parser.add_argument("--frequency", required=True, type=lambda value: decimal(value, name="frequency", minimum=0, maximum=7125, width=4))
    args = parser.parse_args()
    if not SESSION_RE.fullmatch(args.session):
        raise BrokerError("invalid session")
    if not INTERFACE_RE.fullmatch(args.interface):
        raise BrokerError("invalid interface")
    if not PEER_RE.fullmatch(args.peer):
        raise BrokerError("invalid receiver address")
    if args.frequency != 0 and args.frequency < 2300:
        raise BrokerError("invalid P2P frequency")
    return args


def main() -> int:
    try:
        args = parse_args()
        broker = SupplicantBroker(
            session=args.session,
            uid=args.uid,
            interface=args.interface,
            peer=args.peer,
            frequency=args.frequency,
        )
        signal.signal(signal.SIGTERM, lambda _signum, _frame: broker.stop.set())
        signal.signal(signal.SIGINT, lambda _signum, _frame: broker.stop.set())
        broker.serve()
        return 0
    except Exception as exc:
        print(f"omarchy-cast-supplicant-broker: {exc}", file=os.sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
