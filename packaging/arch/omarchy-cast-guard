#!/usr/bin/env bash
# Narrow, package-owned privilege boundary for one WFD network session.
# It accepts no paths, commands, or configuration from the caller.
set -euo pipefail

readonly schema_version=1 status_kind='omarchy-cast-guard-status'
readonly api_revision=17 version_kind='omarchy-cast-guard-version'
readonly run_root='/run/omarchy-cast' network_root='/run/systemd/network'
readonly wait_for_trigger_seconds=300
readonly recovery_ready_timeout_seconds=5
readonly status_ack_timeout_seconds=15
readonly max_privileged_command_output_bytes=65536
readonly max_p2p_interfaces=64 max_interfaces_file_bytes=1024
readonly networkd_units=(systemd-networkd.service systemd-networkd.socket systemd-networkd-varlink.socket systemd-networkd-varlink-metrics.socket systemd-networkd-resolve-hook.socket)
action='' session_id='' uid='' interface='' peer='' frequency='' duration='' backend='' session_root='' user_root='' token_file='' ready_file='' status_ack_file='' stop_file='' trigger_file='' heartbeat_file='' heartbeat_fd='' guard_lock_fd='' network_file='' networkd_state_file='' networkd_state_pending_file='' network_root_marker='' interfaces_file='' interfaces_armed_file='' network_manager_resume_file='' recovery_ready_file='' broker_socket='' broker_unit='' recovery_unit='' broker_wfd_file='' firewalld_marker='' token='' ufw_rule_added=false runtime_dirs_created=false broker_started=false broker_cleanup_ok=true interface_cleanup_ok=true network_manager_cleanup_ok=true cleanup_ok=true network_sys_root='/sys/class/net'

die() { printf '%s\n' "$*" >&2; exit 2; }
status() {
  local ok="$1" phase="$2" error="${3:-null}" payload temporary
  if [[ "$phase" == ready ]]; then
    payload="$(printf '{"schemaVersion":%s,"kind":"%s","ok":%s,"phase":"%s","sessionId":"%s","error":%s,"triggerPath":"%s","brokerPath":"%s"}' "$schema_version" "$status_kind" "$ok" "$phase" "$session_id" "$error" "$trigger_file" "$broker_socket")"
  else
    payload="$(printf '{"schemaVersion":%s,"kind":"%s","ok":%s,"phase":"%s","sessionId":"%s","error":%s}' "$schema_version" "$status_kind" "$ok" "$phase" "$session_id" "$error")"
  fi
  if [[ -n "$ready_file" && -d "$session_root" && ! -L "$session_root" ]]; then
    temporary="$session_root/.status.$BASHPID"
    (umask 077; printf '%s\n' "$payload" > "$temporary") || return 1
    chmod 644 "$temporary" || { rm -f -- "$temporary"; return 1; }
    mv -T -- "$temporary" "$ready_file" || { rm -f -- "$temporary"; return 1; }
  fi
  printf '%s\n' "$payload"
}
json_error() { status false error "\"$1\""; }
valid_session() { [[ "$1" =~ ^[a-f0-9]{32}$ ]]; }
valid_uid() { [[ "$1" =~ ^[1-9][0-9]{3,9}$ ]] && (( $1 <= 2147483647 )); }
valid_interface() { [[ "$1" =~ ^[A-Za-z0-9_.-]{1,15}$ ]]; }
valid_peer() { [[ "$1" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]]; }
valid_frequency() { [[ "$1" =~ ^[0-9]{1,4}$ ]] && { (( $1 == 0 )) || (( $1 >= 2300 && $1 <= 7125 )); }; }
valid_duration() { [[ "$1" =~ ^[0-9]{2,4}$ ]] && (( $1 >= 60 && $1 <= 1800 )); }
valid_backend() { [[ "$1" == direct || "$1" == networkmanager ]]; }
usage() { die 'Usage: omarchy-cast-guard prepare --schema-version 1 --session <32-hex> --uid <uid> --interface <ifname> --peer <MAC> --frequency <MHz-or-0> --duration <60-1800> --backend <direct|networkmanager> | reclaim --schema-version 1 --uid <uid> --interface <ifname>'; }

parse_request() {
  [[ ${EUID} -eq 0 ]] || die 'administrator approval is required'
  action="${1:-}"; shift || true
  if [[ "$action" == prepare ]]; then
    [[ $# -eq 16 && "$1" == --schema-version && "$2" == 1 && "$3" == --session && "$5" == --uid && "$7" == --interface && "$9" == --peer && "${11}" == --frequency && "${13}" == --duration && "${15}" == --backend ]] || usage
    session_id="$4"; uid="$6"; interface="$8"; peer="${10}"; frequency="${12}"; duration="${14}"; backend="${16}"
    valid_session "$session_id" || die 'invalid session identifier'; valid_peer "$peer" || die 'invalid receiver address'; valid_frequency "$frequency" || die 'invalid P2P frequency'; valid_duration "$duration" || die 'invalid session duration'; valid_backend "$backend" || die 'invalid network backend'
  elif [[ "$action" == reclaim ]]; then
    [[ $# -eq 6 && "$1" == --schema-version && "$2" == 1 && "$3" == --uid && "$5" == --interface ]] || usage
    uid="$4"; interface="$6"
  else
    usage
  fi
  valid_uid "$uid" || die 'invalid user identifier'; valid_interface "$interface" || die 'invalid Wi-Fi interface'
  [[ "${PKEXEC_UID:-}" == "$uid" ]] || die 'requested user does not match the Polkit caller'
  getent passwd "$uid" >/dev/null || die 'requested user does not exist'
  if [[ "$action" == prepare ]]; then
    session_root="$run_root/$session_id"; user_root="$session_root/user"; token_file="$session_root/token"; ready_file="$session_root/status.json"; status_ack_file="$user_root/status-ack"; stop_file="$user_root/stop"; trigger_file="$user_root/trigger"; heartbeat_file="$user_root/heartbeat"; network_file="$network_root/80-omarchy-cast-$session_id.network"; networkd_state_file="$session_root/networkd-units"; networkd_state_pending_file="$session_root/networkd-units.pending"; network_root_marker="$session_root/network-root-created"; interfaces_file="$session_root/p2p-interfaces"; interfaces_armed_file="$session_root/p2p-armed"; network_manager_resume_file="$session_root/network-manager-resume-required"; recovery_ready_file="$session_root/recovery-ready"; broker_socket="$session_root/supplicant.sock"; broker_unit="omarchy-cast-supplicant-$session_id.service"; recovery_unit="omarchy-cast-recovery-$session_id.service"; broker_wfd_file="$session_root/supplicant-wfd-owned"; firewalld_marker="$session_root/firewalld-port-opened"
  fi
}
verify_user_runtime() { [[ -d "/run/user/$uid" && "$(stat -c '%u:%a' "/run/user/$uid")" == "$uid:700" ]] || die 'user runtime directory is unavailable or unsafe'; }
verify_interface() { [[ -d "/sys/class/net/$interface" ]] || die 'Wi-Fi interface is unavailable'; command -v iw >/dev/null || die 'iw is required'; [[ "$(iw dev "$interface" info 2>/dev/null | awk '$1 == "type" {print $2; exit}')" == managed ]] || die 'Wi-Fi interface is not a managed station'; }
acquire_guard_lock() {
  command -v flock >/dev/null || die 'flock is required'
  if [[ -e "$run_root" ]]; then
    [[ -d "$run_root" && ! -L "$run_root" && "$(stat -c '%u:%g:%a' "$run_root" 2>/dev/null)" == '0:0:755' ]] || die 'Omacast runtime ownership is unsafe'
  else
    install -d -o root -g root -m755 "$run_root"
  fi
  exec {guard_lock_fd}<"$run_root"
  [[ "$(stat -Lc '%F:%u:%g:%a' "/proc/self/fd/$guard_lock_fd" 2>/dev/null)" == 'directory:0:0:755' ]] || die 'Omacast runtime lock is unsafe'
  flock -n "$guard_lock_fd" || die 'another Omacast network operation is active'
}
verify_network_manager() {
  local current_pid
  current_pid="$(systemctl show --property MainPID --value NetworkManager.service)"
  if [[ ! "$current_pid" =~ ^[0-9]{1,10}$ ]] || (( current_pid <= 1 || current_pid > 2147483647 )); then die 'NetworkManager is not running'; fi
  [[ -r "/proc/$current_pid/comm" && "$(<"/proc/$current_pid/comm")" == NetworkManager ]] || die 'NetworkManager service identity is unexpected'
}
network_manager_marker_valid() { [[ -f "$network_manager_resume_file" && ! -L "$network_manager_resume_file" && "$(stat -c '%u:%a' "$network_manager_resume_file" 2>/dev/null)" == "$EUID:600" ]]; }
pause_network_manager() { systemctl is-active --quiet NetworkManager.service || return 1; install -m600 /dev/null "$network_manager_resume_file" || return 1; if ! systemctl kill --kill-whom=main --signal=SIGSTOP NetworkManager.service; then rm -f -- "$network_manager_resume_file" || true; return 1; fi; }
resume_network_manager() { network_manager_marker_valid || { [[ ! -e "$network_manager_resume_file" ]] && return 0; return 1; }; for _ in 1 2 3; do if systemctl kill --kill-whom=main --signal=SIGCONT NetworkManager.service; then rm -f -- "$network_manager_resume_file" || return 1; return 0; fi; sleep 0.1; done; return 1; }
bounded_session_interfaces() {
  timeout --signal=KILL 5s iw dev | awk -v prefix="p2p-$interface-" -v limit="$max_p2p_interfaces" '
    $1 == "Interface" && index($2, prefix) == 1 { print $2; if (++count > limit) exit }
  '
}
verify_clean_interface_baseline() { local listed; listed="$(bounded_session_interfaces)" || die 'could not inspect P2P interfaces'; [[ -z "$listed" ]] || die 'a P2P client already exists; remove or disconnect it before casting'; }
verify_no_guard_session() {
  local entry
  [[ ! -e "$run_root" ]] && return 0
  [[ -d "$run_root" && ! -L "$run_root" && "$(stat -c '%u:%g:%a' "$run_root" 2>/dev/null)" == '0:0:755' ]] || die 'Omacast runtime ownership is unsafe'
  shopt -s nullglob
  for entry in "$run_root"/*; do
    [[ -e "$entry" ]] && die 'an Omacast network session still owns runtime state; wait for cleanup before restoring P2P clients'
  done
}
validate_reclaim_candidate() {
  local candidate="$1" details state link
  [[ -n "$candidate" && "$candidate" == "p2p-$interface-"* ]] || die 'an existing P2P interface has an unexpected name'
  valid_interface "$candidate" || die 'an existing P2P interface has an invalid name'
  [[ -e "$network_sys_root/$candidate/operstate" ]] || die 'an existing P2P interface has no kernel state'
  state="$(<"$network_sys_root/$candidate/operstate")"
  details="$(iw dev "$candidate" info 2>/dev/null)" || die 'could not inspect an existing P2P interface'
  [[ "$state" == down && "$(awk '$1 == "type" {print $2; exit}' <<< "$details")" == P2P-client ]] || die 'an existing P2P interface may still be active'
  link="$(iw dev "$candidate" link 2>/dev/null)" || die 'could not inspect an existing P2P link'
  grep -Fxq 'Not connected.' <<< "$link" || die 'an existing P2P client is still connected'
  ! ip -4 -o address show dev "$candidate" | grep -q . || die 'an existing P2P client still has an IPv4 address'
  ! ip -6 -o address show dev "$candidate" scope global | grep -q . || die 'an existing P2P client still has a global IPv6 address'
}
reclaim_orphan_interfaces() {
  local listed candidate reclaimed=0
  local -a candidates=()
  verify_interface
  verify_no_guard_session
  command -v ip >/dev/null || die 'ip is required'
  listed="$(bounded_session_interfaces)" || die 'could not inspect P2P interfaces'
  while read -r candidate; do
    [[ -n "$candidate" ]] || continue
    (( ${#candidates[@]} < max_p2p_interfaces )) || die 'too many P2P interfaces to recover safely'
    candidates+=("$candidate")
  done <<< "$listed"
  for candidate in "${candidates[@]}"; do validate_reclaim_candidate "$candidate"; done
  for candidate in "${candidates[@]}"; do
    validate_reclaim_candidate "$candidate"
    iw dev "$candidate" del || die 'could not remove an inactive P2P client'
    ! iw dev "$candidate" info >/dev/null 2>&1 || die 'an inactive P2P client remained after recovery'
    reclaimed=$((reclaimed + 1))
  done
  printf '{"schemaVersion":1,"kind":"omarchy-cast-guard-reclaim-status","ok":true,"reclaimed":%s}\n' "$reclaimed"
}
interfaces_file_valid() {
  local metadata owner mode size
  [[ -f "$interfaces_file" && ! -L "$interfaces_file" ]] || return 1
  metadata="$(stat -c '%u:%a:%s' "$interfaces_file" 2>/dev/null)" || return 1
  IFS=: read -r owner mode size <<< "$metadata"
  [[ "$owner" == "$EUID" && "$mode" == 600 && "$size" =~ ^[0-9]{1,4}$ ]] || return 1
  (( size <= max_interfaces_file_bytes ))
}
record_session_interfaces() {
  local candidate listed existing_count=0
  local -A seen=()
  interfaces_file_valid || return 1
  while IFS= read -r candidate; do
    (( ++existing_count <= max_p2p_interfaces )) || return 1
    [[ -n "$candidate" && "$candidate" == "p2p-$interface-"* ]] || return 1
    valid_interface "$candidate" || return 1
    seen["$candidate"]=1
  done < "$interfaces_file"
  listed="$(bounded_session_interfaces)" || return 1
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    valid_interface "$candidate" || return 1
    [[ -n "${seen[$candidate]:-}" ]] && continue
    (( ${#seen[@]} < max_p2p_interfaces )) || return 1
    printf '%s\n' "$candidate" >> "$interfaces_file" || return 1
    seen["$candidate"]=1
  done <<< "$listed"
  interfaces_file_valid
}
remove_session_interfaces() {
  local owned details type removed all_removed=true count=0
  interfaces_file_valid || return 1
  while IFS= read -r owned; do
    (( ++count <= max_p2p_interfaces )) || return 1
    if [[ -z "$owned" || "$owned" != "p2p-$interface-"* ]] || ! valid_interface "$owned"; then all_removed=false; continue; fi
    if ! details="$(iw dev "$owned" info 2>/dev/null)"; then continue; fi
    type="$(awk '$1 == "type" {print $2; exit}' <<< "$details")"
    if [[ "$type" != P2P-client ]]; then all_removed=false; continue; fi
    removed=false
    for _ in 1 2 3; do
      iw dev "$owned" del 2>/dev/null || true
      if ! iw dev "$owned" info >/dev/null 2>&1; then removed=true; break; fi
      sleep 0.1
    done
    [[ "$removed" == true ]] || all_removed=false
  done < "$interfaces_file"
  [[ "$all_removed" == true ]]
}

prepare_network_runtime() {
  if [[ -e "$network_root" ]]; then
    [[ -d "$network_root" && ! -L "$network_root" && "$(stat -c '%u:%g:%a' "$network_root")" == '0:0:755' ]] || die 'systemd network runtime directory is unsafe'
  else
    install -d -o root -g root -m755 "$network_root"
    install -m600 /dev/null "$network_root_marker"
  fi
  : > "$networkd_state_pending_file"; chmod 600 "$networkd_state_pending_file"
  local unit
  for unit in "${networkd_units[@]}"; do
    if systemctl is-active --quiet "$unit"; then printf '%s active\n' "$unit"; else printf '%s inactive\n' "$unit"; fi
  done > "$networkd_state_pending_file"
  mv -T -- "$networkd_state_pending_file" "$networkd_state_file"
}

restore_networkd_state() {
  [[ -f "$networkd_state_file" && ! -L "$networkd_state_file" && "$(stat -c '%u:%a' "$networkd_state_file" 2>/dev/null)" == '0:600' ]] || return 1
  local unit state
  while read -r unit state; do [[ "$state" == inactive ]] && systemctl stop "$unit" 2>/dev/null || true; done < "$networkd_state_file"
  while read -r unit state; do [[ "$state" == active ]] && systemctl start "$unit" 2>/dev/null || true; done < "$networkd_state_file"
  ! systemctl is-active --quiet systemd-networkd.service || systemctl reload systemd-networkd.service
}

create_session_identity() {
  local user_name user_group
  user_name="$(getent passwd "$uid" | cut -d: -f1)"; user_group="$(id -g "$user_name")"
  [[ ! -e "$session_root" ]] || die 'a conflicting cast session already owns this resource'
  [[ ! -e "$network_file" ]] || die 'a conflicting cast session already owns this resource'
  install -d -m711 "$session_root"
  runtime_dirs_created=true
  install -d -m700 -o "$uid" -g "$user_group" "$user_root"
  [[ ! -L "$session_root" && "$(stat -c '%u:%g:%a' "$session_root")" == '0:0:711' ]] || die 'root session directory is unsafe'
  [[ ! -L "$user_root" && "$(stat -c '%u:%a' "$user_root")" == "$uid:700" ]] || die 'user marker directory is unsafe'
  umask 077; token="$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')"; printf '%s\n' "$token" > "$token_file"; chmod 600 "$token_file"
  : > "$interfaces_file"; chmod 600 "$interfaces_file"
}

write_privileged_runtime() {
  [[ "$backend" == direct ]] || return 0
  prepare_network_runtime
  printf '%s\n' '[Match]' "Name=p2p-$interface-*" '' '[Network]' 'DHCP=ipv4' 'IPv6AcceptRA=no' 'LinkLocalAddressing=ipv6' '' '[DHCPv4]' 'UseDNS=no' 'UseDomains=no' 'UseRoutes=yes' 'RouteMetric=2048' > "$network_file"; chmod 644 "$network_file"
}
broker_socket_valid() { [[ -S "$broker_socket" && ! -L "$broker_socket" && "$(stat -c '%u:%a' "$broker_socket" 2>/dev/null)" == "$uid:600" ]]; }
start_broker() {
  local deadline=$((SECONDS + recovery_ready_timeout_seconds))
  systemd-run --quiet --collect --unit="$broker_unit" --property=Type=exec -- /usr/lib/omarchy-cast/omarchy-cast-supplicant-broker --session "$session_id" --uid "$uid" --interface "$interface" --peer "$peer" --frequency "$frequency" --backend "$backend" || return 1
  broker_started=true
  while (( SECONDS <= deadline )); do
    broker_socket_valid && systemctl is-active --quiet "$broker_unit" && return 0
    systemctl is-failed --quiet "$broker_unit" && return 1
    sleep 0.05
  done
  return 1
}
stop_broker() { local _; [[ "$broker_started" == false ]] && return 0; for _ in 1 2 3; do systemctl is-active --quiet "$broker_unit" || return 0; systemctl stop "$broker_unit" 2>/dev/null || true; sleep 0.1; done; ! systemctl is-active --quiet "$broker_unit"; }
remove_broker_socket() {
  [[ ! -e "$broker_socket" && ! -L "$broker_socket" ]] && return 0
  [[ -S "$broker_socket" && ! -L "$broker_socket" && "$(stat -c '%u:%a' "$broker_socket" 2>/dev/null)" == "$uid:600" ]] || return 1
  rm -f -- "$broker_socket"
}
clear_owned_wfd_ies() {
  local raw current expected='0x00 0x00 0x06 0x00 0x10 0x1c 0x44 0x00 0xc8'
  [[ ! -e "$broker_wfd_file" ]] && return 0
  [[ -f "$broker_wfd_file" && ! -L "$broker_wfd_file" && "$(stat -c '%u:%a' "$broker_wfd_file" 2>/dev/null)" == "$EUID:600" ]] || return 1
  raw="$(timeout --signal=KILL 5s gdbus call --system --dest fi.w1.wpa_supplicant1 --object-path /fi/w1/wpa_supplicant1 --method org.freedesktop.DBus.Properties.Get fi.w1.wpa_supplicant1 WFDIEs 2>/dev/null | head -c $((max_privileged_command_output_bytes + 1)))" || return 1
  (( ${#raw} <= max_privileged_command_output_bytes )) || return 1
  current="$(grep -oE '0x[0-9A-Fa-f]{2}' <<< "$raw" | head -n 10 | tr '[:upper:]' '[:lower:]' | paste -sd ' ' -)" || true
  if [[ -z "$current" ]]; then rm -f -- "$broker_wfd_file"; return; fi
  [[ "$current" == "$expected" ]] || return 1
  timeout --signal=KILL 5s gdbus call --system --dest fi.w1.wpa_supplicant1 --object-path /fi/w1/wpa_supplicant1 --method org.freedesktop.DBus.Properties.Set fi.w1.wpa_supplicant1 WFDIEs '<@ay []>' >/dev/null 2>&1 || return 1
  rm -f -- "$broker_wfd_file"
}
recover_networkmanager_connection() {
  [[ "$backend" == networkmanager ]] || return 0
  timeout --signal=KILL 25s /usr/lib/omarchy-cast/omarchy-cast-supplicant-broker --recover-networkmanager --session "$session_id" --uid "$uid" --interface "$interface" --peer "$peer" --frequency 0 --backend networkmanager
}
firewalld_marker_valid() { [[ -f "$firewalld_marker" && ! -L "$firewalld_marker" && "$(stat -c '%u:%a:%h:%s' "$firewalld_marker" 2>/dev/null)" == "$EUID:600:1:0" ]]; }
remove_firewalld_rule() {
  [[ ! -e "$firewalld_marker" ]] && return 0
  firewalld_marker_valid || return 1
  firewall-cmd --zone=nm-shared --remove-port=7236/tcp >/dev/null || return 1
  rm -f -- "$firewalld_marker"
}
owns_session() { [[ -r "$token_file" && "$(<"$token_file")" == "$token" ]]; }
remove_cleanup_file() { if ! rm -f -- "$1"; then cleanup_ok=false; fi; return 0; }
cleanup() {
  if ! owns_session; then
    [[ "$runtime_dirs_created" == true ]] && rmdir --ignore-fail-on-non-empty "$user_root" "$session_root" 2>/dev/null || true
    return 0
  fi

  local remove_network_root=false networkd_cleanup_ok=true
  [[ -f "$network_root_marker" ]] && remove_network_root=true
  if ! stop_broker; then broker_cleanup_ok=false; cleanup_ok=false; fi
  if [[ "$broker_cleanup_ok" == true ]]; then remove_broker_socket || cleanup_ok=false; clear_owned_wfd_ies || cleanup_ok=false; recover_networkmanager_connection || cleanup_ok=false; fi
  if [[ "$backend" == direct && -f "$interfaces_armed_file" && ! -L "$interfaces_armed_file" && "$(stat -c '%u:%a' "$interfaces_armed_file" 2>/dev/null)" == "$EUID:600" ]]; then
    record_session_interfaces || interface_cleanup_ok=false
    remove_session_interfaces || interface_cleanup_ok=false
  fi
  resume_network_manager || network_manager_cleanup_ok=false
  if [[ "$ufw_rule_added" == true ]] && ! ufw --force delete allow in on "p2p-$interface+" to any port 7236 proto tcp >/dev/null 2>&1; then cleanup_ok=false; fi
  remove_firewalld_rule || cleanup_ok=false

  remove_cleanup_file "$network_file"
  remove_cleanup_file "$trigger_file"
  remove_cleanup_file "$heartbeat_file"
  remove_cleanup_file "$stop_file"
  if [[ -e "$networkd_state_file" ]] && ! restore_networkd_state; then cleanup_ok=false; networkd_cleanup_ok=false; fi

  remove_cleanup_file "$networkd_state_pending_file"
  if [[ "$networkd_cleanup_ok" == true ]]; then
    remove_cleanup_file "$networkd_state_file"
    remove_cleanup_file "$network_root_marker"
  fi
  if [[ "$interface_cleanup_ok" == true ]]; then
    remove_cleanup_file "$interfaces_armed_file"
    remove_cleanup_file "$interfaces_file"
  fi
  if [[ "$cleanup_ok" == true && "$interface_cleanup_ok" == true && "$network_manager_cleanup_ok" == true ]]; then
    remove_cleanup_file "$recovery_ready_file"
  fi
  if [[ "$cleanup_ok" == true && "$interface_cleanup_ok" == true && "$network_manager_cleanup_ok" == true ]]; then
    remove_cleanup_file "$token_file"
  fi
  [[ "$remove_network_root" == true ]] && rmdir "$network_root" 2>/dev/null || true
  return 0
}
status_ack_valid() {
  local metadata
  [[ -f "$status_ack_file" && ! -L "$status_ack_file" ]] || return 1
  metadata="$(stat -c '%u:%a:%h:%s' "$status_ack_file" 2>/dev/null)" || return 1
  [[ "$metadata" == "$uid:600:1:0" ]]
}
finalize_status() {
  local deadline=$((SECONDS + status_ack_timeout_seconds))
  while (( SECONDS <= deadline )); do
    status_ack_valid && break
    sleep 0.1
  done
  status_ack_valid && rm -f -- "$status_ack_file" || true
  rm -f -- "$ready_file" || true
  rmdir --ignore-fail-on-non-empty "$user_root" "$session_root" 2>/dev/null || true
}
open_heartbeat() {
  local metadata kind owner mode size
  [[ -e "$heartbeat_file" && ! -L "$heartbeat_file" ]] || return 1
  exec {heartbeat_fd}<>"$heartbeat_file" 2>/dev/null || return 1
  metadata="$(stat -Lc '%F:%u:%a:%s' "/proc/self/fd/$heartbeat_fd" 2>/dev/null)" || { exec {heartbeat_fd}>&-; heartbeat_fd=''; return 1; }
  IFS=: read -r kind owner mode size <<< "$metadata"
  if [[ "$kind" != 'regular file' || "$owner" != "$uid" || "$mode" != 600 || ! "$size" =~ ^[0-9]{1,2}$ ]] || (( size > 32 )); then
    exec {heartbeat_fd}>&-
    heartbeat_fd=''
    return 1
  fi
}
lease_fresh() {
  local renewed
  [[ -n "$heartbeat_fd" ]] || open_heartbeat || return 1
  IFS= read -r -n 32 -t 0.1 renewed < "/proc/self/fd/$heartbeat_fd" || return 1
  [[ "$renewed" =~ ^[0-9]{1,12}$ ]] && (( EPOCHSECONDS >= renewed && EPOCHSECONDS - renewed <= duration ))
}
recovery_ready_marker_valid() { [[ -f "$recovery_ready_file" && ! -L "$recovery_ready_file" && "$(stat -c '%u:%a' "$recovery_ready_file" 2>/dev/null)" == "$EUID:600" ]]; }
arm_recovery() {
  local startup_seconds=$((wait_for_trigger_seconds + 60)) deadline
  [[ ! -e "$recovery_ready_file" && ! -L "$recovery_ready_file" ]] || return 1
  systemd-run --system --quiet --collect --no-block --unit="$recovery_unit" --property=Type=exec --property=KillMode=control-group -- /usr/lib/omarchy-cast/omarchy-cast-guard-recover "$startup_seconds" "$duration" "$session_id" "$token" "$uid" "$interface" "$peer" "$backend" || return 1
  deadline=$((SECONDS + recovery_ready_timeout_seconds))
  while (( SECONDS <= deadline )); do
    if recovery_ready_marker_valid; then systemctl is-active --quiet "$recovery_unit" && return 0; return 1; fi
    systemctl is-failed --quiet "$recovery_unit" && return 1
    sleep 0.05
  done
  systemctl stop "$recovery_unit" 2>/dev/null || true
  return 1
}
activate_network() {
  if command -v ufw >/dev/null && ufw status | grep -q '^Status: active'; then ufw allow in on "p2p-$interface+" to any port 7236 proto tcp comment "omarchy-cast-$session_id" | grep -q 'Rule added' && ufw_rule_added=true; fi
  if [[ "$backend" == networkmanager ]] && command -v firewall-cmd >/dev/null && firewall-cmd --state 2>/dev/null | grep -Fxq running; then
    if ! firewall-cmd --zone=nm-shared --query-port=7236/tcp >/dev/null; then
      install -m600 /dev/null "$firewalld_marker"
      if ! firewall-cmd --zone=nm-shared --add-port=7236/tcp >/dev/null; then rm -f -- "$firewalld_marker"; die 'could not open the NetworkManager shared RTSP port'; fi
    fi
  fi
  if [[ "$backend" == direct ]]; then
    pause_network_manager || die 'could not pause NetworkManager safely'
    verify_clean_interface_baseline
    install -m600 /dev/null "$interfaces_armed_file"
    if systemctl is-active --quiet systemd-networkd.service; then systemctl reload systemd-networkd.service; else systemctl start systemd-networkd.service; fi
  else
    command -v dnsmasq >/dev/null || die 'dnsmasq is required for NetworkManager compatibility mode'
    systemctl is-active --quiet NetworkManager.service || die 'NetworkManager is not active'
    install -m600 /dev/null "$interfaces_armed_file"
  fi
}
prepare() {
  verify_user_runtime
  trap 'cleanup' EXIT
  trap 'exit 0' HUP INT TERM
  create_session_identity
  trap 'cleanup; json_error "guarded networking setup failed"; finalize_status' EXIT
  verify_interface
  verify_network_manager
  verify_clean_interface_baseline
  arm_recovery || die 'independent recovery did not become ready'
  write_privileged_runtime
  start_broker || die 'session-scoped supplicant broker did not become ready'
  trap 'cleanup; if [[ "$cleanup_ok" == true && "$interface_cleanup_ok" == true && "$network_manager_cleanup_ok" == true ]]; then status true cleaned null; else json_error "session network cleanup was incomplete"; fi; finalize_status' EXIT
  status true ready null
  local deadline=$((SECONDS + wait_for_trigger_seconds))
  while [[ ! -e "$trigger_file" && ! -e "$stop_file" ]] && (( SECONDS < deadline )); do sleep 0.1; done
  [[ -e "$trigger_file" ]] || { json_error 'FluxCast did not trigger guarded networking'; exit 1; }
  rm -f -- "$trigger_file"
  lease_fresh || { json_error 'Omacast session lease was not established'; exit 1; }
  activate_network
  status true active null
  local lease_next=$SECONDS
  while owns_session && [[ ! -e "$stop_file" ]]; do
    if (( SECONDS >= lease_next )); then lease_fresh || break; lease_next=$((SECONDS + 1)); fi
    sleep 0.2
  done
}
if [[ $# -eq 1 && "$1" == --version ]]; then
  printf '{"schemaVersion":%s,"kind":"%s","apiRevision":%s}\n' "$schema_version" "$version_kind" "$api_revision"
  exit 0
fi

parse_request "$@"
acquire_guard_lock
if [[ "$action" == reclaim ]]; then reclaim_orphan_interfaces; else prepare; fi
